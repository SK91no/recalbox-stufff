+	select BR2_PACKAGE_MESA3D_VULKAN_DRIVER
+	help
+	  The Zink driver is a Gallium driver that emits Vulkan
+	  API calls instead of targeting a specific GPU architecture.
+	  This can be used to get full desktop OpenGL support on devices
+	  that only support Vulkan.
+
 config BR2_PACKAGE_MESA3D_VDPAU
 	bool "Gallium VDPAU state tracker"
