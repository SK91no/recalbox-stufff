--- a/package/heimdal/heimdal.mk
+++ b/package/heimdal/heimdal.mk
@@ -8,6 +8,11 @@ HEIMDAL_SITE = $(call github,heimdal,heimdal,$(HEIMDAL_VERSION))
 HOST_HEIMDAL_DEPENDENCIES = host-e2fsprogs host-ncurses host-pkgconf
 HOST_HEIMDAL_AUTORECONF = YES
 HEIMDAL_INSTALL_STAGING = YES
+# Heimdal's wind/ has a parallel-build race: lib/wind/Makefile generates
+# wind/map_table.[ch] from the wind/UnicodeData.txt corpus, but other
+# objects in libwind link against `_wind_map_table*` before the table is
+# emitted. Force serial build for safety on -j>4.
+HOST_HEIMDAL_MAKE = $(MAKE1)
 # static because of -fPIC issues with e2fsprogs on x86_64 host
 HOST_HEIMDAL_CONF_OPTS = \
 	--disable-shared \
