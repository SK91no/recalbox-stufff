config BR2_PACKAGE_RECALBOX_EMULATIONSTATION2
	bool "recalbox Emulationstation 2"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_ALSA_LIB
	depends on BR2_PACKAGE_ALSA_UTILS_AMIXER
	depends on BR2_PACKAGE_FFMPEG_ARCH_SUPPORTS # ffmpeg
	depends on (BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_MIXER
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_AVRESAMPLE
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_LIBFREEIMAGE
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_DEJAVU
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_RAPIDJSON
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_XMLSTARLET
	select BR2_PACKAGE_RECALBOX_3MOUNTS
	select BR2_PACKAGE_PROCPS_NG
	select BR2_PACKAGE_RECALBOX_MUPDF
	select BR2_PACKAGE_MUPDF
	# Pulled in only for alpha/patron builds where DeathTrap uses it to walk
	# the stack via .eh_frame (more robust than libgcc on stripped binaries).
	# Gated by libunwind's own arch/toolchain requirements so the select is a
	# no-op on configurations where libunwind cannot be built.
	select BR2_PACKAGE_LIBUNWIND if BR2_PACKAGE_LIBUNWIND_ARCH_SUPPORTS && \
		BR2_TOOLCHAIN_HAS_THREADS && BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 && \
		!BR2_STATIC_LIBS
	help
	  A multi emulator frontend.

	  https://github.com/Aloshi/EmulationStation

if BR2_PACKAGE_RECALBOX_EMULATIONSTATION2
choice
	prompt "ES version to compile"
config BR2_PACKAGE_RECALBOX_EMULATIONSTATION2_STANDARD
	bool "standard"
config BR2_PACKAGE_RECALBOX_EMULATIONSTATION2_ARCADE
	bool "arcade"
endchoice
endif

comment "Emulation station 2 needs a toolchain w/ C++, ALSA, Boost, GLES and SDL2"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_SDL2 || !BR2_PACKAGE_SDL2_MIXER || \
		!BR2_PACKAGE_ALSA_LIB || (!BR2_PACKAGE_HAS_LIBGLES || !BR2_PACKAGE_HAS_LIBGL)
