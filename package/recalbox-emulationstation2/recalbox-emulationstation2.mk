################################################################################
#
# EmulationStation 2 - recalbox version https://gitlab.com/recalbox/recalbox-emulationstation
#
################################################################################

RECALBOX_EMULATIONSTATION2_VERSION = custom
RECALBOX_EMULATIONSTATION2_SITE = $(TOPDIR)/../projects/frontend
RECALBOX_EMULATIONSTATION2_SITE_METHOD = local
RECALBOX_EMULATIONSTATION2_LICENSE = MIT
RECALBOX_EMULATIONSTATION2_DEPENDENCIES = sdl2 sdl2_mixer libfreeimage freetype alsa-lib pulseaudio \
	libcurl openssl libzip ffmpeg recalbox-3mounts xz rapidjson procps-ng recalbox-mupdf

ifeq ($(BR2_PACKAGE_RECALBOX_TARGET_RPI3)$(BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2LEGACY)$(BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DRPI_VERSION=3
else ifeq ($(BR2_PACKAGE_RECALBOX_TARGET_RPI1),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DRPI_VERSION=1
else ifeq ($(BR2_PACKAGE_RECALBOX_TARGET_RPI0),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DRPI_VERSION=1
endif

ifeq ($(BR2_PACKAGE_RECALBOX_TARGET_RPI3)$(BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DFORCE_OPENGLES=ON
endif

ifeq ($(BR2_PACKAGE_RECALBOX_TARGET_X86_64),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DFORCE_OPENGL=ON
endif

ifeq ($(BR2_PACKAGE_HAS_LIBGL),y)
RECALBOX_EMULATIONSTATION2_DEPENDENCIES += libgl
endif

ifeq ($(BR2_PACKAGE_HAS_LIBGLES),y)
RECALBOX_EMULATIONSTATION2_DEPENDENCIES += libgles
endif

define RECALBOX_EMULATIONSTATION2_RPI_FIXUP
	$(SED) 's|/opt/vc/include|$(STAGING_DIR)/usr/include|g' $(@D)/CMakeLists.txt
	$(SED) 's|/opt/vc/lib|$(STAGING_DIR)/usr/lib|g' $(@D)/CMakeLists.txt
	$(SED) 's|/usr/lib|$(STAGING_DIR)/usr/lib|g' $(@D)/CMakeLists.txt
endef

RECALBOX_EMULATIONSTATION2_PRE_CONFIGURE_HOOKS += RECALBOX_EMULATIONSTATION2_RPI_FIXUP

define RECALBOX_EMULATIONSTATION2_INSTALL_BETA_UPDATE
	$(INSTALL) -D -m 0755 $(RECALBOX_EMULATIONSTATION2_PKGDIR)/update_emulationstation.sh $(TARGET_DIR)/etc/init.d/S12esupdate
endef

ifneq ($(findstring alpha,$(RECALBOX_VERSION)),)
RECALBOX_EMULATIONSTATION2_POST_INSTALL_TARGET_HOOKS += RECALBOX_EMULATIONSTATION2_INSTALL_BETA_UPDATE
RECALBOX_EMULATIONSTATION2_CONF_BETA += "-DBETA=1"
endif

# Alpha and patron builds export all global symbols to the dynamic symbol
# table so DeathTrap can resolve function names directly in crash backtraces
# (instead of bare module+offset). Slight binary-size cost; production builds
# stay stripped and unaffected.
ifneq ($(findstring alpha,$(RECALBOX_VERSION))$(findstring patron,$(RECALBOX_VERSION)),)
RECALBOX_EMULATIONSTATION2_CONF_BETA += "-Wl,--export-dynamic"

# Same alpha/patron gate: link libunwind so DeathTrap can walk the stack from
# the faulting ucontext via .eh_frame (more reliable than libgcc on -O3+LTO
# binaries without frame pointers). The BR2_PACKAGE_LIBUNWIND check makes this
# a no-op on configurations where libunwind isn't available (static builds,
# unsupported archs), the source falls back to libgcc's backtrace().
ifeq ($(BR2_PACKAGE_LIBUNWIND),y)
ifneq ($(BR2_PACKAGE_RECALBOX_TARGET_RPI3)$(BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2LEGACY)$(BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2),y)
RECALBOX_EMULATIONSTATION2_DEPENDENCIES += libunwind
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DUSE_LIBUNWIND=ON
endif
endif
endif

ifeq ($(BR2_ENABLE_DEBUG),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_BUILD_TYPE=Debug
endif

RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_C_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_C_ARCHIVE_FINISH=true
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_FINISH=true
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_AR="$(TARGET_CC)-ar"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_C_COMPILER="$(TARGET_CC)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_CXX_COMPILER="$(TARGET_CXX)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_LINKER="$(TARGET_LD)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_C_FLAGS="$(RECALBOX_EMULATIONSTATION2_CONF_BETA) $(COMPILER_COMMONS_CFLAGS_EXE)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_CXX_FLAGS="$(RECALBOX_EMULATIONSTATION2_CONF_BETA) $(COMPILER_COMMONS_CXXFLAGS_EXE)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DCMAKE_LINKER_EXE_FLAGS="$(COMPILER_COMMONS_LDFLAGS_EXE)"
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DOPTION_RECALBOX_PRODUCTION_BUILD=true
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DPISTACHE_BUILD_TESTS=false
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DPISTACHE_BUILD_EXAMPLES=false

ifeq ($(BR2_PACKAGE_RECALBOX_HAS_KMS),y)
RECALBOX_EMULATIONSTATION2_CONF_OPTS += -DUSE_KMSDRM=ON
endif

$(eval $(cmake-package))
