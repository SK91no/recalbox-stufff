################################################################################
#
# RB5000 - Phillips VG 5000
#
################################################################################

LIBRETRO_RB5000_VERSION = v0.9
LIBRETRO_RB5000_SITE = $(call gitlab,recalbox,packages/recalbox-cores/libretro-rb5000,$(LIBRETRO_RB5000_VERSION))
#LIBRETRO_RB5000_DEPENDENCIES =
LIBRETRO_RB5000_LICENSE = GPL-2.0
LIBRETRO_RB5000_LICENSE_FILES = COPYING

define LIBRETRO_RB5000_INSTALL_TARGET_CMDS
	$(INSTALL) -D $(@D)/rb5000_libretro.so $(TARGET_DIR)/usr/lib/libretro/rb5000_libretro.so
endef

ifeq ($(BR2_PACKAGE_HAS_LIBGL),y)
LIBRETRO_RB5000_DEPENDENCIES += libgl
endif

ifeq ($(BR2_PACKAGE_HAS_LIBGLES),y)
LIBRETRO_RB5000_DEPENDENCIES += libgles
endif

LIBRETRO_RB5000_CONF_OPTS += -DBUILD_LIBRETRO=ON
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_C_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_C_ARCHIVE_FINISH=true
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_FINISH=true
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_AR="$(TARGET_CC)-ar"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_C_COMPILER="$(TARGET_CC)"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_CXX_COMPILER="$(TARGET_CXX)"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_LINKER="$(TARGET_LD)"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_C_FLAGS="$(COMPILER_COMMONS_CFLAGS_SO)"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_CXX_FLAGS="$(COMPILER_COMMONS_CXXFLAGS_SO)"
LIBRETRO_RB5000_CONF_OPTS += -DCMAKE_SHARED_LINKER_FLAGS="$(COMPILER_COMMONS_LDFLAGS_SO)"

$(eval $(cmake-package))
