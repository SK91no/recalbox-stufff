-   const GLuint col_format = ((format == GREY8) || (format == RED16F))                                                                                                      ? GL_RED
+   const GLuint col_type = ((format == RGBA32F) || (format == RGB32F) || (format == RED32F)) ? GL_FLOAT : ((format == RGB16F) || (format == RGBA16F)) ? GL_HALF_FLOAT : (format == RGB5) ? GL_UNSIGNED_SHORT_5_6_5 : GL_UNSIGNED_BYTE;
