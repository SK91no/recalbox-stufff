config BR2_PACKAGE_KODI_PLUGIN_VIDEO_CRUNCHYROLL
	bool "kodi-plugin-video-crunchyroll"
	default y
	depends on BR2_PACKAGE_KODI
	select BR2_PACKAGE_KODI_PLUGIN_SCRIPT_ADDON_SIGNALS
	select BR2_PACKAGE_PYTHON_SIX
	select BR2_PACKAGE_KODI_SCRIPT_MODULE_INPUTSTREAMHELPER
	select BR2_PACKAGE_KODI_SCRIPT_MODULE_REQUESTS
	help
	  Kodi Crunchyroll Plugin

	  source https://github.com/smirgol/plugin.video.crunchyroll/
