+	if (PAGESIZE16K)
+		target_compile_definitions(${PROJECT_NAME} PRIVATE FLYCAST_PAGE_SIZE_16K)
+	endif()
 	if(APPLE)
 		if(NOT IOS)
 			set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-undefined,error")
