config BR2_PACKAGE_LIBRETRO_DICE
	bool "libretro-dice"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ARCADE_DATS
	help
	  DICE is a Discrete Integrated Circuit Emulator for
	  machines without any type of CPU.

	  http://www.libretro.com

comment "LIBRETRO_DICE needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
