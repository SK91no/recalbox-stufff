config BR2_PACKAGE_KODI_PLUGIN_VIDEO_PLEX
	bool "kodi-plugin-video-plex"
	default y
	depends on BR2_PACKAGE_KODI
	select BR2_PACKAGE_PYTHON_REQUESTS
	select BR2_PACKAGE_KODI_SCRIPT_MODULE_PYTHON_TWITCH
	select BR2_PACKAGE_KODI_SCRIPT_MODULE_REQUESTS
	select BR2_PACKAGE_KODI_SCRIPT_MODULE_KODI_SIX
	help
	  Unoffical Plex for Kodi add-on.

	  source https://github.com/pannal/plex-for-kodi
