config BR2_PACKAGE_AMIBERRY
	bool "Amiberry"
	depends on !BR2_STATIC_LIBS  # sdl3, sdl3_image
	depends on BR2_PACKAGE_RECALBOX_SYSTEM
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_MPG123
	select BR2_PACKAGE_SDL3_IMAGE
	select BR2_PACKAGE_LIBCAPSIMAGE
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_LIBMPEG2
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_ZSTD
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_ZLIB
	help
	  An Amiga emulator

	  https://github.com/midwan/amiberry

comment "Amiberry needs a toolchain w/ dynamic library"
	depends on BR2_STATIC_LIBS
