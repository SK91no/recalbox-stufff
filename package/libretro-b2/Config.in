config BR2_PACKAGE_LIBRETRO_B2
	bool "libretro-b2"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_UTIL_LINUX_LIBS
	select BR2_PACKAGE_ZLIB
	help
	  Libretro b2 core - A BBC Micro emulator

	  https://github.com/zoltanvb/b2-libretro

comment "LIBRETRO_B2 needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
