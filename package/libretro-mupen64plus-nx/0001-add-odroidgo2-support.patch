From 215317ce4850a903c9229d8c836bba7cef8ff2e4 Mon Sep 17 00:00:00 2001
From: David Barbion <davidb@230ruedubac.fr>
Date: Sat, 22 Jan 2022 09:34:54 +0100
Subject: [PATCH 1/4] add odroidgo2 support

---
 Makefile | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Makefile b/Makefile
index 481e8b9..dcb1899 100644
--- a/Makefile
+++ b/Makefile
@@ -259,6 +259,12 @@ else ifneq (,$(findstring odroid64,$(platform)))
       GLES = 0
       GLES3= 1
       GL_LIB := -lGLESv3
+   else ifneq (,$(findstring GO2,$(BOARD)))
+      # ODROID-GO2
+      CPUFLAGS += -mcpu=cortex-a35
+      COREFLAGS += -DEGL_NO_X11
+      GLES = 0
+      GLES3= 1
    endif
 
    COREFLAGS += -DOS_LINUX
