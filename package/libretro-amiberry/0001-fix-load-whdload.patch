diff --git a/src/osdep/amiberry.cpp b/src/osdep/amiberry.cpp
index 4c6a250a..ea4bdb89 100644
--- a/src/osdep/amiberry.cpp
+++ b/src/osdep/amiberry.cpp
@@ -9692,6 +9692,26 @@ static void init_amiberry_dirs(const bool portable_mode, const bool materialize_
 	}

 	default_base_content_paths = get_current_base_content_path_set();
+
+#ifdef LIBRETRO
+	// In the libretro build, override whdboot_path with the recalbox BIOS
+	// directory BEFORE create_missing_amiberry_folders() seeds files, so the
+	// seed goes to the right place and get_whdbootpath() is correct for
+	// whdload_auto_prefs() without needing a -s argv workaround.
+	// Priority: <bios>/whdl if it exists, else the bios dir directly.
+	{
+		const char* lr_system_dir = "/recalbox/share/bios/amiga";
+		if (lr_system_dir && lr_system_dir[0]) {
+			std::string whdboot_candidate = std::string(lr_system_dir) + "/whdl";
+			if (!std::filesystem::is_directory(whdboot_candidate))
+				whdboot_candidate = std::string(lr_system_dir);
+			write_log("libretro: init_amiberry_dirs: whdboot_path overridden to '%s'\n",
+				whdboot_candidate.c_str());
+			set_whdbootpath(whdboot_candidate);
+			default_base_content_paths = get_current_base_content_path_set();
+		}
+	}
+#endif
 }

