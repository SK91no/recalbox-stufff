 /* --- Per-frame video hooks --- */
 
+/* Whether the calibration overlay applies to this port. Two conditions, and
+ * both are needed.
+ *
+ * The core must actually read the port with RETRO_DEVICE_LIGHTGUN ids: device
+ * ids vary wildly (fceumm exposes its Zapper as a MOUSE subclass, 258) and no
+ * RETRO_DEVICE_MASK test catches them all.
+ *
+ * And a gun must really be configured on it: on 2-player games the core polls
+ * every port as a lightgun even with a single gun plugged (flycast, House of
+ * the Dead). Without this a phantom second player re-opens the calibration and
+ * wrecks the target colours. configgen zeroes the device of gunless ports. */
+static bool lightgun_port_is_gun(input_driver_state_t *input_st, unsigned port)
+{
+   settings_t *cfg = config_get_ptr();
+   return input_st->lightgun.polled_as_gun[port]
+       && cfg
+       && cfg->uints.input_libretro_device[port] != RETRO_DEVICE_NONE;
+}
