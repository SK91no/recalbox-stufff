+ * same physical input as the trigger (SuperScope turbo, lightgun.xml), which
+ * made the very first shot end the calibration. It reaches the core
+ * untouched. */
+static void lightgun_cal_retry(input_driver_state_t *input_st, unsigned port)
+{
+   input_st->lightgun.cal_state[port]  = 0;
+   input_st->lightgun.cal_target[port] = 0;
+   input_st->lightgun.cal_valid[port]  = false;
+}
