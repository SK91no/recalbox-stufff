+static char* get_game_name(char* full_path)
+{
+   int n = strlen(full_path);
+   char* rom_filename = full_path + n;
+   char delimiter = (char)  path_get(RARCH_PATH_BASENAME)[0];
+
+   for( int i = 0; i < n; i++)
+   {
+      if (full_path[i] == '/' || full_path[i] =='\\')
+      {
+         delimiter = full_path[i];
+         break;
+      }
+   }
+
+   while (0 < n && (full_path[--n] != delimiter ));
+   if (full_path[n] == delimiter ) {
+   rom_filename = full_path + n + 1;
+
+   }
+   return rom_filename;
+
+}
+
+#define CRT_SAVE_GAME 0
+#define CRT_SAVE_CORE 1
+#define CRT_SAVE_GLOBAL 2
+
+static int action_ok_crt_cali_save_generic(int type)
+{
+  config_file_t         *conf = NULL;
+  char config_directory[DIR_MAX_LENGTH];
+  char core_config_directory[DIR_MAX_LENGTH];
+  char switchres_cfg_override_file[PATH_MAX_LENGTH];
+  char game_file_cfg[PATH_MAX_LENGTH];
+  settings_t *settings          = config_get_ptr();
+
+  char* rom_filename = get_game_name((char*) path_get(RARCH_PATH_BASENAME));
+  if (string_is_empty(rom_filename))
+    return false;
+
+  config_directory[0] = '\0';
+  fill_pathname_application_special(config_directory,
+        sizeof(config_directory),
+        APPLICATION_SPECIAL_DIRECTORY_CONFIG);
+
+  const char * core_name = (const char*)runloop_state_get_ptr()->system.info.library_name;
+
+  if (type == CRT_SAVE_GAME)
+  {
+    fill_pathname_join_special(core_config_directory, config_directory, core_name, sizeof(core_config_directory));
+    /* Ensure base config directory exists */
+    if (!path_is_directory(core_config_directory))
+      path_mkdir(core_config_directory);
+    // sprintf(game_file_cfg, "%s%s","switchres-cali", rom_filename);
+    fill_pathname_join_special_ext(switchres_cfg_override_file, config_directory, core_name, rom_filename, ".cfg",
+                                   sizeof(switchres_cfg_override_file));
+  }
+  else if (type == CRT_SAVE_CORE)
+  {
+    fill_pathname_join_special(core_config_directory, config_directory, core_name, sizeof(core_config_directory));
+    /* Ensure base config directory exists */
+    if (!path_is_directory(core_config_directory))
+      path_mkdir(core_config_directory);
+    fill_pathname_join_special_ext(switchres_cfg_override_file, config_directory, core_name, core_name, ".cfg",
+                                   sizeof(switchres_cfg_override_file));
+  }
+  else
+  {
+    fill_pathname_join_special_ext(switchres_cfg_override_file, config_directory, "", "", "switchres-cali.cfg",
+                                   sizeof(switchres_cfg_override_file));
+  }
+
+  RARCH_LOG("[CRT]: rom = %s, corename = %s, system wide config : %s\n", rom_filename, core_name, switchres_cfg_override_file);
+
+  /* Attempt to load file */
+  if (!(conf = config_file_new_alloc()))
+    return false;
+
+  config_set_int(conf, "crt_switch_center_adjust", settings->ints.crt_switch_center_adjust);
+  config_set_int(conf, "crt_switch_porch_adjust", settings->ints.crt_switch_porch_adjust);
+  config_set_int(conf, "crt_switch_vertical_adjust", settings->ints.crt_switch_vertical_adjust);
+
+  config_file_write(conf, switchres_cfg_override_file, true);
+  config_file_free(conf);
+
+  //RARCH_LOG("[CRT]: action_ok_crt_cali_save_for_system %s, %s, %u, %d, %d\n", path, label, type, idx, entry_idx);
+  return 0;
+}
+static int action_ok_crt_cali_save_for_system(const char *path,
+      const char *label, unsigned type, size_t idx, size_t entry_idx)
+{
+  return action_ok_crt_cali_save_generic(CRT_SAVE_CORE);
+}
+static int action_ok_crt_cali_save_for_game(const char *path,
+      const char *label, unsigned type, size_t idx, size_t entry_idx)
+{
+  return action_ok_crt_cali_save_generic(CRT_SAVE_GAME);
+}
+static int action_ok_crt_cali_save_for_global(const char *path,
+      const char *label, unsigned type, size_t idx, size_t entry_idx)
+{
+  return action_ok_crt_cali_save_generic(CRT_SAVE_GLOBAL);
+}
