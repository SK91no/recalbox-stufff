config BR2_PACKAGE_RETROARCH
	bool "Retroarch"
	depends on BR2_PACKAGE_RECALBOX_SYSTEM
	select BR2_PACKAGE_NANOARCH
	select BR2_PACKAGE_RETROARCH_ASSETS
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_XSERVER_XORG_SERVER if BR2_PACKAGE_RECALBOX_VIDEO_XORG_SERVER
	select BR2_PACKAGE_XWAYLAND if BR2_PACKAGE_RECALBOX_VIDEO_XWAYLAND
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBUSB
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_SDL
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_VULKAN_LOADER
	select BR2_PACKAGE_XLIB_LIBX11 if BR2_PACKAGE_RECALBOX_VIDEO_XORG_SERVER
	select BR2_PACKAGE_XLIB_LIBXEXT if BR2_PACKAGE_RECALBOX_VIDEO_XORG_SERVER
	select BR2_PACKAGE_ZLIB
	help
	  A multi emulator frontend.

	  http://www.libretro.com

comment "Retroarch depends on EGL or OpenGLES"
	depends on !(BR2_PACKAGE_HAS_LIBEGL || BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)
