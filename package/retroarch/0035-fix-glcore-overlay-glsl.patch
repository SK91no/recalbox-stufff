Render overlays through the GLSL backend on the GLCore driver (#18488)

gl3_render_overlay() only bound a shader program in the HAVE_SLANG path
(gl->pipelines.alpha_blend). When a GLSL (.glslp) shader is active the gl3
driver uses its own GLSL chain backend (gl->chain.active), and the overlay
was then drawn with no valid program / coords bound, so it never appeared.
This is why overlays showed up on the "gl" driver but not on "glcore".

Mirror gl3_draw_menu_texture and gl2_render_overlay: when gl->chain.active,
bind the stock blend program via the GLSL backend, push the overlay coords
and MVP through it, draw each overlay from texture unit 0, then restore the
default chain coords. The previous slang path is kept in the else branch.

--- a/gfx/drivers/gl3.c
+++ b/gfx/drivers/gl3.c
@@ -1528,40 +1528,75 @@
    if (gl->flags & GL3_FLAG_OVERLAY_FULLSCREEN)
       glViewport(0, 0, width, height);
 
+   if (gl->chain.active)
+   {
+      /* GLSL (.glslp) path: render the overlay through the GLSL shader
+       * backend with the stock blend program, exactly like the gl2 driver
+       * and like gl3_draw_menu_texture. Without this the overlay was drawn
+       * with no valid program bound and never showed up on the GLCore
+       * driver while it worked on the gl driver. */
+      gl->chain.shader->use(gl,
+            gl->chain.shader_data, VIDEO_SHADER_STOCK_BLEND, true);
+
+      gl->chain.coords.vertex    = gl->overlay_vertex_coord;
+      gl->chain.coords.tex_coord = gl->overlay_tex_coord;
+      gl->chain.coords.color     = gl->overlay_color_coord;
+      gl->chain.coords.vertices  = 4 * gl->overlays;
+
+      gl->chain.shader->set_coords(gl->chain.shader_data, &gl->chain.coords);
+      gl->chain.shader->set_mvp(gl->chain.shader_data, &gl->mvp_no_rot);
+
+      glActiveTexture(GL_TEXTURE0);
+      for (i = 0; i < gl->overlays; i++)
+      {
+         glBindTexture(GL_TEXTURE_2D, gl->overlay_tex[i]);
+         glDrawArrays(GL_TRIANGLE_STRIP, (GLint)(4 * i), 4);
+      }
+
+      /* Restore the default chain coords. */
+      gl->chain.coords.vertex        = gl->chain.vertex_ptr;
+      gl->chain.coords.tex_coord     = gl->chain.tex_info.coord;
+      gl->chain.coords.color         = gl3_colors;
+      gl->chain.coords.lut_tex_coord = gl3_vertexes;
+      gl->chain.coords.vertices      = 4;
+   }
 #ifdef HAVE_SLANG
