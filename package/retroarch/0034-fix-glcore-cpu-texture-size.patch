Fix GLCore CPU texture size for GLSL shaders (issue #18488)

The GLSL render chain in gl3.c assumes the streamed CPU input texture has
a fixed RARCH_SCALE_BASE * input_scale size, exactly like the legacy gl2
driver (gl->tex_w = gl->tex_h = RARCH_SCALE_BASE * input_scale). The frame
is uploaded into the corner and the texture coordinates
(width / (RARCH_SCALE_BASE * input_scale)) select the valid region.

Commit 7/7 of the upstream GLSL/GLCore fix (PR #18455) instead sized the
texture to next_pow2(max(width, height)), which does not match the size the
rest of the chain assumes. When they differ, the texture coordinates sample
the wrong sub-region and only a corner of the image is shown, stretched to
fullscreen (NES from launch, Saturn/ST-V depending on resolution).

This restores the gl2 behaviour: allocate the input texture at
RARCH_SCALE_BASE * input_scale and upload the frame at its real size into
the corner.

--- a/gfx/drivers/gl3.c
+++ b/gfx/drivers/gl3.c
@@ -3462,16 +3462,21 @@
       struct gl3_streamed_texture *streamed,
       const void *frame, unsigned width, unsigned height, unsigned pitch)
 {
+   unsigned tex_width  = width;
+   unsigned tex_height = height;
+
    if (gl->chain.active)
    {
-      /* The input texture is expected to be square with a power of 2 size when not using Slang */
-      unsigned max = width > height ? width : height;
-      unsigned pow2_size = next_pow2(max);
-      width = pow2_size;
-      height = pow2_size;
+      /* The GLSL render chain (non-Slang path) assumes the input texture has
+       * a fixed RARCH_SCALE_BASE * input_scale size, exactly like the gl2
+       * driver. The frame is uploaded into the corner and the texture
+       * coordinates select the valid sub-region. Sizing to next_pow2 of the
+       * frame broke this and showed only a corner of the image (issue #18488). */
+      tex_width  = RARCH_SCALE_BASE * gl->video_info.input_scale;
+      tex_height = RARCH_SCALE_BASE * gl->video_info.input_scale;
    }
 
-   if (width != streamed->width || height != streamed->height)
+   if (tex_width != streamed->width || tex_height != streamed->height)
    {
       if (streamed->tex != 0)
          glDeleteTextures(1, &streamed->tex);
@@ -3481,9 +3486,9 @@
             gl->video_info.rgb32
             ? GL_RGBA8
             : GL_RGB565,
-            width, height);
-      streamed->width = width;
-      streamed->height = height;
+            tex_width, tex_height);
+      streamed->width = tex_width;
+      streamed->height = tex_height;
 
       if (gl->video_info.rgb32)
       {
