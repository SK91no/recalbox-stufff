+/* Returns the maximum progressive scanlines achievable at the core's refresh
+ * rate for the configured monitor type. The calculation ensures the integer
+ * downscale result will fit at the ORIGINAL game hz, not at a different rate.
+ *
+ * Formula per frequency band: min(spec_max, floor(hfreq / hz) - blank_lines)
+ * Constants from deps/switchres/monitor.cpp vertical_blank field:
+ *   15kHz: hfreq=15625 Hz, vertical_blank=1.024ms -> blank=16 lines
+ *   25kHz: hfreq=24960 Hz, vertical_blank=1.000ms -> blank=25 lines
+ *   31kHz: hfreq=31450 Hz, vertical_blank=1.017ms -> blank=32 lines
+ *
+ * For multi-range monitors, return the max across all supported bands since
+ * SwitchRes will pick the highest-capable range for tall content. */
+static int crt_tate_max_progressive_lines(unsigned crt_mode, float hz)
+{
+   /* Max active lines achievable at this hz per frequency band */
+   int max_15 = (int)(15625.0f / hz) - 16;
+   int max_25 = (int)(24960.0f / hz) - 25;
+   int max_31 = (int)(31450.0f / hz) - 32;
+
+   /* Cap to each band's spec progressive_lines_max */
+   if (max_15 > 288) max_15 = 288;
+   if (max_25 > 400) max_25 = 400;
+   if (max_31 > 512) max_31 = 512;
+
+   switch (crt_mode)
+   {
+      case 8:  /* forced_240p - fixed resolution */
+         return 240;
+      case 10: /* ntsc - fixed 59.94Hz */
+         return (max_15 < 240) ? max_15 : 240;
+      case 6:  /* pc_31_120: 31kHz at 100-130Hz, special case */
+         return 512; /* don't interfere, SwitchRes handles it */
+      case 7:  /* arcade_15_no_50 */
+      case 16: /* tv_15khz_prog_57hz_min */
+         return (max_15 < 256) ? max_15 : 256;
+      case 1:  /* arcade_15 */
+      case 9:  /* pal */
+      case 15: /* forced_15_progressive */
+         return max_15;
+      case 14: /* forced_384p 24kHz fixed 59.9-60.1Hz */
+      case 19:
+         return (max_25 < 384) ? max_25 : 384;
+      case 18: /* forced_480p 31kHz fixed 59.9-60.1Hz */
+         return (max_31 < 480) ? max_31 : 480;
+      case 2:  /* arcade_15_25 */
+      case 13: /* tv_15_25 */
+         return (max_15 > max_25) ? max_15 : max_25;
+      case 3:  /* arcade_31 */
+         return max_31;
+      case 4:  /* arcade_15_31 */
+      case 12: /* tv_15_31 */
+         return (max_31 > max_15) ? max_31 : max_15;
+      case 5:  /* arcade_15_25_31 */
+      case 11: /* tv_15_25_31 */
+      {
+         int m = (max_25 > max_15) ? max_25 : max_15;
+         return (max_31 > m) ? max_31 : m;
+      }
+      case 17: /* custom ini - assume 15kHz conservatively */
+      default:
+         return max_15;
+   }
+}
