From b78fa26c682300d2528c3572acf83221b6952129 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E5=88=98=E7=9A=93?= <whiteaxe@tuta.io>
Date: Sat, 22 Nov 2025 11:28:12 -0500
Subject: [PATCH 6/7] Don't set `glsl_core` to true in gl3.c if using OpenGL ES

---
 gfx/drivers/gl3.c                | 8 +++++++-
 gfx/drivers_shader/shader_glsl.c | 4 ----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/gfx/drivers/gl3.c b/gfx/drivers/gl3.c
index fccb88c2b6e3..d98083d806d3 100644
--- a/gfx/drivers/gl3.c
+++ b/gfx/drivers/gl3.c
@@ -2593,7 +2593,13 @@ static bool gl3_init_filter_chain_with_path(gl3_t *gl, const char *shader_path)
 
 #ifdef HAVE_GLSL
    if (type == RARCH_SHADER_GLSL)
-      gl_glsl_set_context_type(true, gl->version_major, gl->version_minor);
+      gl_glsl_set_context_type(
+#ifdef HAVE_OPENGLES
+            false,
+#else
+            true,
+#endif
+            gl->version_major, gl->version_minor);
 #endif
 
 #ifdef HAVE_SLANG
diff --git a/gfx/drivers_shader/shader_glsl.c b/gfx/drivers_shader/shader_glsl.c
index 067c9e5582e1..894d8286bd7f 100644
--- a/gfx/drivers_shader/shader_glsl.c
