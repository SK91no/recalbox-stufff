config BR2_PACKAGE_RECALBOX_RGB_DUAL
	bool "Recalbox RGB Dual 1 and 2 dts and driver"
	depends on BR2_LINUX_KERNEL
	help
	  Support for Recalbox RGB Dual 1 & 2,
	  the dual scart and vga dac
	  for Rasbperry Pi 4, 400, 3 and Zero2

comment "Recalbox RGB Dual needs a kernel and headers"
	depends on !BR2_LINUX_KERNEL
