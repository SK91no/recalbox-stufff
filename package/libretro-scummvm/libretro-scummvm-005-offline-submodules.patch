libretro-scummvm builds two dependency repos (libretro-common, libretro-deps) that its
own dependencies.mk otherwise git-clones from github at build time, which breaks a
hermetic/offline build (and fails the whole build when github is unreachable). The
buildroot package now pre-populates deps/ from EXTRA_DOWNLOADS; this makes
configure_submodules.sh accept an already-populated folder instead of re-cloning it.

--- a/backends/platform/libretro/scripts/configure_submodules.sh
+++ b/backends/platform/libretro/scripts/configure_submodules.sh
@@ -39,6 +39,13 @@
 	exit 1
 fi
 
+# Recalbox: the buildroot package pre-populates the dependency folders offline, so
+# the build never reaches the network. A non-empty pre-placed folder is taken as-is.
+if [ -d "$SUBMODULES_PATH/$SUBMODULE_FOLDER" ] && [ -n "$(ls -A "$SUBMODULES_PATH/$SUBMODULE_FOLDER" 2>/dev/null)" ] ; then
+	echo 0
+	exit 0
+fi
+
 # Create submodules folder if does not exist and move into it
 [ ! -d $SUBMODULES_PATH ] && mkdir -p $SUBMODULES_PATH
 
