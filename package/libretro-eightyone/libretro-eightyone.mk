################################################################################
#
# libretro-heightyone
#
################################################################################

# Commit of 2026/04/15
LIBRETRO_EIGHTYONE_VERSION = v1.0.1
LIBRETRO_EIGHTYONE_SITE = https://gitlab-ci-token:$(GITLAB_TOKEN_RECALBOX_CORES)@gitlab.com/recalbox/packages/recalbox-cores/libretro-eightyone.git
LIBRETRO_EIGHTYONE_SITE_METHOD = git
LIBRETRO_EIGHTYONE_GIT_SUBMODULES = YES
LIBRETRO_EIGHTYONE_LICENSE = GPL-2.0+
LIBRETRO_EIGHTYONE_LICENSE_FILES = LICENSE
LIBRETRO_EIGHTYONE_DEPENDENCIES += zlib

LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_BUILD_TYPE=Release

define LIBRETRO_EIGHTYONE_INSTALL_TARGET_CMDS
	$(INSTALL) -D $(@D)/eightyone_libretro.so \
		$(TARGET_DIR)/usr/lib/libretro/eightyone_libretro.so
endef

LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_C_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_C_ARCHIVE_FINISH=true
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_FINISH=true
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_AR="$(TARGET_CC)-ar"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_C_COMPILER="$(TARGET_CC)"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_CXX_COMPILER="$(TARGET_CXX)"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_LINKER="$(TARGET_LD)"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_C_FLAGS="$(COMPILER_COMMONS_CFLAGS_SO)"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_CXX_FLAGS="$(COMPILER_COMMONS_CXXFLAGS_SO)"
LIBRETRO_EIGHTYONE_CONF_OPTS += -DCMAKE_SHARED_LINKER_FLAGS="$(COMPILER_COMMONS_LDFLAGS_SO)"

$(eval $(cmake-package))
