 #endif // CORE_DIR_H
diff --git a/src/game/file_io.c b/src/game/file_io.c
index bca5285e..7693eeb1 100644
--- a/src/game/file_io.c
+++ b/src/game/file_io.c
@@ -635,7 +635,16 @@ int game_file_io_read_saved_game(const char *filename, int offset)
     init_savegame_data();
 
     log_info("Loading saved game", filename, 0);
-    FILE *fp = file_open(dir_get_file(filename, NOT_LOCALIZED), "rb");
+
+    FILE *fp = NULL;
+
+    if (strstr(filename, ".sav") != NULL) {
+        static char custom_path[1024];
+        snprintf(custom_path, 1024, "/recalbox/share/saves/caesar3/%s", filename);
+        fp = fopen(custom_path, "rb");
+    } else {
+        fp = file_open(dir_get_file(filename, NOT_LOCALIZED), "rb");
+    }
     if (!fp) {
         log_error("Unable to load game", 0, 0);
         return 0;
@@ -658,10 +667,13 @@ int game_file_io_write_saved_game(const char *filename)
     init_savegame_data();
 
     log_info("Saving game", filename, 0);
+    static char save_dir[1024] = "/recalbox/share/saves/caesar3";
+    static char custom_path[1024];
+    snprintf(custom_path, 1024, "%s/%s", save_dir, filename);
     savegame_version = SAVE_GAME_VERSION;
     savegame_save_to_state(&savegame_data.state);
 
-    FILE *fp = file_open(filename, "wb");
+    FILE *fp = file_open(custom_path, "wb");
     if (!fp) {
         log_error("Unable to save game", 0, 0);
         return 0;
diff --git a/src/platform/file_manager.c b/src/platform/file_manager.c
index 958df392..7cbbdaaa 100644
--- a/src/platform/file_manager.c
+++ b/src/platform/file_manager.c
@@ -322,3 +322,20 @@ int platform_file_manager_close_file(FILE *stream)
 #endif
     return result;
 }
+
+int file_exists_in_custom_dir(const char *filename, const char *custom_dir)
+{
+    if (!filename || !custom_dir) {
+        return 0;
+    }
+    
+    char full_path[1024];
+    snprintf(full_path, 1024, "%s/%s", custom_dir, filename);
+    
+    FILE *fp = fopen(full_path, "rb");
+    if (fp) {
+        fclose(fp);
+        return 1;
+    }
+    return 0;
+}
diff --git a/src/platform/file_manager.h b/src/platform/file_manager.h
index 01eca766..07b6b660 100644
--- a/src/platform/file_manager.h
+++ b/src/platform/file_manager.h
@@ -81,4 +81,6 @@ int platform_file_manager_close_file(FILE *stream);
  */
 int platform_file_manager_remove_file(const char *filename);
 
+int file_exists_in_custom_dir(const char *filename, const char *custom_dir);
+
 #endif // PLATFORM_FILE_MANAGER_H
