################################################################################
#
# EXEL-HENCE - Exelvision EXL 100
#
################################################################################

LIBRETRO_EXEL_HENCE_VERSION = v0.9
LIBRETRO_EXEL_HENCE_SITE = https://gitlab.com/recalbox/packages/recalbox-cores/libretro-exel-hence.git
LIBRETRO_EXEL_HENCE_SITE_METHOD = git
LIBRETRO_EXEL_HENCE_DEPENDENCIES += zlib
LIBRETRO_EXEL_HENCE_LICENSE = GPL-2.0
LIBRETRO_EXEL_HENCE_LICENSE_FILES = COPYING

define LIBRETRO_EXEL_HENCE_INSTALL_TARGET_CMDS
	$(INSTALL) -D $(@D)/exel-hence_libretro.so $(TARGET_DIR)/usr/lib/libretro/exel-hence_libretro.so
endef

LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_C_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_C_ARCHIVE_FINISH=true
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_FINISH=true
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_AR="$(TARGET_CC)-ar"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_C_COMPILER="$(TARGET_CC)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_CXX_COMPILER="$(TARGET_CXX)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_LINKER="$(TARGET_LD)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_C_FLAGS="$(COMPILER_COMMONS_CFLAGS_LTO)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_CXX_FLAGS="$(COMPILER_COMMONS_CXXFLAGS_LTO)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DCMAKE_LINKER_EXE_FLAGS="$(COMPILER_COMMONS_LDFLAGS_LTO)"
LIBRETRO_EXEL_HENCE_CONF_OPTS += -DEXELHENCE_CORE_VERSION="$(LIBRETRO_EXEL_HENCE_VERSION)"

$(eval $(cmake-package))
