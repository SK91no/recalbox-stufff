################################################################################
#
# MAME
#
################################################################################

# Romset 0.278 - don't forget to sync package arcade-dats
LIBRETRO_MAME0278_VERSION = fba50741006fa3e27e1897f589d2048a505b8fd6
LIBRETRO_MAME0278_SITE = $(call github,libretro,mame,$(LIBRETRO_MAME0278_VERSION))
LIBRETRO_MAME0278_LICENSE = MAME
LIBRETRO_MAME0278_NON_COMMERCIAL = y
LIBRETRO_MAME0278_DEPENDENCIES = alsa-lib arcade-dats

ifeq ($(BR2_x86_64),y)
LIBRETRO_MAME0278_OPTS += PTR64=1
LIBRETRO_MAME0278_OPTS += LIBRETRO_CPU=x86_64
LIBRETRO_MAME0278_OPTS += PLATFORM=x86
endif

ifeq ($(BR2_i386),y)
LIBRETRO_MAME0278_OPTS += PTR64=0
LIBRETRO_MAME0278_OPTS += LIBRETRO_CPU=x86
LIBRETRO_MAME0278_OPTS += PLATFORM=x86
LIBRETRO_MAME0278_OPTS += ARCHITECTURE=""
endif

ifeq ($(BR2_arm),y)
LIBRETRO_MAME0278_OPTS += PTR64=0
LIBRETRO_MAME0278_OPTS += LIBRETRO_CPU=arm
LIBRETRO_MAME0278_OPTS += PLATFORM=arm
LIBRETRO_MAME0278_OPTS += ARCHITECTURE=""
LIBRETRO_MAME0278_OPTS += NOASM=1
LIBRETRO_MAME0278_ARCHOPTS += -D__arm__
else ifeq ($(BR2_aarch64),y)
LIBRETRO_MAME0278_OPTS += PTR64=1
LIBRETRO_MAME0278_OPTS += LIBRETRO_CPU=aarch64
LIBRETRO_MAME0278_OPTS += PLATFORM=arm64
LIBRETRO_MAME0278_OPTS += ARCHITECTURE=""
LIBRETRO_MAME0278_OPTS += NOASM=0
LIBRETRO_MAME0278_OPTS += BIGENDIAN=0
endif

LIBRETRO_MAME0278_OPTS += ARCHOPTS="$(LIBRETRO_MAME0278_ARCHOPTS)"

LIBRETRO_MAME0278_OPTS += PROJECT=""
LIBRETRO_MAME0278_OPTS += DISTRO=debian-stable
LIBRETRO_MAME0278_OPTS += TARGETOS=linux
LIBRETRO_MAME0278_OPTS += LIBRETRO_OS=unix
LIBRETRO_MAME0278_OPTS += CONFIG=libretro
LIBRETRO_MAME0278_OPTS += OSD=retro
LIBRETRO_MAME0278_OPTS += TARGET=mame
LIBRETRO_MAME0278_OPTS += SUBTARGET=arcade
LIBRETRO_MAME0278_OPTS += PYTHON_EXECUTABLE=python3
LIBRETRO_MAME0278_OPTS += OPENMP=1
LIBRETRO_MAME0278_OPTS += REGENIE=1
LIBRETRO_MAME0278_OPTS += VERBOSE=1
LIBRETRO_MAME0278_OPTS += NOWERROR=1
LIBRETRO_MAME0278_OPTS += RETRO=1
LIBRETRO_MAME0278_OPTS += DEBUG=0
LIBRETRO_MAME0278_OPTS += ARCH=""

LIBRETRO_MAME0278_OPTS += OPTIMIZE=3
#LIBRETRO_MAME0278_OPTS += LTO=1

LIBRETRO_MAME0278_OPTS += CROSS_BUILD=1
LIBRETRO_MAME0278_OPTS += OVERRIDE_CXX="$(TARGET_CXX)" OVERRIDE_CC="$(TARGET_CC)" OVERRIDE_LD="$(TARGET_LD)"
LIBRETRO_MAME0278_OPTS += RANLIB="$(TARGET_RANLIB)" AR="$(TARGET_AR)"

define LIBRETRO_MAME0278_BUILD_CMDS
	$(MAKE) -C $(@D)/ -f makefile $(LIBRETRO_MAME0278_OPTS)
endef

define LIBRETRO_MAME0278_INSTALL_TARGET_CMDS
	$(call InstallArcadeFiles,libretro,mame0278,$(LIBRETRO_MAME0278_VERSION))
	$(INSTALL) -D $(@D)/mamearcade_libretro.so \
		$(TARGET_DIR)/usr/lib/libretro/mame0278_libretro.so
	mkdir -p $(TARGET_DIR)/recalbox/share_upgrade/bios/mame/samples
endef

define LIBRETRO_MAME0278_HISCORE
	mkdir -p $(TARGET_DIR)/usr/share/libretro-mame/mame0278/ini
	mkdir -p $(TARGET_DIR)/usr/share/libretro-mame/mame0278/plugins
	cp -r $(@D)/plugins/* \
		$(TARGET_DIR)/usr/share/libretro-mame/mame0278/plugins
	cp $(LIBRETRO_MAME0278_PKGDIR)/plugin.ini \
		$(TARGET_DIR)/usr/share/libretro-mame/mame0278/ini/
	cp $(LIBRETRO_MAME0278_PKGDIR)/mame.ini \
		$(TARGET_DIR)/usr/share/libretro-mame/mame0278/ini/
endef

LIBRETRO_MAME0278_POST_INSTALL_TARGET_HOOKS += LIBRETRO_MAME0278_HISCORE

$(eval $(generic-package))
