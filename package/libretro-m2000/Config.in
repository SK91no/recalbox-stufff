config BR2_PACKAGE_LIBRETRO_M2000
	bool "libretro-m2000"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	help
	  M2000 - Philips P2000T Home Computer Emulator

	  https://github.com/p2000t/M2000

comment "LIBRETRO_M2000 needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
