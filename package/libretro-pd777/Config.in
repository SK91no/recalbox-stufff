config BR2_PACKAGE_LIBRETRO_PD777
	bool "libretro-pd777"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ZLIB
	help
	  A libretro Cassette Vision emulator.

	  http://www.libretro.com

comment "LIBRETRO_PD777 needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
