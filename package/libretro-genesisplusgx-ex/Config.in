config BR2_PACKAGE_LIBRETRO_GENESISPLUSGX_EX
	bool "libretro-genesisplusgx-ex"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
