################################################################################
#
# MAME
#
################################################################################

# Romset 0.258 - don't forget to sync package arcade-dats
LIBRETRO_MAME0258_VERSION = dc1a96537089d6d4ecd01d9886b21061471c70c0
LIBRETRO_MAME0258_SITE = $(call github,libretro,mame,$(LIBRETRO_MAME0258_VERSION))
LIBRETRO_MAME0258_LICENSE = MAME
LIBRETRO_MAME0258_NON_COMMERCIAL = y
LIBRETRO_MAME0258_DEPENDENCIES = alsa-lib arcade-dats

ifeq ($(BR2_x86_64),y)
LIBRETRO_MAME0258_OPTS += PTR64=1
LIBRETRO_MAME0258_OPTS += LIBRETRO_CPU=x86_64
LIBRETRO_MAME0258_OPTS += PLATFORM=x86_64
endif

ifeq ($(BR2_i386),y)
LIBRETRO_MAME0258_OPTS += PTR64=0
LIBRETRO_MAME0258_OPTS += LIBRETRO_CPU=x86
LIBRETRO_MAME0258_OPTS += PLATFORM=x86
LIBRETRO_MAME0258_OPTS += ARCHITECTURE=""
endif

ifeq ($(BR2_arm),y)
LIBRETRO_MAME0258_OPTS += PTR64=0
LIBRETRO_MAME0258_OPTS += LIBRETRO_CPU=arm
LIBRETRO_MAME0258_OPTS += PLATFORM=arm
LIBRETRO_MAME0258_OPTS += ARCHITECTURE=""
LIBRETRO_MAME0258_OPTS += NOASM=1
LIBRETRO_MAME0258_ARCHOPTS += -D__arm__
else ifeq ($(BR2_aarch64),y)
LIBRETRO_MAME0258_OPTS += PTR64=1
LIBRETRO_MAME0258_OPTS += LIBRETRO_CPU=arm64
LIBRETRO_MAME0258_OPTS += PLATFORM=arm64
LIBRETRO_MAME0258_OPTS += ARCHITECTURE=""
LIBRETRO_MAME0258_OPTS += NOASM=1
endif

LIBRETRO_MAME0258_OPTS += ARCHOPTS="$(LIBRETRO_MAME0258_ARCHOPTS)"

LIBRETRO_MAME0258_OPTS += PROJECT=""
LIBRETRO_MAME0258_OPTS += DISTRO=debian-stable
LIBRETRO_MAME0258_OPTS += TARGETOS=linux
LIBRETRO_MAME0258_OPTS += LIBRETRO_OS=unix
LIBRETRO_MAME0258_OPTS += CONFIG=libretro
LIBRETRO_MAME0258_OPTS += OSD=retro
LIBRETRO_MAME0258_OPTS += TARGET=mame
LIBRETRO_MAME0258_OPTS += SUBTARGET=arcade
LIBRETRO_MAME0258_OPTS += PYTHON_EXECUTABLE=python3
LIBRETRO_MAME0258_OPTS += OPENMP=1
LIBRETRO_MAME0258_OPTS += REGENIE=1
LIBRETRO_MAME0258_OPTS += VERBOSE=1
LIBRETRO_MAME0258_OPTS += NOWERROR=1
LIBRETRO_MAME0258_OPTS += RETRO=1
LIBRETRO_MAME0258_OPTS += DEBUG=0
LIBRETRO_MAME0258_OPTS += ARCH=""

LIBRETRO_MAME0258_OPTS += OPTIMIZE=3
#LIBRETRO_MAME0258_OPTS += LTO=1

LIBRETRO_MAME0258_OPTS += CROSS_BUILD=1
LIBRETRO_MAME0258_OPTS += OVERRIDE_CXX="$(TARGET_CXX)" OVERRIDE_CC="$(TARGET_CC)" OVERRIDE_LD="$(TARGET_LD)"
LIBRETRO_MAME0258_OPTS += RANLIB="$(TARGET_RANLIB)" AR="$(TARGET_AR)"

define LIBRETRO_MAME0258_BUILD_CMDS
	mkdir -p $(@D)/build/gmake/libretro/obj/x64/libretro/src/osd/retro
	mkdir -p $(@D)/3rdparty/genie/build/gmake.linux/obj/Release/src/host
	$(MAKE) -j4 -C $(@D)/ -f makefile $(LIBRETRO_MAME0258_OPTS)
endef

define LIBRETRO_MAME0258_INSTALL_TARGET_CMDS
	$(call InstallArcadeFiles,libretro,mame0258,$(LIBRETRO_MAME0258_VERSION))
	$(INSTALL) -D $(@D)/mamearcade_libretro.so \
		$(TARGET_DIR)/usr/lib/libretro/mame0258_libretro.so
	mkdir -p $(TARGET_DIR)/recalbox/share_upgrade/bios/mame/samples
endef

define LIBRETRO_MAME0258_HISCORE
	mkdir -p $(TARGET_DIR)/usr/share/libretro-mame/mame0258/ini
	mkdir -p $(TARGET_DIR)/usr/share/libretro-mame/mame0258/plugins
	cp -r $(@D)/plugins/* \
		$(TARGET_DIR)/usr/share/libretro-mame/mame0258/plugins
	cp $(LIBRETRO_MAME0258_PKGDIR)/plugin.ini \
		$(TARGET_DIR)/usr/share/libretro-mame/mame0258/ini/
endef

LIBRETRO_MAME0258_POST_INSTALL_TARGET_HOOKS += LIBRETRO_MAME0258_HISCORE

$(eval $(generic-package))
