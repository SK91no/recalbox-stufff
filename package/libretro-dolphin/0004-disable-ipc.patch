From 6bf077e5b53ed010d2d649ec59af81f0be9b3149 Mon Sep 17 00:00:00 2001
From: Pit64 <yrigaud@icloud.com>
Date: Mon, 19 Jan 2026 13:56:50 +0100
Subject: [PATCH 4/4] disable ipc

---
 CMakeLists.txt                               | 2 +-
 Source/Core/Core/CMakeLists.txt              | 2 +-
 Source/Core/Core/HW/EXI/EXI_DeviceEthernet.h | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 17c40f2088..f6f407b52e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -854,7 +854,7 @@ if (NOT IOS)
   add_subdirectory(Externals/watcher)
 endif()
 
-if(WIN32 OR LINUX)
+if((WIN32 OR LINUX) AND NOT LIBRETRO)
   add_subdirectory(Externals/cpp-ipc)
 endif()
 
diff --git a/Source/Core/Core/CMakeLists.txt b/Source/Core/Core/CMakeLists.txt
index 511702a748..9cb4c3ac66 100644
--- a/Source/Core/Core/CMakeLists.txt
+++ b/Source/Core/Core/CMakeLists.txt
@@ -801,7 +801,7 @@ if(UNIX)
   )
 endif()
 
-if(WIN32 OR LINUX)
+if((WIN32 OR LINUX) AND NOT LIBRETRO)
   target_sources(core PRIVATE HW/EXI/BBA/IPC.cpp)
   target_link_libraries(core PRIVATE cpp-ipc::ipc)
 endif()
diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceEthernet.h b/Source/Core/Core/HW/EXI/EXI_DeviceEthernet.h
index 8cb0e52758..937469d8d2 100644
--- a/Source/Core/Core/HW/EXI/EXI_DeviceEthernet.h
+++ b/Source/Core/Core/HW/EXI/EXI_DeviceEthernet.h
@@ -15,7 +15,7 @@
 #endif
 
 #include <SFML/Network.hpp>
-#if defined(WIN32) || (defined(__linux__) && !defined(__ANDROID__))
+#if !defined(__LIBRETRO__) && (defined(WIN32) || (defined(__linux__) && !defined(__ANDROID__)))
 #include <libipc/ipc.h>
 #endif
 
@@ -483,7 +483,7 @@ private:
   public:
     explicit IPCBBAInterface(CEXIETHERNET* const eth_ref) : NetworkInterface(eth_ref) {}
 
-#if defined(WIN32) || (defined(__linux__) && !defined(__ANDROID__))
+#if !defined(__LIBRETRO__) && (defined(WIN32) || (defined(__linux__) && !defined(__ANDROID__)))
 
     bool Activate() override;
     void Deactivate() override;
-- 
2.52.0

