config BR2_PACKAGE_MOONLIGHT_EMBEDDED
	bool "moonlight-embedded"
	select BR2_PACKAGE_OPUS
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCEC
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_LIBENET
	select BR2_PACKAGE_RPI_FIRMWARE \
		if BR2_PACKAGE_RECALBOX_TARGET_RPI3  || \
		   BR2_PACKAGE_RECALBOX_TARGET_RPIZERO2 || \
		   BR2_PACKAGE_RECALBOX_TARGET_RPI4_64  || \
		   BR2_PACKAGE_RECALBOX_TARGET_RPI5_64
	select BR2_PACKAGE_LIBDRM \
		if BR2_PACKAGE_RECALBOX_TARGET_RPI3     || \
		   BR2_PACKAGE_RECALBOX_TARGET_RPI4_64  || \
		   BR2_PACKAGE_RECALBOX_TARGET_RPI5_64
	select BR2_PACKAGE_SDL2 \
		if BR2_PACKAGE_RECALBOX_TARGET_X86_64
	select BR2_PACKAGE_PULSEAUDIO \
		if BR2_PACKAGE_RECALBOX_TARGET_X86_64
	select BR2_PACKAGE_LIBVA \
		if BR2_PACKAGE_RECALBOX_TARGET_X86_64
	select BR2_PACKAGE_XLIB_LIBX11 \
		if BR2_PACKAGE_RECALBOX_TARGET_X86_64
	select BR2_PACKAGE_LIBAMCODEC \
		if BR2_PACKAGE_LIBAMCODEC
	help
	  Gamestream client for embedded systems.
	  https://github.com/irtimmer/moonlight-embedded/wiki
