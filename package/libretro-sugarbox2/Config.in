config BR2_PACKAGE_LIBRETRO_SUGARBOX2
	bool "libretro-sugarbox2"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ZLIB
	help
	  An Amstrad CPC/CPC+/GX4000 libretro core.

	  https://gitlab.com/recalbox/packages/recalbox-cores/libretro-sugarbox2

comment "LIBRETRO_SUGARBOX2 needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
