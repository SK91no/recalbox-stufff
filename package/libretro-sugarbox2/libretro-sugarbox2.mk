################################################################################
#
# Amstrad CPC/CPC+/GX4000 libretro core
#
################################################################################

# Commit of 2025/05/27
LIBRETRO_SUGARBOX2_VERSION = v0.9
LIBRETRO_SUGARBOX2_SITE = https://gitlab.com/recalbox/packages/recalbox-cores/libretro-sugarbox2.git
LIBRETRO_SUGARBOX2_SITE_METHOD = git
LIBRETRO_SUGARBOX2_GIT_SUBMODULES = y
LIBRETRO_SUGARBOX2_LICENSE = GPL-2.0 MIT
LIBRETRO_SUGARBOX2_DEPENDENCIES += zlib

LIBRETRO_SUGARBOX2_CONF_OPTS += \
	-DCMAKE_BUILD_TYPE=Release

LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_C_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_C_ARCHIVE_FINISH=true
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_CREATE="<CMAKE_AR> qcs <TARGET> <LINK_FLAGS> <OBJECTS>"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_CXX_ARCHIVE_FINISH=true
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_AR="$(TARGET_CC)-ar"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_C_COMPILER="$(TARGET_CC)"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_CXX_COMPILER="$(TARGET_CXX)"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_LINKER="$(TARGET_LD)"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_C_FLAGS="$(COMPILER_COMMONS_CFLAGS_SO)"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_CXX_FLAGS="$(COMPILER_COMMONS_CXXFLAGS_SO)"
LIBRETRO_SUGARBOX2_CONF_OPTS += -DCMAKE_LINKER_EXE_FLAGS="$(COMPILER_COMMONS_LDFLAGS_SO)"

define LIBRETRO_SUGARBOX2_INSTALL_TARGET_CMDS
	$(INSTALL) -D $(@D)/sugarbox2_libretro.so \
		$(TARGET_DIR)/usr/lib/libretro/sugarbox2_libretro.so
endef

$(eval $(cmake-package))
