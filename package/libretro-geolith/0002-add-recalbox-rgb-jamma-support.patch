+                b &= ~jb->map[i].v;
         }
     }
     else {
-        for (unsigned i = 0; i < 12; ++i) {
-            if (input_state_cb(port, RETRO_DEVICE_JOYPAD, 0, bindmap_js[i].k))
-                b &= ~bindmap_js[i].v;
+        for (unsigned i = 0; i < jb->count; ++i) {
+            if (input_state_cb(port, RETRO_DEVICE_JOYPAD, 0, jb->map[i].k))
+                b &= ~jb->map[i].v;
         }
     }
 
@@ -987,6 +1048,27 @@
 
 void retro_set_controller_port_device(unsigned port, unsigned device) {
     log_cb(RETRO_LOG_INFO, "Plugging device %u into port %u.\n", device, port);
+
+    if (port >= 4)
+        return;
+
+    // Select the per-port joystick bindmap for Recalbox RGB JAMMA layouts.
+    // Any other device (Joystick/None/...) keeps the standard Neo Geo layout.
+    switch (device) {
+        case RETRO_RB_JAMMA_NEOLINE:
+            js_bind[port].map = bindmap_js_neoline;
+            js_bind[port].count = 8;
+            break;
+        case RETRO_RB_JAMMA_NEOSQUARE:
+            js_bind[port].map = bindmap_js_neosquare;
+            js_bind[port].count = 8;
+            break;
+        case RETRO_RB_JAMMA_STANDARD:
+        default:
+            js_bind[port].map = bindmap_js;
+            js_bind[port].count = 12;
+            break;
+    }
 }
 
 void retro_get_system_info(struct retro_system_info *info) {
@@ -1300,6 +1382,7 @@
     }
     else {
         environ_cb(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, input_desc_js);
+        environ_cb(RETRO_ENVIRONMENT_SET_CONTROLLER_INFO, (void *)port_info);
     }
 
     geo_reset(1);
