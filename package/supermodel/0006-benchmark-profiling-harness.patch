 /******************************************************************************
+ Benchmark harness (enabled by -bench=N)
+******************************************************************************/
+
+// Weak: defined only in -fprofile-generate builds. Lets us flush PGO counters
+// at a clean point (threaded exit otherwise drops large TUs like ppc.o).
+extern "C" void __gcov_dump(void) __attribute__((weak));
+extern "C" void __gcov_reset(void) __attribute__((weak));   // reset counters so profile counts only measured frames
+
+static void PrintBenchReport(const std::vector<uint64_t> &deltaNs,
+                             const std::vector<FrameTimings> &ft,
+                             const std::string &csvPath,
+                             const Game &game)
+{
+  size_t n = deltaNs.size();
+  if (n == 0)
+    return;
+
+  std::vector<double> ms(n);
+  double sum = 0.0, sumSq = 0.0, mn = 1e18, mx = 0.0;
+  for (size_t i = 0; i < n; i++)
+  {
+    double v = double(deltaNs[i]) / 1.0e6;
+    ms[i] = v;
+    sum += v; sumSq += v * v;
+    if (v < mn) mn = v;
+    if (v > mx) mx = v;
+  }
+  double mean = sum / double(n);
+  double var = (sumSq / double(n)) - (mean * mean);
+  double stddev = var > 0.0 ? std::sqrt(var) : 0.0;
+
+  std::vector<double> sorted(ms);
+  std::sort(sorted.begin(), sorted.end());
+  auto pct = [&](double p) -> double {
+    if (n == 1) return sorted[0];
+    double idx = p * double(n - 1);
+    size_t lo = size_t(idx);
+    double frac = idx - double(lo);
+    if (lo + 1 < n) return sorted[lo] * (1.0 - frac) + sorted[lo + 1] * frac;
+    return sorted[lo];
+  };
+  double p1 = pct(0.01), p50 = pct(0.50), p90 = pct(0.90), p95 = pct(0.95), p99 = pct(0.99);
+  double fps = mean > 0.0 ? 1000.0 / mean : 0.0;
+
+  double aPpc=0, aRen=0, aSync=0, aSnd=0, aDrv=0, aFrm=0;
+  size_t m = ft.size();
+  for (size_t i = 0; i < m; i++)
+  {
+    aPpc += ft[i].ppcTicks; aRen += ft[i].renderTicks; aSync += ft[i].syncTicks;
+    aSnd += ft[i].sndTicks; aDrv += ft[i].drvTicks; aFrm += ft[i].frameTicks;
+  }
+  if (m) { aPpc/=m; aRen/=m; aSync/=m; aSnd/=m; aDrv/=m; aFrm/=m; }
+
+  printf("\n==================== SUPERMODEL BENCHMARK ====================\n");
+  printf(" game            : %s (%s)\n", game.title.c_str(), game.name.c_str());
+  printf(" frames measured : %zu\n", n);
+  printf(" --- wall-clock per frame (high-res, vsync/throttle OFF) ---\n");
+  printf(" mean            : %8.3f ms   (%.2f fps)\n", mean, fps);
+  printf(" median (p50)    : %8.3f ms   (%.2f fps)\n", p50, p50 > 0 ? 1000.0 / p50 : 0.0);
+  printf(" min / max       : %8.3f / %8.3f ms\n", mn, mx);
+  printf(" stddev          : %8.3f ms\n", stddev);
+  printf(" p1  / p90       : %8.3f / %8.3f ms\n", p1, p90);
+  printf(" p95 / p99       : %8.3f / %8.3f ms\n", p95, p99);
+  printf(" --- internal breakdown, mean ms (SDL_GetTicks, ms resolution) ---\n");
+  printf(" ppc=%.2f render=%.2f sync=%.2f snd=%.2f drv=%.2f frame=%.2f\n",
+         aPpc, aRen, aSync, aSnd, aDrv, aFrm);
+  printf("BENCH_RESULT game=%s frames=%zu mean_ms=%.3f median_ms=%.3f p99_ms=%.3f fps=%.2f ppc_ms=%.2f render_ms=%.2f snd_ms=%.2f\n",
+         game.name.c_str(), n, mean, p50, p99, fps, aPpc, aRen, aSnd);
+  printf("==============================================================\n");
+
+  if (!csvPath.empty())
+  {
+    FILE *fp = fopen(csvPath.c_str(), "w");
+    if (fp)
+    {
+      fprintf(fp, "frame,dt_us,ppc_ms,render_ms,sync_ms,snd_ms,drv_ms,frame_ms\n");
+      for (size_t i = 0; i < n; i++)
+      {
+        double us = double(deltaNs[i]) / 1000.0;
+        if (i < m)
+          fprintf(fp, "%zu,%.3f,%u,%u,%u,%u,%u,%u\n", i, us,
+                  ft[i].ppcTicks, ft[i].renderTicks, ft[i].syncTicks,
+                  ft[i].sndTicks, ft[i].drvTicks, ft[i].frameTicks);
+        else
+          fprintf(fp, "%zu,%.3f,,,,,,\n", i, us);
+      }
+      fclose(fp);
+      printf(" CSV written to: %s\n", csvPath.c_str());
+    }
+    else
+      printf(" WARNING: could not open CSV file: %s\n", csvPath.c_str());
+  }
+  fflush(stdout);
+}
+
+
