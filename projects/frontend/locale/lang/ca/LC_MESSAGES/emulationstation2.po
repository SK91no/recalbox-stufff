msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Cerca completada! {PROCESSED} jocs processats.\n"
"\n"
"{SUCCESS} joc(s) cercat(s) o actualitzat(s)\n"
"{NOTFOUND} joc(s) no trobat(s)...\n"
"{ERRORS} errors de sol·licitud/descàrrega\n"
"\n"
"{TEXTINFO} informació de text actualitzada\n"
"{IMAGES} imatges i {VIDEOS} vídeos descarregats\n"
"{MEDIASIZE} de multimèdia desat"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Heu arribat al límit diari de sol·licituds de cerca.\n"
"De totes maneres, s'han desat totes les cerques d'avui.\n"
"\n"
"Torneu a començar la cerca demà.\n"
"No oblideu seleccionar 'actualitza' i no 'cerca-ho tot'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"La partició share està gairebé plena.\n"
"El cercador s'ha aturat automàticament.\n"
"\n"
"Elimineu jocs, multimèdia i fitxers no utilitzats per fer espai abans de "
"tornar a executar el cercador!"

