msgstr "Oppretter RECALBOX-partisjon (FAT32, 6 GB)..."

msgid "Creating SHARE partition (exFAT)..."
msgstr "Oppretter SHARE-partisjon (exFAT)..."

msgid "Creating OVERLAY partition (ext4, 1 GB)..."
msgstr "Oppretter OVERLAY-partisjon (ext4, 1 GB)..."

msgid "Reloading partition table..."
msgstr "Lastar inn partisjonstabellen på nytt..."

msgid "Formatting RECALBOX partition (FAT32)..."
msgstr "Formaterer RECALBOX-partisjon (FAT32)..."

