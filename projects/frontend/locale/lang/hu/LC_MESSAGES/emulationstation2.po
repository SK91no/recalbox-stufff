msgid ""
"Choose the rate at which analog control values increase/decrease when "
"controlled by a key, between 1 to 100. Default is 25."
msgstr ""
"Válaszd ki azt az arányt, amellyel az analóg vezérlési értékek nőnek/"
"csökkennek, amikor billentyűvel vezérled, 1 és 100 között. Az "
"alapértelmezett érték 25."

msgid "Saturation"
msgstr "Telítettség"

msgid ""
"Choose the position at which the joystick is interpreted as being in its "
"most extreme position, between 0% to 200%. Default is 100%."
msgstr ""
"Válaszd ki azt a pozíciót, amelynél a botkormány a legszélsőségesebb "
"helyzetűnek van értelmezve, 0% és 200% között. Az alapértelmezett érték 100%."

msgid "Deadzone"
msgstr "Holtzóna"

msgid "Choose the dead zone as a percentage, between 0% to 99%. Default is 2%."
msgstr ""
"Válaszd ki a holtzónát százalékban, 0% és 99% között. Az alapértelmezett "
"érték 2%."

msgid "Supermodel Settings - Audio"
msgstr "Supermodel beállítások - Hang"

msgid "Sound volume"
msgstr "Hangerő"

msgid ""
"Choose the master volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Válaszd ki a fő hangerőt százalékban, 0% és 100% között. Az alapértelmezett "
"érték 100%."

msgid "Music volume"
msgstr "Zene hangereje"

msgid ""
"Choose the music volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Válaszd ki a zene hangerejét százalékban, 0% és 100% között. Az "
"alapértelmezett érték 100%."

msgid "Balance"
msgstr "Egyensúly"

msgid ""
"Choose the relative front/rear balance in percentage, between 0% to 100%. "
"Default is 0%."
msgstr ""
"Válaszd ki az elülső/hátulsó relatív egyensúlyt százalékban, 0% és 100% "
"között. Az alapértelmezett érték 0%."

msgid "Channels"
msgstr "Csatornák"

msgid "Choose the number of sound channels to use on host. Default is 2."
msgstr ""
"Válaszd ki a gazdagépen használt hangcsatornák számát. Az alapértelmezett "
"érték 2."

msgid "Flip stereo"
msgstr "Sztereó felcserélése"

msgid "Swap the left and right audio channels."
msgstr "Válaszd ki, ha fel akarod cserélni a bal és jobb hangcsatornát."

msgid "Sound"
msgstr "Hang"

msgid ""
"Choose if you disable sound board emulation sound effects. Default is "
"disabled."
msgstr ""
"Válaszd ki, ha le akarod tiltani a hangkártya-emuláció hangeffektjeit. "
"Alapértelmezetten letiltva."

msgid "No Digital Sound Board (DSB)"
msgstr "Digitális hangkártya nélkül (DSB)"

msgid "Enable or disable Digital Sound Board MPEG music. Default is disabled."
msgstr ""
"Válaszd ki a Digitális Hangkártya MPEG zenéjének engedélyezését vagy "
"letiltását. Alapértelmezetten letiltva."

msgid "Sound engine"
msgstr "Hangmotor"

msgid ""
"Choose between the legacy and new sound engines. Default is MAME engine."
msgstr ""
"Válassz a régi és az új hangmotorok között. Az alapértelmezett a MAME motor."

msgid "Supermodel Settings - Video"
msgstr "Supermodel beállítások - Videó"

msgid "Supersampling"
msgstr "Szupermintavételezés"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr ""
"Szupermintavételezés. Még nincs engedélyezve. Az alapértelmezett érték 1."

msgid "Upscale"
msgstr "Felskálázás"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr ""
"Válaszd ki a 2D réteg felskálázási szűrőmódját. Az alapértelmezett érték 0."

msgid "Disable no throttle"
msgstr "„Korlátlan sebesség” letiltása"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"Válaszd ki, ha engedélyezni vagy letiltani szeretnéd a 60Hz-es "
"képkockasebesség-zárolást. Alapértelmezetten letiltva."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr ""
"Válaszd ki a függőleges frissítési frekvencia zárolásához. Alapértelmezetten "
"engedélyezve."

msgid "True Hz"
msgstr "Valódi Hz"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr ""
"Válaszd ki a valódi Model 3 frissítési frekvencia (57,524 Hz) használatához. "
"Alapértelmezetten letiltva."

msgid "Crosshairs"
msgstr "Célkeresztek"

msgid "Show crosshairs. Default is disabled."
msgstr ""
"Válaszd ki, ha meg szeretnéd jeleníteni a célkereszteket. Alapértelmezetten "
"letiltva."

msgid "Multi texture"
msgstr "Több textúra"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr ""
"Válaszd ki, ha 8 textúratérképet szeretnél használni a dekódoláshoz. "
"Alapértelmezetten letiltva."

msgid "Quad rendering"
msgstr "Négyszög-renderelés"

msgid "Enable proper quad rendering. Default is disabled."
msgstr ""
"Válaszd ki, ha engedélyezni szeretnéd a megfelelő négyszög-renderelést. "
"Alapértelmezetten letiltva."

msgid "Supermodel Settings - Core"
msgstr "Supermodel beállítások - Mag"

msgid "GPU multi threading"
msgstr "GPU többszálú feldolgozás"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"Állítsa ON állásba, hogy a GPU saját szálon fusson a CPU szál megosztása "
"helyett. Gyorsabb, de a játéktól függően hibákat okozhat."

msgid "PPC Frequency"
msgstr "PPC frekvencia"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr ""
"Válaszd ki a PowerPC frekvenciáját MHz-ben, 1 és 1000 között. Az "
"alapértelmezett érték 70."

msgid "Service button"
msgstr "Szerviz gomb"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"Válaszd ki a szervizmenü engedélyezését vagy letiltását a játékokban (L3 = "
"teszt, R3 = szerviz). Alapértelmezetten engedélyezve."

msgid "Log level"
msgstr "Naplózási szint"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr ""
"Válaszd ki a naplófájlban szereplő információk szintjét. Az alapértelmezett "
"érték az információ."

msgid "Xemu Settings"
msgstr "Xemu beállítások"

msgid "Choose the internal resolution of the Xbox."
msgstr "Válaszd ki az Xbox belső felbontását."

msgid "Show menu bar"
msgstr "Menüsáv megjelenítése"

msgid "Show the menu bar."
msgstr "Válaszd ki, ha meg szeretnéd jeleníteni a menüsávot."

msgid "Skip boot animation"
msgstr "Indítási animáció kihagyása"

msgid "Skip the boot animation."
msgstr "Válaszd ki, ha ki szeretnéd hagyni az indítási animációt."

msgid "Show notifications"
msgstr "Értesítések megjelenítése"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "Megjeleníti a képernyő jobb felső sarkában látható értesítéseket."

msgid "Display mode"
msgstr "Megjelenítési mód"

msgid "Choose how the framebuffer should fit or scale."
msgstr "Válaszd ki, hogyan illeszkedjen vagy skálázódjon a framebuffer."

msgid "Aspect Ratio"
msgstr "Képarány"

msgid "Choose the aspect ratio of the Xbox."
msgstr "Válaszd ki az Xbox képarányát."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - EEPROM Általános beállítások"

msgid "Choose the region to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó régiót."

msgid "Video Standard"
msgstr "Videószabvány"

msgid "Choose the video standard to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó videószabványt."

msgid "Timezone"
msgstr "Időzóna"

msgid ""
"Choose the timezone to use on Xbox. If your country is using DST, don't take "
"it into account when you are setting this."
msgstr ""
"Válaszd ki az Xbox-on használandó időzónát. Ha az országodban van nyári "
"időszámítás, ne vedd figyelembe ennek beállításakor."

msgid "Disable automatic daylight saving time"
msgstr "Automatikus nyári időszámítás letiltása"

msgid "Choose if you want to disable automatic daylight saving time."
msgstr "Válaszd ki, ha le szeretnéd tiltani az automatikus nyári időszámítást."

msgid "DVD Region"
msgstr "DVD régió"

msgid "Choose the DVD region to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó DVD régiót."

msgid "Language"
msgstr "Nyelv"

msgid "Choose the language to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó nyelvet."

msgid "Xemu - EEPROM Video Settings"
msgstr "Xemu - EEPROM Videobeállítások"

msgid "Enable 480p resolution on Xbox."
msgstr "Válaszd ki a 480p felbontás engedélyezéséhez az Xbox-on."

msgid "720p"
msgstr "720p"

msgid "Enable 720p resolution on Xbox."
msgstr "Válaszd ki a 720p felbontás engedélyezéséhez az Xbox-on."

msgid "1080i"
msgstr "1080i"

msgid "Enable 1080i resolution on Xbox."
msgstr "Válaszd ki az 1080i felbontás engedélyezéséhez az Xbox-on."

msgid "Video Mode"
msgstr "Videó mód"

msgid "Choose the video mode to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó videó módot."

msgid "Refresh rate"
msgstr "Frissítési frekvencia"

msgid "Set the refresh rate to 60Hz on Xbox."
msgstr ""
"Válaszd ki a 60Hz-es frissítési frekvencia engedélyezéséhez az Xbox-on."

msgid "Xemu - EEPROM Audio Settings"
msgstr "Xemu - EEPROM Hangbeállítások"

msgid "Audio Output"
msgstr "Hangkimenet"

msgid "Choose the audio output to use on Xbox."
msgstr "Válaszd ki az Xbox-on használandó hangkimenetet."

msgid "AC3"
msgstr "AC3"

msgid "Enable Dolby Digital (AC3) on Xbox."
msgstr "Válaszd ki a Dolby Digital (AC3) engedélyezéséhez az Xbox-on."

msgid "DTS"
msgstr "DTS"

msgid "Enable Dolby Surround (DTS) on Xbox."
msgstr "Válaszd ki a Dolby Surround (DTS) engedélyezéséhez az Xbox-on."

msgid "SHUTDOWN RECALBOX"
msgstr "RECALBOX LEÁLLÍTÁSA"

msgid "FAST SHUTDOWN RECALBOX"
msgstr "RECALBOX GYORS LEÁLLÍTÁSA"

msgid "RESTART RECALBOX"
msgstr "RECALBOX ÚJRAINDÍTÁSA"

msgid "EDIT NETPLAY PASSWORDS"
msgstr "NETPLAY JELSZAVAK SZERKESZTÉSE"

msgid "PASSWORD #{INDEX}"
msgstr "JELSZÓ #{INDEX}"

msgid "SHARE USAGE"
msgstr "SHARE HASZNÁLAT"

msgid "SHARE PARTITION"
msgstr "SHARE PARTÍCIÓ"

msgid "Exit the password edition."
msgstr "Kilépés a jelszó szerkesztéséből."

msgid "AVAILABLE STORAGES"
msgstr "ELÉRHETŐ TÁROLÓK"

msgid ""
"Show a list of storage available on your system. Select a storage to access "
"extra information and available actions."
msgstr ""
"Megjeleníti a rendszereden elérhető tárolók listáját. Válassz egy tárolót a "
"további információk és elérhető műveletek eléréséhez."

msgid "Get information about {DEVICE.NAME}"
msgstr "Információk lekérése erről: {DEVICE.NAME}"

msgid "FREE SPACE"
msgstr "SZABAD TERÜLET"

msgid "Display free space available on the device"
msgstr "Megjeleníti az eszközön elérhető szabad területet"

msgid "STORAGE NAME"
msgstr "TÁROLÓ NEVE"

msgid "Display real device name"
msgstr "Megjeleníti a valódi eszköznevet"

msgid "NETWORK ACCESS"
msgstr "HÁLÓZATI HOZZÁFÉRÉS"

msgid "Access to this storage through your local network."
msgstr "Hozzáférés ehhez a tárolóhoz a helyi hálózaton keresztül."

msgid "FILE SYSTEM"
msgstr "FÁJLRENDSZER"

msgid "FileSystem"
msgstr "Fájlrendszer"

msgid "COMPATIBLE WITH RECALBOX?"
msgstr "KOMPATIBILIS A RECALBOX-SZAL?"

msgid "Show if this storage is compatible with recalbox"
msgstr "Megmutatja, hogy ez a tároló kompatibilis-e a recalbox-szal"

msgid "INSTALL RECALBOX ROM FOLDERS"
msgstr "RECALBOX ROM MAPPÁK TELEPÍTÉSE"

msgid "INITIALIZE!"
msgstr "INICIALIZÁLÁS!"

msgid ""
"Create rom structure so that this storage will be used by Recalbox on next "
"boots."
msgstr ""
"Létrehozza a rom struktúrát, hogy ezt a tárolót a Recalbox használja a "
"következő indításokkor."

msgid ""
"You cannot initialize this storage, because either it is already initialized "
"or it is not compatible."
msgstr ""
"Nem inicializálhatod ezt a tárolót, mert vagy már inicializálva van, vagy "
"nem kompatibilis."

msgid ""
"Select your language. A reboot is required to set this configuration active."
msgstr ""
"Válaszd ki a nyelvedet. Ennek a beállításnak az aktiválásához újraindítás "
"szükséges."

msgid "TIMEZONE"
msgstr "IDŐZÓNA"

msgid ""
"Select the timezone used to display dates and times in their local format."
msgstr ""
"Lehetővé teszi az időzóna kiválasztását a dátumok és idők helyi formátumban "
"történő megjelenítéséhez."

msgid "Shows available update version."
msgstr "Megjeleníti az elérhető frissítés verzióját."

msgid "CHECK UPDATES PERIODICALLY"
msgstr "FRISSÍTÉSEK IDŐSZAKOS ELLENŐRZÉSE"

msgid ""
"Automatically check if an update is available. If so, it notifies you with a "
"message."
msgstr ""
"Automatikusan ellenőrzi, hogy elérhető-e frissítés. Ha igen, üzenettel "
"értesít."

msgid "Select update type"
msgstr "Válaszd ki a frissítés típusát"

msgid "CHECK"
msgstr "ELLENŐRZÉS"

msgid "Check if an update is available, right now."
msgstr "Ellenőrizd most azonnal, hogy elérhető-e frissítés."

msgid "SHOW NEW VERSION CHANGELOG"
msgstr "ÚJ VERZIÓ VÁLTOZÁSNAPLÓJÁNAK MEGJELENÍTÉSE"

msgid "SHOW"
msgstr "MEGJELENÍTÉS"

msgid "Shows available update changelog."
msgstr "Megjeleníti az elérhető frissítés változásnaplóját."

msgid "DOWNLOAD AND UPDATE MY RECALBOX"
msgstr "RECALBOX LETÖLTÉSE ÉS FRISSÍTÉSE"

msgid "GO!"
msgstr "MEHET!"

msgid "No update available yet."
msgstr "Még nincs elérhető frissítés."

msgid "RECALBOX RGB DUAL SETTINGS"
msgstr "RECALBOX RGB DUAL BEÁLLÍTÁSOK"

msgid ""
"Select Recalbox's interface resolution. 480i is recommended for better "
"details."
msgstr ""
"Válaszd ki a Recalbox felület felbontását. A jobb részletek érdekében a 480i "
"ajánlott."

msgid "AVOID INTERLACED MODES"
msgstr "INTERLACE MÓDOK ELKERÜLÉSE"

msgid "Avoid interlaced mode for all games."
msgstr "Interlace mód elkerülése minden játéknál."

msgid "AVOID INTERLACED MODES FOR TATE GAMES ON YOKO AND HANDHELDS"
msgstr "INTERLACE MÓDOK ELKERÜLÉSE TATE JÁTÉKOKNÁL YOKO ÉS KÉZI KONZOLOKON"

msgid "31 KHZ"
msgstr "31 KHZ"

msgid "You're not in 31khz mode"
msgstr "Nem 31kHz módban vagy"

msgid "RUN DEMOS AND AUTOBOOT GAMES IN 240P@120"
msgstr "DEMÓK ÉS AUTOMATIKUSAN INDÍTOTT JÁTÉKOK FUTTATÁSA 240P@120 MÓDBAN"

msgid ""
"Run the demos and autoboot games in 240p resolution on your 31kHz monitor."
msgstr ""
"Futtasd a demókat és az automatikusan induló játékokat 240p felbontásban a "
"31kHz-es monitorodon."

msgid "EXPERIMENTAL"
msgstr "KÍSÉRLETI"

msgid "RECALBOX RGB JAMMA SETTINGS"
msgstr "RECALBOX RGB JAMMA BEÁLLÍTÁSOK"

msgid "Recalbox RGB Jamma options and configuration."
msgstr "Recalbox RGB Jamma opciók és beállítások."

msgid ""
"Avoid interlaced mode for tate (vertical) games on yoko (horizontal) "
"screens, and for handheld consoles."
msgstr ""
"Interlace mód elkerülése tate (függőleges) játékoknál yoko (vízszintes) "
"képernyőkön, valamint kézi konzoloknál."

msgid "JAMMA OPTIONS"
msgstr "JAMMA OPCIÓK"

msgid "START + UP and DOWN change the volume in frontend and in games."
msgstr ""
"A START + FEL és LE megváltoztatja a hangerőt a frontendben és a játékokban."

msgid "Load the dual joystick configuration on compatible games!"
msgstr "Töltsd be a kettős botkormány konfigurációt kompatibilis játékokon!"

msgid "Reset all previous options to their default values"
msgstr "Az összes korábbi opció visszaállítása az alapértelmezett értékekre"

msgid "RECALBOX RGB DUAL 2 SETTINGS"
msgstr "RECALBOX RGB DUAL 2 BEÁLLÍTÁSOK"

msgid "Recalbox RGB Dual 2 options and configuration."
msgstr "Recalbox RGB Dual 2 opciók és beállítások."

msgid "Select Recalbox's interface resolution."
msgstr "Válaszd ki a Recalbox felület felbontását."

msgid "FORCE COMPOSITE"
msgstr "KOMPOZIT KÉNYSZERÍTÉSE"

msgid "Force composite output (On SCART, RCA and JACK)."
msgstr "Kompozit kimenet kényszerítése (SCART, RCA és JACK csatlakozókon)."

msgid "COMPOSITE SIGNAL STANDARD"
msgstr "KOMPOZIT JELSZABVÁNY"

msgid ""
"When using composite, selects the composite signal standard for your region."
msgstr ""
"Kompozit használatakor válaszd ki a régiódnak megfelelő kompozit "
"jelszabványt."

msgid "16/9 CRT TV"
msgstr "16/9 CRT TV"

msgid "Activate if you have a 16/9 CRT TV."
msgstr "Aktiváld, ha 16/9-es CRT TV-vel rendelkezel."

msgid "SELECT SIGNAL (RGB/COMPOSITE) AT LAUNCH"
msgstr "JEL KIVÁLASZTÁSA (RGB/KOMPOZIT) INDÍTÁSKOR"

msgid ""
"Let you choose between RGB Signal and composite signal at launch, for "
"compatible systems."
msgstr ""
"Lehetővé teszi, hogy indításkor válassz az RGB jel és a kompozit jel között "
"kompatibilis rendszereknél."

msgid "DIP SWITCHES"
msgstr "DIP KAPCSOLÓK"

msgid "FORCED 50HZ DIP SWITCH"
msgstr "KÉNYSZERÍTETT 50HZ DIP KAPCSOLÓ"

msgid "FORCED 31kHz/MULTISYNC DIP SWITCH"
msgstr "KÉNYSZERÍTETT 31kHz/MULTISYNC DIP KAPCSOLÓ"

msgid "FORCED COMPOSITE DIP SWITCH"
msgstr "KÉNYSZERÍTETT KOMPOZIT DIP KAPCSOLÓ"

msgid "IN-GAME SETTINGS"
msgstr "JÁTÉKON BELÜLI BEÁLLÍTÁSOK"

msgid "FEATURES"
msgstr "FUNKCIÓK"

msgid "GAMES RENDERING"
msgstr "JÁTÉKOK MEGJELENÍTÉSE"

msgid "AUTO BLITTER (FBNEO/MAME)"
msgstr "AUTOMATIKUS BLITTER (FBNEO/MAME)"

msgid ""
"Enables automatic blitter and CPU settings for fbneo and mame games. Can "
"enhance emulation precision on games like Cave."
msgstr ""
"Engedélyezi az automatikus blitter és CPU beállításokat az fbneo és mame "
"játékokhoz. Növelheti az emuláció pontosságát olyan játékoknál, mint a Cave."

msgid "SYSTEM-LISTS & GAMELISTS SETTINGS"
msgstr "RENDSZERLISTA ÉS JÁTÉKLISTA BEÁLLÍTÁSOK"

msgid "Configure system and gamelist filters and options"
msgstr "Rendszer- és játéklista szűrők és opciók beállítása"

msgid "SYSTEM LISTS"
msgstr "RENDSZERLISTÁK"

msgid "SHOW SYSTEMS"
msgstr "RENDSZEREK MEGJELENÍTÉSE"

msgid "Show or hide systems individually"
msgstr "Rendszerek egyenkénti megjelenítése vagy elrejtése"

msgid "GAMES"
msgstr "JÁTÉKOK"

msgid "ENABLE ADDING/REMOVING FAVORITES"
msgstr "KEDVENCEK HOZZÁADÁSÁNAK/ELTÁVOLÍTÁSÁNAK ENGEDÉLYEZÉSE"

msgid ""
"Enable or disable adding/removing favorites in gamelist, search and other "
"various places."
msgstr ""
"Kedvencek hozzáadásának/eltávolításának engedélyezése vagy letiltása a "
"játéklistában, keresésben és más helyeken."

msgid ""
"Show only favorites. May hide all systems with no favorite at all until you "
"switch off this option."
msgstr ""
"Csak a kedvencek megjelenítése. Elrejtheti az összes olyan rendszert, "
"amelynek nincs kedvence, amíg ki nem kapcsolod ezt az opciót."

msgid "Display all favorites at the top of the game list."
msgstr "Az összes kedvenc megjelenítése a játéklista tetején."

msgid "Force hidden game to show in gamelists."
msgstr "Elrejtett játékok kényszerített megjelenítése a játéklistákban."

msgid "SHOW MAHJONG AND CASINO GAMES"
msgstr "MAHJONG ÉS KASZINÓJÁTÉKOK MEGJELENÍTÉSE"

msgid ""
"Show or hide asian casino and mahjong games. You must scrape your game for "
"this option to work."
msgstr ""
"Ázsiai kaszinó- és mahjong játékok megjelenítése vagy elrejtése. A funkció "
"működéséhez le kell kérned a játékadatokat (scrape)."

msgid "SHOW ADULT GAMES"
msgstr "FELNŐTT JÁTÉKOK MEGJELENÍTÉSE"

msgid ""
"Show or hide adult games. You must scrape your game for this option to work."
msgstr ""
"Felnőtt játékok megjelenítése vagy elrejtése. A funkció működéséhez le kell "
"kérned a játékadatokat (scrape)."

msgid "SHOW PREINSTALLED GAMES"
msgstr "ELŐRE TELEPÍTETT JÁTÉKOK MEGJELENÍTÉSE"

msgid ""
"Show or hide games distributed with Recalbox. But you don't want to do this: "
"they are all excellent games!"
msgstr ""
"A Recalbox-szal terjesztett játékok megjelenítése vagy elrejtése. De ezt "
"igazán nem akarod megtenni: mindegyik kiváló játék!"

msgid "Show only games playable with 3 or more players"
msgstr "Csak a 3 vagy több játékossal játszható játékok megjelenítése"

msgid "SHOW ONLY YOKO (HORIZONTAL) GAMES"
msgstr "CSAK YOKO (VÍZSZINTES) JÁTÉKOK MEGJELENÍTÉSE"

msgid ""
"Show only YOKO (horizontal) games. Mutually exclusive with the option to "
"show only TATE games."
msgstr ""
"Csak YOKO (vízszintes) játékok megjelenítése. Kölcsönösen kizárja a csak "
"TATE játékok megjelenítése opciót."

msgid "SHOW ONLY TATE (VERTICAL) GAMES"
msgstr "CSAK TATE (FÜGGŐLEGES) JÁTÉKOK MEGJELENÍTÉSE"

msgid ""
"Show only TATE (vertical) games. Mutually exclusive with the option to show "
"only YOKO games."
msgstr ""
"Csak TATE (függőleges) játékok megjelenítése. Kölcsönösen kizárja a csak "
"YOKO játékok megjelenítése opciót."

msgid "SHOW ROMS MARKED AS NON-GAMES"
msgstr "NEM JÁTÉKKÉNT MEGJELÖLT ROMOK MEGJELENÍTÉSE"

msgid ""
"Show or hide roms that are explicitly marked as non-game (application, "
"utilities, ...). You must scrape your game for this option to work."
msgstr ""
"A kifejezetten nem játékként megjelölt romok (alkalmazások, "
"segédprogramok, ...) megjelenítése vagy elrejtése. A funkció működéséhez le "
"kell kérned a játékadatokat (scrape)."

msgid "ENABLE ONE GAME ONE ROM (1G1R)"
msgstr "EGY JÁTÉK EGY ROM (1G1R) ENGEDÉLYEZÉSE"

msgid "Display only one rom|disk image for a game from your preferred region."
msgstr ""
"Csak egy rom|lemezkép megjelenítése egy játékhoz a preferált régiódból."

msgid "PRIORITY REGION (1G1R)"
msgstr "ELSŐBBSÉGI RÉGIÓ (1G1R)"

msgid "Choose your preferred region for 1G1R filtering."
msgstr "Válaszd ki a preferált régiót az 1G1R szűréshez"

msgid "SECOND PRIORITY REGION (1G1R)"
msgstr "MÁSODIK ELSŐBBSÉGI RÉGIÓ (1G1R)"

msgid "Choose your second preferred region for 1G1R filtering."
msgstr "Válaszd ki a második preferált régiót az 1G1R szűréshez"

msgid "THIRD PRIORITY REGIONS (1G1R)"
msgstr "HARMADIK ELSŐBBSÉGI RÉGIÓK (1G1R)"

msgid ""
"Choose your preferred regions priority when there is no match with first and "
"second regions"
msgstr ""
"Válaszd ki a preferált régiók sorrendjét arra az esetre, ha nincs egyezés az "
"első és második régióval"

msgid "ARCADE SYSTEMS"
msgstr "ARCADE RENDSZEREK"

msgid "ENABLE AGGREGATED ARCADE SYSTEM"
msgstr "ÖSSZESÍTETT ARCADE RENDSZER ENGEDÉLYEZÉSE"

msgid "Available only when aggregated arcade system is on"
msgstr ""
"Csak akkor elérhető, ha az összesített arcade rendszer be van kapcsolva"

msgid ""
"Select manufacturer virtual system to show in the system view (like "
"CPS1/2/3, SEGA, TAITO, ...)"
msgstr ""
"Válaszd ki a rendszernézetben megjelenítendő gyártói virtuális rendszereket "
"(mint CPS1/2/3, SEGA, TAITO, ...)"

msgid "ARCADE GAMES"
msgstr "ARCADE JÁTÉKOK"

msgid ""
"Always use arcade names from official databases. Overwrites manual edits and "
"scraper results."
msgstr ""
"Mindig a hivatalos adatbázisokból származó arcade neveket használja. "
"Felülírja a manuális szerkesztést és a scraper eredményeit."

msgid "USER INTERFACE SETTINGS"
msgstr "FELHASZNÁLÓI FELÜLET BEÁLLÍTÁSAI"

msgid "SYSTEMS TO SHOW IN DEMO/GAMECLIP"
msgstr "DEMÓ/JÁTÉKKLIPBEN MEGJELENÍTENDŐ RENDSZEREK"

msgid "Adjust the screen brightness"
msgstr "Képernyő fényerejének beállítása"

msgid "Change the look of your Recalbox!"
msgstr "Változtasd meg a Recalbox kinézetét!"

msgid "DEFAULT TRANSITION STYLE"
msgstr "ALAPÉRTELMEZETT ÁTMENET STÍLUS"

msgid ""
"Select the type of transition between system. INSTANT will do nothing, FADE "
"will fade to dark, and SLIDE will slide the entire screen"
msgstr ""
"Válaszd ki a rendszerek közötti átmenet típusát. Az INSTANT nem csinál "
"semmit, a FADE elsötétítéssel tűnik el, a SLIDE pedig az egész képernyőt "
"elcsúsztatja"

msgid "Select {THEME.OPTION.NAME}"
msgstr "Válaszd ki: {THEME.OPTION.NAME}"

msgid "GAME LAUNCH TRANSITION STYLE"
msgstr "JÁTÉKINDÍTÁS ÁTMENET STÍLUSA"

msgid ""
"Select the type of transition when you launch a game. INSTANT will do "
"nothing, FADE will fade to dark, and SLIDE will zoom in on the game cover."
msgstr ""
"Válaszd ki az átmenet típusát játékindításkor. Az INSTANT nem csinál semmit, "
"a FADE elsötétítéssel tűnik el, a SLIDE pedig ráközelít a játék borítójára."

msgid "ENABLE FAST MOVE IN GAMELIST"
msgstr "GYORS MOZGÁS ENGEDÉLYEZÉSE A JÁTÉKLISTÁBAN"

msgid ""
"When enabled, holding up or down for a few seconds makes the list scroll "
"very fast."
msgstr ""
"Ha engedélyezve van, a FEL/LE gomb néhány másodpercig tartása nagyon gyorsan "
"görgeti a listát"

msgid "Display the current time in a corner of the screen."
msgstr "Az aktuális idő megjelenítése a képernyő egyik sarkában."

msgid "SHOW MUSIC POPUPS"
msgstr "ZENEI FELUGRÓ ABLAKOK MEGJELENÍTÉSE"

msgid "When enabled, show music information every time a new music starts."
msgstr ""
"Ha engedélyezve van, megjeleníti a zenei információkat minden alkalommal, "
"amikor új zene indul."

msgid "SHOW NETPLAY POPUPS"
msgstr "NETPLAY FELUGRÓ ABLAKOK MEGJELENÍTÉSE"

msgid ""
"When enabled, show netplay information every time a user starts a new game "
"over internet."
msgstr ""
"Ha engedélyezve van, megjeleníti a netplay információkat minden alkalommal, "
"amikor egy felhasználó új játékot indít az interneten keresztül."

msgid "CONTROLLER SETTINGS"
msgstr "KONTROLLER BEÁLLÍTÁSOK"

msgid "Add and configure all your controllers."
msgstr "Add hozzá és állítsd be az összes kontrollerdet."

msgid "WIFI"
msgstr "WIFI"

msgid "CONNECT AUTOMATICALLY"
msgstr "AUTOMATIKUS CSATLAKOZÁS"

msgid ""
"Automatically connect on startup if the WIFI network is available and "
"properly configured!"
msgstr ""
"Automatikus csatlakozás induláskor, ha a WIFI hálózat elérhető és "
"megfelelően van beállítva!"

msgid "WIFI is disabled!"
msgstr "A WIFI le van tiltva!"

msgid "SELECT SSID"
msgstr "SSID KIVÁLASZTÁSA"

msgid "Select an available SSID."
msgstr "Válassz egy elérhető SSID-t."

msgid "If your Internet box has a WPS system, activate it and then click here!"
msgstr ""
"Ha az internetes routerednek van WPS rendszere, aktiváld azt, majd kattints "
"ide!"

msgid ""
"Run the scraper! The operation may take a while, however you can make it a "
"background task and keep using Recalbox."
msgstr ""
"Futtasd a scrapert! A művelet eltarthat egy ideig, de háttérfeladattá "
"teheted, és közben tovább használhatod a Recalboxot."

msgid "PATRON OPTIONS"
msgstr "PATRON OPCIÓK"

msgid "user name for the selected scraper"
msgstr "felhasználónév a kiválasztott scraperhez"

msgid "password for the selected scraper"
msgstr "jelszó a kiválasztott scraperhez"

msgid "Download various free games and free contents!"
msgstr "Töltsd le a különféle ingyenes játékokat és ingyenes tartalmakat!"

msgid "Download games for {SYSTEM.NAME}"
msgstr "Játékok letöltése ehhez: {SYSTEM.NAME}"

msgid ""
"Download a pack of free games, game demos and homebrew for {SYSTEM.NAME}"
msgstr ""
"Ingyenes játékok, játékdemók és homebrew csomag letöltése ehhez: {SYSTEM."
"NAME}"

msgid "No content available yet for {SYSTEM.NAME}!"
msgstr "Még nincs elérhető tartalom ehhez: {SYSTEM.NAME}!"

msgid "ACTIVATE DEBUG/VERBOSE LOGS"
msgstr "DEBUG/RÉSZLETES NAPLÓK AKTIVÁLÁSA"

msgid "Activate debug and verbose logs in Recalbox and Emulators."
msgstr ""
"Debug és részletes naplók aktiválása a Recalboxban és az emulátorokban."

msgid "You cannot set up Kodi on boot when Kodi is disabled."
msgstr "Nem állíthatod be a Kodi indítását, ha a Kodi le van tiltva."

msgid "DO NOT SCAN NEW GAMES"
msgstr "NE KERESSEN ÚJ JÁTÉKOKAT"

msgid ""
"Formerly called 'GAMELIST ONLY', it can greatly speed up boot time by not "
"scanning new files. Use it if your romsets are rarely updated."
msgstr ""
"Korábban 'CSAK JÁTÉKLISTA' néven volt ismert, jelentősen felgyorsíthatja az "
"indítási időt azáltal, hogy nem keres új fájlokat. Használd, ha a "
"romkészleteid ritkán frissülnek."

msgid "ALLOW BOOT ON GAME"
msgstr "JÁTÉKRA INDÍTÁS ENGEDÉLYEZÉSE"

msgid ""
"When activated, Recalbox boots into the gamelist and does not allow moving "
"back to the system list."
msgstr ""
"Ha aktiválva van, a Recalbox a játéklistára indul, és nem teszi lehetővé a "
"rendszerlistára való visszalépést."

msgid "SYSTEM SPECIFIC RESOLUTIONS"
msgstr "RENDSZERSPECIFIKUS FELBONTÁSOK"

msgid "FOR {SYSTEM.NAME}"
msgstr "EHHEZ: {SYSTEM.NAME}"

msgid "Select the resolution used by the emulator '{SYSTEM.NAME}'."
msgstr "Válaszd ki a(z) '{SYSTEM.NAME}' emulátor által használt felbontást."

msgid "Set options for system {SYSTEM.NAME}"
msgstr "Opciók beállítása a(z) {SYSTEM.NAME} rendszerhez"

msgid "Set the way you want to use Kodi mediaplayer."
msgstr "Állítsd be, hogyan szeretnéd használni a Kodi médialejátszót."

msgid "RUN KODI ON STARTUP"
msgstr "KODI INDÍTÁSA A RENDSZER INDÍTÁSAKOR"

msgid "START KODI WITH X BUTTON"
msgstr "KODI INDÍTÁSA AZ X GOMBBAL"

msgid "Run your own scripts in shell or python"
msgstr "Futtasd saját szkriptjeidet shellben vagy pythonban"

msgid "Run custom script {SCRIPT.NAME}"
msgstr "Egyéni szkript futtatása: {SCRIPT.NAME}"

msgid "ENABLE WEB MANAGER"
msgstr "WEBES KEZELŐFELÜLET ENGEDÉLYEZÉSE"

msgid "RESET EMULATOR SETTINGS"
msgstr "EMULÁTOR BEÁLLÍTÁSOK VISSZAÁLLÍTÁSA"

msgid "RESET!"
msgstr "VISSZAÁLLÍTÁS!"

msgid ""
"This option resets all emulator settings to their factory defaults. It does "
"not affect any Recalbox setting."
msgstr ""
"Ez az opció az összes emulátor beállítást visszaállítja a gyári "
"alapértelmezettre. Nincs hatással a Recalbox beállításaira."

msgid "HARDWARE"
msgstr "HARDVER"

msgid "UPDATE!"
msgstr "FRISSÍTÉS!"

msgid "Update Pi4 / Pi400 or Pi5 bootloader if required."
msgstr "Szükség esetén frissítsd a Pi4 / Pi400 vagy Pi5 rendszerbetöltőjét."

msgid "Recalbox does not support overclocking for your board."
msgstr "A Recalbox nem támogatja a túlhajtást ehhez a kártyához."

msgid "CONTEXTUAL OPTIONS"
msgstr "KONTEXTUÁLIS OPCIÓK"

msgid "EDIT GAME {GAME.NAME}"
msgstr "JÁTÉK SZERKESZTÉSE: {GAME.NAME}"

msgid "Show options related to {GAME.NAME} and allow editing game metadata."
msgstr ""
"Megjeleníti a(z) {GAME.NAME} játékhoz kapcsolódó opciókat, és lehetővé teszi "
"a játék metaadatainak szerkesztését."

msgid ""
"You cannot edit this game because it is a pre-installed game or it is stored "
"on a read-only device"
msgstr ""
"Nem szerkesztheted ezt a játékot, mert előre telepített játék, vagy csak "
"olvasható eszközön van tárolva"

msgid "Select the emulator to use to run {GAME.NAME}"
msgstr "Válaszd ki a(z) {GAME.NAME} futtatásához használt emulátort"

msgid "SET PATCH"
msgstr "PATCH BEÁLLÍTÁSA"

msgid "Select patch to use when running an emulator supporting softpatching."
msgstr ""
"Válaszd ki a használandó patchet, amikor softpatchingot támogató emulátort "
"futtatsz."

msgid ""
"Either the game has no patch or the emulator selected to run this game is "
"not supporting softpatching."
msgstr ""
"Vagy nincs patch a játékhoz, vagy a játék futtatásához kiválasztott emulátor "
"nem támogatja a softpatchingot."

msgid "Sets the name of the game or folder."
msgstr "Beállítja a játék vagy mappa nevét."

msgid "Set this game as favorite or not."
msgstr "Állítsd be, hogy ez a játék kedvenc legyen-e vagy sem."

msgid "Editing favorites is not enabled."
msgstr "A kedvencek szerkesztése nincs engedélyezve."

msgid "Hide or show this game."
msgstr "Ennek a játéknak az elrejtése vagy megjelenítése."

msgid "Defines this game as an adult game or not."
msgstr "Meghatározza, hogy ez a játék felnőtt játék-e vagy sem."

msgid "Scraping"
msgstr "Scraping"

msgid "Scrape this game and fill in all metadata at once!"
msgstr ""
"Kérd le ennek a játéknak az adatait, és töltsd ki egyszerre az összes "
"metaadatot!"

msgid "Statistics"
msgstr "Statisztikák"

msgid "Show the total time you played this game"
msgstr "Az ezzel a játékkal töltött összes idő megjelenítése"

msgid "PLAY COUNT"
msgstr "JÁTÉKOK SZÁMA"

msgid "Show the number of times you played this game"
msgstr "Megjeleníti, hányszor játszottál ezzel a játékkal"

msgid "Show the last date/time you played this game"
msgstr "Megjeleníti, mikor játszottál utoljára ezzel a játékkal"

msgid "DELETE GAME {GAME.NAME}"
msgstr "JÁTÉK TÖRLÉSE: {GAME.NAME}"

msgid "DELETE {ICON.WARNING}"
msgstr "TÖRLÉS {ICON.WARNING}"

msgid ""
"Delete game or screenshot physically on the storage. Allow keeping save, "
"metadata and other related files individually."
msgstr ""
"Törli a játékot vagy a képernyőképet fizikailag a tárhelyről. Lehetővé teszi "
"a mentések, metaadatok és egyéb kapcsolódó fájlok egyenkénti megtartását."

msgid ""
"You cannot delete this game because it is a pre-installed game or it is "
"stored on a read-only device or it is a folder."
msgstr ""
"Nem törölheted ezt a játékot, mert előre telepített játék, csak olvasható "
"eszközön van tárolva, vagy mappa."

msgid ""
"Boot on game is not enabled. To set a game to boot on, enable the "
"appropriate option first."
msgstr ""
"A játékra indítás nincs engedélyezve. Ahhoz, hogy egy játékot beállíts "
"indításra, előbb engedélyezd a megfelelő opciót."

msgid "RUN SAVE STATE"
msgstr "MENTETT ÁLLAPOT FUTTATÁSA"

msgid "Select, restore and run game in the selected save state."
msgstr ""
"Válaszd ki, állítsd vissza és futtasd a játékot a kiválasztott mentett "
"állapotból."

msgid ""
"No save state has been detected for the currently selected game, or the "
"currently selected item is not a game."
msgstr ""
"Nem található mentett állapot a jelenleg kiválasztott játékhoz, vagy a "
"kiválasztott elem nem játék."

msgid "JUMP"
msgstr "UGRÁS"

msgid "Open the Quick Jump selector."
msgstr "Megnyitja a gyorsugrás választót."

msgid "This option allows you to search for other versions of a game."
msgstr "Ez a beállítás lehetővé teszi a játék más verzióinak keresését."

msgid "This option allows you to search for other games with the same licence."
msgstr ""
"Ez a beállítás lehetővé teszi az azonos licenccel rendelkező más játékok "
"keresését."

msgid ""
"Select the way the game list is sorted (alphabetically, by rating, ...)."
msgstr ""
"Válaszd ki a játéklista rendezési módját (ábécé szerint, értékelés szerint "
"stb.)."

msgid "This list has a natural order and can't be sorted."
msgstr "Ennek a listának természetes sorrendje van, és nem rendezhető."

msgid ""
"Select what kind of information you want to see on the right of your "
"gamelist: regions flags, players or game genre."
msgstr ""
"Válaszd ki, milyen információt szeretnél látni a játéklista jobb oldalán: "
"régiózászlók, játékosok száma vagy a játék műfaja."

msgid "FLATTEN FOLDERS"
msgstr "MAPPÁK KILAPÍTÁSA"

msgid "This system is either always flattened or cannot be flattened!"
msgstr "Ez a rendszer mindig ki van lapítva, vagy egyáltalán nem lapítható ki!"

msgid "You can't hide favorites in the Favorite system!"
msgstr "Nem rejtheted el a kedvenceket a Kedvencek rendszerben!"

msgid "Display favorites at the top of gamelists."
msgstr "Kedvencek megjelenítése a játéklisták tetején."

msgid "Favorites are always first in the Favorite system!"
msgstr "A kedvencek mindig elsők a Kedvencek rendszerben!"

msgid "Virtual systems cannot be updated. Update real systems instead."
msgstr ""
"A virtuális rendszerek nem frissíthetők. Frissítsd inkább a valódi "
"rendszereket."

msgid "Advanced system settings"
msgstr "Speciális rendszerbeállítások"

msgid "Set advanced settings for system {SYSTEM.NAME}"
msgstr "Speciális beállítások megadása a(z) {SYSTEM.NAME} rendszerhez"

msgid "DELETE {GAME.NAME}"
msgstr "{GAME.NAME} TÖRLÉSE"

msgid "GAME FILES (ROM, DISK IMAGE, TAPE, ...)"
msgstr "JÁTÉKFÁJLOK (ROM, LEMEZKÉP, SZALAG, ...)"

msgid "Number of game files that are to be deleted."
msgstr "A törlendő játékfájlok száma."

msgid ""
"Number of media files (images, video, ...) that will be deleted along with "
"game files."
msgstr ""
"A médiafájlok száma (képek, videók, ...), amelyek a játékfájlokkal együtt "
"törlődnek."

msgid "There is no media file associated with this game"
msgstr "Nincs médiafájl társítva ehhez a játékhoz"

msgid ""
"Number of extra files associated with this game: configurations, overrides, "
"patches, ..."
msgstr ""
"Az ehhez a játékhoz társított extra fájlok száma: konfigurációk, "
"felülbírálások, javítások, ..."

msgid "There is no extra file associated with this game"
msgstr "Nincs extra fájl társítva ehhez a játékhoz"

msgid "Number of save games and save states of {GAME.NAME}"
msgstr "A(z) {GAME.NAME} mentett játékainak és mentési állapotainak száma"

msgid "There is no save game or save state for this game"
msgstr "Nincs mentett játék vagy mentési állapot ehhez a játékhoz"

msgid "Select files to delete one by one."
msgstr "Válaszd ki egyenként a törlendő fájlokat."

msgid "Select game files that are to be deleted one by one."
msgstr "Válaszd ki egyenként a törlendő játékfájlokat."

msgid ""
"Select media files (images, video, ...) that will be deleted along with game "
"files."
msgstr ""
"Válaszd ki a médiafájlokat (képek, videók, ...), amelyek a játékfájlokkal "
"együtt törlődnek."

msgid "Select extra files to delete: configurations, overrides, patches, ..."
msgstr ""
"Válaszd ki a törlendő extra fájlokat: konfigurációk, felülbírálások, "
"javítások, ..."

msgid "Select save games and save states of {GAME.NAME} to delete"
msgstr ""
"Válaszd ki a törlendő mentett játékokat és mentési állapotokat a(z) {GAME."
"NAME} játékhoz"

msgid "Delete all files selected below"
msgstr "Az alább kiválasztott összes fájl törlése"

msgid "Cancel operation. Do not delete anything"
msgstr "Művelet megszakítása. Ne törölj semmit"

msgid "Delete all files listed below"
msgstr "Az alább felsorolt összes fájl törlése"

msgid "SOFTPATCHING {GAME.NAME}"
msgstr "{GAME.NAME} SOFT PATCHELÉSE"

msgid "ORIGINAL GAME"
msgstr "EREDETI JÁTÉK"

msgid "PATCHED GAME"
msgstr "JAVÍTOTT JÁTÉK"

msgid "SELECT PATCH TO APPLY"
msgstr "VÁLASSZ ALKALMAZANDÓ JAVÍTÁST"

msgid "Select the patch to apply."
msgstr "Válaszd ki az alkalmazandó javítást"

msgid "INITIATE {GAME.NAME} NETPLAY GAME"
msgstr "{GAME.NAME} NETPLAY JÁTÉK INDÍTÁSA"

msgid "Launch the game and wait for other player to join"
msgstr "Indítsd el a játékot, és várj, hogy egy másik játékos csatlakozzon"

msgid "Select password other player will have to use to join the game"
msgstr ""
"Válaszd ki a jelszót, amelyet a másik játékosnak használnia kell a "
"csatlakozáshoz"

msgid "CHOOSE VIEWER PASSWORD"
msgstr "VÁLASSZ NÉZŐI JELSZÓT"

msgid "Select password other player will have to use to watch the game"
msgstr ""
"Válaszd ki a jelszót, amelyet a másik játékosnak használnia kell a játék "
"megtekintéséhez"

msgid "Do not initiate this game."
msgstr "Ne indítsd el ezt a játékot."

msgid "JOIN {GAME.NAME} NETPLAY GAME"
msgstr "CSATLAKOZÁS A(Z) {GAME.NAME} NETPLAY JÁTÉKHOZ"

msgid "JOIN AS PLAYER"
msgstr "CSATLAKOZÁS JÁTÉKOSKÉNT"

msgid "JOIN"
msgstr "CSATLAKOZÁS"

msgid "Join the game as a player."
msgstr "Csatlakozz a játékhoz játékosként."

msgid "WATCH"
msgstr "MEGTEKINTÉS"

msgid "Join the game as a viewer. You can watch the game, but not participate."
msgstr ""
"Csatlakozz a játékhoz nézőként. Megtekintheted a játékot, de nem vehetsz "
"részt benne."

msgid "USE PASSWORD"
msgstr "JELSZÓ HASZNÁLATA"

msgid "Use the selected password to join the game."
msgstr "Használd a kiválasztott jelszót a játékhoz való csatlakozáshoz."

msgid "Do not join this game."
msgstr "Ne csatlakozz ehhez a játékhoz."

msgid "{0} free of {1}"
msgstr "{0} szabad {1}-ból"

msgid "{0} FREE"
msgstr "{0} SZABAD"

msgid "No vulkan driver is available on your hardware."
msgstr "Nincs elérhető Vulkan illesztőprogram a hardvereden."

msgid "Enable rumble with compatible controllers."
msgstr "Rezgés engedélyezése kompatibilis kontrollerekkel."

msgid "EDIT FOLDER {GAME.NAME}"
msgstr "{GAME.NAME} MAPPA SZERKESZTÉSE"

msgid "%i MINUTE"
msgid_plural "%i MINUTES"
msgstr[0] "%i PERC"
msgstr[1] "%i PERC"

msgid "%i TIME"
msgid_plural "%i TIMES"
msgstr[0] "%i ALKALOM"
msgstr[1] "%i ALKALOM"

msgid ""
"Show only the very latest version of a given game, hiding all previous "
"versions/releases. Particularly useful in TOSEC romsets."
msgstr ""
"Csak az adott játék legújabb verziójának megjelenítése, az összes korábbi "
"verzió/kiadás elrejtésével. Különösen hasznos a TOSEC romkészleteknél."

msgid "{THEME.OPTION.HELP}"
