msgstr "Elavult"

msgid "QUICK JUMP"
msgstr "GYORSUGRÁS"

msgid "FOLD/UNFOLD"
msgstr "ÖSSZECSUKÁS/KINYITÁS"

msgid "FAST MOVE"
msgstr "GYORS MOZGÁS"

msgid "BOTTOM"
msgstr "ALJA"

msgid "TOP"
msgstr "TETEJE"

msgid "UNFOLD"
msgstr "KINYITÁS"

msgid "ADD CHARACTER"
msgstr "KARAKTER HOZZÁADÁSA"

msgid "GAMELIST MODIFIED!"
msgstr "JÁTÉKLISTA MÓDOSÍTVA!"

msgid "ROM FOLDERS MODIFIED!"
msgstr "ROM MAPPÁK MÓDOSÍTVA!"

msgid "TOTAL PLAYING TIME"
msgstr "TELJES JÁTÉKIDŐ"

msgid "OPTION NOT AVAILABLE"
msgstr "A BEÁLLÍTÁS NEM ÉRHETŐ EL"

msgid "Screen calibration only available in YOKO mode."
msgstr "A képernyő kalibrálása csak YOKO módban érhető el."

msgid "REALLY UPDATE {0}'S GAME LIST ?"
msgstr "TÉNYLEG FRISSÍTED {0} JÁTÉKLISTÁJÁT?"

msgid ""
"REALLY UPDATE ALL GAME LISTS ?\n"
"\n"
"IT MAY TAKE A LONG TIME DEPENDING OF YOUR STORAGE SPEED AND THE NUMBER OF "
"GAMES."
msgstr ""
"TÉNYLEG FRISSÍTED AZ ÖSSZES JÁTÉKLISTÁT?\n"
"\n"
