msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Scraping-a osatuta! {PROCESSED} joko prozesatuta.\n"
"\n"
"{SUCCESS} joko scraping edo eguneratuta\n"
"{NOTFOUND} joko ez da aurkitu...\n"
"{ERRORS} eskaera/deskarga errore\n"
"\n"
"{TEXTINFO} testu-informazioa eguneratuta\n"
"{IMAGES} irudi eta {VIDEOS} bideo deskargatuta\n"
"{MEDIASIZE} multimedia gordeta"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Egunerako scraping eskaera-kopurura iritsi zara.\n"
"Gaurko scraping guztiak gorde dira hala ere.\n"
"\n"
"Hasi berriro scraping-a bihar.\n"
"Ez ahaztu 'eguneratu' hautatzea eta ez 'scrap all'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"Zure share partizioa ia beteta dago.\n"
"Scraper-a automatikoki gelditu da.\n"
"\n"
"Kendu erabiltzen ez diren jokoak, multimedia eta fitxategiak lekua egiteko "
"scraper-a berriro exekutatu aurretik!"

