msgstr "Sistema"

msgid "Added to favorites"
msgstr "Gogokoetara gehituta"

msgid "Removed from favorites"
msgstr "Gogokoetatik kenduta"

msgid "Gameclips cannot be played. No video availabe for your selection"
msgstr ""
"Joko-klipak ezin dira erreproduzitu. Ez dago bideorik eskuragarri zure "
"hautaketarako"

