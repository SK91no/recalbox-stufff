msgstr "Télécharge des jeux gratuits variés et du contenu gratuit !"

msgid "Download games for {SYSTEM.NAME}"
msgstr "Télécharger du contenu pour {SYSTEM.NAME}"

msgid ""
"Download a pack of free games, game demos and homebrew for {SYSTEM.NAME}"
msgstr ""
"Télécharge un pack de jeux gratuits, démos de jeux et homebrew pour {SYSTEM."
"NAME}."

