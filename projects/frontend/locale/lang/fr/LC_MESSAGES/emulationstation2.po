msgstr ""
"L'initialisation a échoué ! Votre périphérique USB est plein ou contient des "
"erreurs. Veuillez le réparer ou utiliser un autre périphérique."

msgid "DISPLAY BY FILENAME"
msgstr "AFFICHER PAR NOM DE FICHIER"

