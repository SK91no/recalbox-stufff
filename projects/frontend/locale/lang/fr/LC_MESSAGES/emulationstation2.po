msgstr ""
"Aucune sauvegarde instantanée n'a été détectée pour ce jeu, ou l'élément "
"sélectionné n'est pas un jeu."

msgid "JUMP"
msgstr "ALLER À"

msgid "Open the Quick Jump selector."
msgstr "Ouvre la fenêtre de déplacement rapide"

