msgstr "Recalbox ne supporte pas l'overclocking pour votre matériel."

msgid "CONTEXTUAL OPTIONS"
msgstr "MENU CONTEXTUEL"

msgid "EDIT GAME {GAME.NAME}"
msgstr "MODIFIER LE JEU {GAME.NAME}"

msgid "Show options related to {GAME.NAME} and allow editing game metadata."
msgstr ""
"Affiche les options relatives à {GAME.NAME} et permet la modification des "
"metadata."

msgid ""
"You cannot edit this game because it is a pre-installed game or it is stored "
"on a read-only device"
msgstr ""
"Vous ne pouvez pas modifier ce jeu, soit parce que c'est un jeu pré-"
"installé, soit parce qu'il est stocké sur un support en lecture seule."

msgid "Select the emulator to use to run {GAME.NAME}"
msgstr "Selectionne l'émulateur à utiliser pour lancer {GAME.NAME}"

msgid "SET PATCH"
msgstr "SELECTIONNE LE PATCH"

