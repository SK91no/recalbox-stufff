msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Scraping ofgeschloss! {PROCESSED} Spiller behandelt.\n"
"\n"
"{SUCCESS} Spill(er) gescrapt oder aktualiséiert\n"
"{NOTFOUND} Spill(er) net fonnt...\n"
"{ERRORS} Ufro-/Download-Feeler\n"
"\n"
"{TEXTINFO} Textinformatiounen aktualiséiert\n"
"{IMAGES} Biller a {VIDEOS} Videoen erofgelueden\n"
"{MEDIASIZE} u Medie gespäichert"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Du hues däin dagesegen Limit u Scraping-Ufroe erreecht.\n"
"All haiteg Scrapes goufen trotzdeem gespäichert.\n"
"\n"
"Fänk moien nees mam Scrapen un.\n"
"Vergiess net 'aktualiséieren' anstatt 'alles scrapen' auszewielen"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"Deng Share-Partition ass bal voll.\n"
"De Scraper huet automatesch opgehalen.\n"
"\n"
"Läscht net benotzt Spiller, Medien a Fichieren fir Plaz ze maachen ier s de "
"de Scraper nees lafe léiss!"

