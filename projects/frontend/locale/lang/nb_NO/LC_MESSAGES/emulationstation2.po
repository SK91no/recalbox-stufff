msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Skraping fullført! {PROCESSED} spill behandlet.\n"
"\n"
"{SUCCESS} spill hentet eller oppdatert\n"
"{NOTFOUND} spill ikke funnet...\n"
"{ERRORS} feil ved forespørsel/nedlasting\n"
"\n"
"{TEXTINFO} tekstinformasjon oppdatert\n"
"{IMAGES} bilder og {VIDEOS} videoer lastet ned\n"
"{MEDIASIZE} medier lagret"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Du har nådd din daglige kvote for skrapeforespørsler.\n"
"Alle dagens skraper er likevel lagret.\n"
"\n"
"Start skraping igjen i morgen.\n"
"Ikke glem å velge «oppdater» og ikke «skrap alle»"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"Din share-partisjon er nesten full.\n"
"Skraperen stoppet automatisk.\n"
"\n"
"Fjern ubrukte spill, medier og filer for å frigjøre plass før du kjører "
"skraperen igjen!"

