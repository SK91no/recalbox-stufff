msgstr "Comprobando espacio disponible en el disco..."

msgid ""
"Not enough space on the target disk.\n"
"\n"
"The content of **/recalbox/share** ({SIZE_SHARE}) does not fit in the "
"available SHARE partition ({SIZE_AVAIL}).\n"
"\n"
"Please use a larger disk or free up space on /recalbox/share first."
msgstr ""
"No hay suficiente espacio en el disco de destino.\n"
"\n"
"El contenido de **/recalbox/share** ({SIZE_SHARE}) no cabe en la partición "
"SHARE disponible ({SIZE_AVAIL}).\n"
"\n"
"Utilice un disco más grande o libere espacio en /recalbox/share primero."

