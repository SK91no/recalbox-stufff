msgstr "ΓΡΗΓΟΡΟ ΑΛΜΑ"

msgid "FOLD/UNFOLD"
msgstr "ΠΤΥΞΗ/ΑΝΑΠΤΥΞΗ"

msgid "FAST MOVE"
msgstr "ΓΡΗΓΟΡΗ ΜΕΤΑΚΙΝΗΣΗ"

msgid "BOTTOM"
msgstr "ΚΑΤΩ"

msgid "TOP"
msgstr "ΠΑΝΩ"

msgid "UNFOLD"
msgstr "ΑΝΑΠΤΥΞΗ"

