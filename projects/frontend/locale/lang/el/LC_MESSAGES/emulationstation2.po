"λειτουργία οθόνης σε"

msgid "PAIR"
msgstr "ΣΥΖΕΥΞΗ"

msgid "JOIN GAME"
msgstr "ΣΥΜΜΕΤΟΧΗ ΣΕ ΠΑΙΧΝΙΔΙ"

msgid "RUN"
msgstr "ΕΚΤΕΛΕΣΗ"

msgid "DON'T DELETE ANYTHING!"
msgstr "ΜΗΝ ΔΙΑΓΡΑΨΕΤΕ ΤΙΠΟΤΑ!"

msgid "SHOW FAVORITES FIRST"
msgstr "ΕΜΦΑΝΙΣΗ ΑΓΑΠΗΜΕΝΩΝ ΠΡΩΤΑ"

