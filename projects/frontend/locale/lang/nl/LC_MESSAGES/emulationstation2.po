msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Scrapen voltooid! {PROCESSED} spellen verwerkt.\n"
"\n"
"{SUCCESS} spel(len) gescraped of bijgewerkt\n"
"{NOTFOUND} spel(len) niet gevonden...\n"
"{ERRORS} verzoek-/downloadfouten\n"
"\n"
"{TEXTINFO} tekstinformatie bijgewerkt\n"
"{IMAGES} afbeeldingen en {VIDEOS} video's gedownload\n"
"{MEDIASIZE} aan media opgeslagen"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"U heeft uw dagelijkse quotum voor scrapeverzoeken bereikt.\n"
"Al uw scrapes van vandaag zijn toch opgeslagen.\n"
"\n"
"Begin morgen opnieuw met scrapen.\n"
"Vergeet niet 'bijwerken' te selecteren en niet 'alles scrapen'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"Uw share-partitie is bijna vol.\n"
"De scraper is automatisch gestopt.\n"
"\n"
"Verwijder ongebruikte spellen, media en bestanden om ruimte te maken voordat "
"u de scraper opnieuw uitvoert!"

