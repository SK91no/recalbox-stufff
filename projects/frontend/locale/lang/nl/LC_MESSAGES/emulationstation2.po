msgstr "Kies de dode zone als percentage, tussen 0% en 99%. Standaard is 2%."

msgid "Supermodel Settings - Audio"
msgstr "Supermodel-instellingen - Audio"

msgid "Sound volume"
msgstr "Geluidsvolume"

msgid ""
"Choose the master volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Kies het hoofdvolume als percentage, tussen 0% en 100%. Standaard is 100%."

