msgstr "Гучність звуку"

msgid ""
"Choose the master volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Виберіть загальну гучність у відсотках, від 0% до 100%. За замовчуванням "
"100%."

msgid "Music volume"
msgstr "Гучність музики"

msgid ""
"Choose the music volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Виберіть гучність музики у відсотках, від 0% до 100%. За замовчуванням 100%."

msgid "Balance"
msgstr "Баланс"

msgid ""
"Choose the relative front/rear balance in percentage, between 0% to 100%. "
"Default is 0%."
msgstr ""
"Виберіть відносний баланс перед/зад у відсотках, від 0% до 100%. За "
"замовчуванням 0%."

msgid "Channels"
msgstr "Канали"

msgid "Choose the number of sound channels to use on host. Default is 2."
msgstr ""
"Виберіть кількість звукових каналів для використання на хості. За "
"замовчуванням 2."

msgid "Flip stereo"
msgstr "Перевернути стерео"

msgid "Swap the left and right audio channels."
msgstr "Виберіть, чи потрібно поміняти місцями лівий і правий аудіоканали."

msgid "Sound"
msgstr "Звук"

msgid ""
"Choose if you disable sound board emulation sound effects. Default is "
"disabled."
msgstr ""
"Виберіть, чи вимкнути звукові ефекти емуляції звукової плати. За "
"замовчуванням вимкнено."

msgid "No Digital Sound Board (DSB)"
msgstr "Без цифрової звукової плати (DSB)"

msgid "Enable or disable Digital Sound Board MPEG music. Default is disabled."
msgstr ""
"Увімкніть або вимкніть музику MPEG цифрової звукової плати. За замовчуванням "
"вимкнено."

msgid "Sound engine"
msgstr "Звуковий рушій"

msgid ""
"Choose between the legacy and new sound engines. Default is MAME engine."
msgstr ""
"Виберіть між застарілим та новим звуковими рушіями. За замовчуванням рушій "
"MAME."

msgid "Supermodel Settings - Video"
msgstr "Налаштування Supermodel - Відео"

msgid "Supersampling"
msgstr "Суперсемплінг"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr "Суперсемплінг. Ще не увімкнено. За замовчуванням 1."

msgid "Upscale"
msgstr "Апскейл"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr "Виберіть режим фільтра апскейлу 2D-шару. За замовчуванням 0."

msgid "Disable no throttle"
msgstr "Вимкнути відсутність обмеження"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"Виберіть, чи увімкнути фіксацію частоти кадрів 60Гц. За замовчуванням "
"вимкнено."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr ""
"Виберіть, чи фіксувати вертикальну частоту оновлення. За замовчуванням "
"увімкнено."

msgid "True Hz"
msgstr "Справжні Гц"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr ""
"Виберіть використання справжньої частоти оновлення Model 3 — 57,524 Гц. За "
"замовчуванням вимкнено."

msgid "Crosshairs"
msgstr "Приціл"

msgid "Show crosshairs. Default is disabled."
msgstr "Виберіть, чи показувати приціл. За замовчуванням вимкнено."

msgid "Multi texture"
msgstr "Мультитекстура"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr ""
"Виберіть, чи використовувати 8 текстурних карт для декодування. За "
"замовчуванням вимкнено."

msgid "Quad rendering"
msgstr "Квадрорендеринг"

msgid "Enable proper quad rendering. Default is disabled."
msgstr ""
"Виберіть, чи увімкнути коректний квадрорендеринг. За замовчуванням вимкнено."

msgid "Supermodel Settings - Core"
msgstr "Налаштування Supermodel - Ядро"

msgid "GPU multi threading"
msgstr "Багатопотоковість GPU"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"Встановіть ON, щоб GPU працював у власному потоці замість спільного "
"використання потоку CPU. Швидше, але може спричиняти помилки залежно від гри."

msgid "PPC Frequency"
msgstr "Частота PPC"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr "Виберіть частоту PowerPC у МГц, від 1 до 1000. За замовчуванням 70."

msgid "Service button"
msgstr "Сервісна кнопка"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"Увімкніть або вимкніть сервісне меню в іграх (L3 = тест, R3 = сервіс). За "
"замовчуванням увімкнено."

msgid "Log level"
msgstr "Рівень журналювання"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr ""
"Виберіть рівень інформації у файлі журналу. За замовчуванням — інформація."

msgid "Xemu Settings"
msgstr "Налаштування Xemu"

msgid "Choose the internal resolution of the Xbox."
msgstr "Виберіть внутрішню роздільну здатність Xbox."

msgid "Show menu bar"
msgstr "Показати панель меню"

msgid "Show the menu bar."
msgstr "Виберіть, чи показувати панель меню."

msgid "Skip boot animation"
msgstr "Пропустити анімацію завантаження"

msgid "Skip the boot animation."
msgstr "Виберіть, чи пропускати анімацію завантаження."

msgid "Show notifications"
msgstr "Показувати сповіщення"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "Показувати сповіщення у правому верхньому куті екрана."

msgid "Display mode"
msgstr "Режим відображення"

msgid "Choose how the framebuffer should fit or scale."
msgstr "Виберіть, як фреймбуфер має вписуватися чи масштабуватися."

msgid "Aspect Ratio"
msgstr "Співвідношення сторін"

msgid "Choose the aspect ratio of the Xbox."
msgstr "Виберіть співвідношення сторін Xbox."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - Загальні налаштування EEPROM"

msgid "Choose the region to use on Xbox."
msgstr "Виберіть регіон для використання на Xbox."

msgid "Video Standard"
msgstr "Відеостандарт"

msgid "Choose the video standard to use on Xbox."
msgstr "Виберіть відеостандарт для використання на Xbox."

msgid "Timezone"
msgstr "Часовий пояс"

msgid ""
"Choose the timezone to use on Xbox. If your country is using DST, don't take "
"it into account when you are setting this."
msgstr ""
"Виберіть часовий пояс для використання на Xbox. Якщо у вашій країні діє "
"літній час, не враховуйте його під час налаштування."

msgid "Disable automatic daylight saving time"
msgstr "Вимкнути автоматичний перехід на літній час"

msgid "Choose if you want to disable automatic daylight saving time."
msgstr "Виберіть, чи вимкнути автоматичний перехід на літній час."

msgid "DVD Region"
msgstr "Регіон DVD"

msgid "Choose the DVD region to use on Xbox."
msgstr "Виберіть регіон DVD для використання на Xbox."

msgid "Language"
msgstr "Мова"

msgid "Choose the language to use on Xbox."
msgstr "Виберіть мову для використання на Xbox."

msgid "Xemu - EEPROM Video Settings"
msgstr "Xemu - Налаштування відео EEPROM"

msgid "Enable 480p resolution on Xbox."
msgstr "Виберіть, чи увімкнути роздільну здатність 480p на Xbox."

msgid "720p"
msgstr "720p"

msgid "Enable 720p resolution on Xbox."
msgstr "Виберіть, чи увімкнути роздільну здатність 720p на Xbox."

msgid "1080i"
msgstr "1080i"

msgid "Enable 1080i resolution on Xbox."
msgstr "Виберіть, чи увімкнути роздільну здатність 1080i на Xbox."

msgid "Video Mode"
msgstr "Відеорежим"

msgid "Choose the video mode to use on Xbox."
msgstr "Виберіть відеорежим для використання на Xbox."

msgid "Refresh rate"
msgstr "Частота оновлення"

msgid "Set the refresh rate to 60Hz on Xbox."
msgstr "Виберіть, чи встановити частоту оновлення 60Гц на Xbox."

msgid "Xemu - EEPROM Audio Settings"
msgstr "Xemu - Налаштування звуку EEPROM"

msgid "Audio Output"
msgstr "Аудіовихід"

msgid "Choose the audio output to use on Xbox."
msgstr "Виберіть аудіовихід для використання на Xbox."

msgid "AC3"
msgstr "AC3"

msgid "Enable Dolby Digital (AC3) on Xbox."
msgstr "Виберіть, чи увімкнути Dolby Digital (AC3) на Xbox."

msgid "DTS"
msgstr "DTS"

msgid "Enable Dolby Surround (DTS) on Xbox."
msgstr "Виберіть, чи увімкнути Dolby Surround (DTS) на Xbox."

msgid "SHUTDOWN RECALBOX"
msgstr "ВИМКНУТИ RECALBOX"

msgid "FAST SHUTDOWN RECALBOX"
msgstr "ШВИДКО ВИМКНУТИ RECALBOX"

msgid "RESTART RECALBOX"
msgstr "ПЕРЕЗАПУСТИТИ RECALBOX"

msgid "EDIT NETPLAY PASSWORDS"
msgstr "РЕДАГУВАТИ ПАРОЛІ NETPLAY"

msgid "PASSWORD #{INDEX}"
msgstr "ПАРОЛЬ #{INDEX}"

msgid "SHARE USAGE"
msgstr "ВИКОРИСТАННЯ СХОВИЩА"

msgid "SHARE PARTITION"
msgstr "РОЗДІЛ СХОВИЩА"

msgid "Exit the password edition."
msgstr "Вийти з редагування паролів."

msgid "AVAILABLE STORAGES"
msgstr "ДОСТУПНІ НОСІЇ"

msgid ""
"Show a list of storage available on your system. Select a storage to access "
"extra information and available actions."
msgstr ""
"Показати список носіїв, доступних у вашій системі. Виберіть носій, щоб "
"отримати доступ до додаткової інформації та доступних дій."

msgid "Get information about {DEVICE.NAME}"
msgstr "Отримати інформацію про {DEVICE.NAME}"

msgid "FREE SPACE"
msgstr "ВІЛЬНЕ МІСЦЕ"

msgid "Display free space available on the device"
msgstr "Показати вільне місце, доступне на пристрої"

msgid "STORAGE NAME"
msgstr "НАЗВА НОСІЯ"

msgid "Display real device name"
msgstr "Показати справжню назву пристрою"

msgid "NETWORK ACCESS"
msgstr "МЕРЕЖЕВИЙ ДОСТУП"

msgid "Access to this storage through your local network."
msgstr "Доступ до цього носія через вашу локальну мережу."

msgid "FILE SYSTEM"
msgstr "ФАЙЛОВА СИСТЕМА"

msgid "FileSystem"
msgstr "Файлова система"

msgid "COMPATIBLE WITH RECALBOX?"
msgstr "СУМІСНО З RECALBOX?"

msgid "Show if this storage is compatible with recalbox"
msgstr "Показати, чи сумісний цей носій з recalbox"

msgid "INSTALL RECALBOX ROM FOLDERS"
msgstr "ВСТАНОВИТИ ПАПКИ ROM RECALBOX"

msgid "INITIALIZE!"
msgstr "ІНІЦІАЛІЗУВАТИ!"

msgid ""
"Create rom structure so that this storage will be used by Recalbox on next "
"boots."
msgstr ""
"Створити структуру roms, щоб цей носій використовувався Recalbox під час "
"наступних завантажень."

msgid ""
"You cannot initialize this storage, because either it is already initialized "
"or it is not compatible."
msgstr ""
"Неможливо ініціалізувати цей носій, оскільки він уже ініціалізований або "
"несумісний."

msgid ""
"Select your language. A reboot is required to set this configuration active."
msgstr ""
"Виберіть вашу мову. Для активації цього налаштування потрібне "
"перезавантаження."

msgid "TIMEZONE"
msgstr "ЧАСОВИЙ ПОЯС"

msgid ""
"Select the timezone used to display dates and times in their local format."
msgstr ""
"Дозволяє вибрати часовий пояс для показу дат і часу в локальному форматі."

msgid "Shows available update version."
msgstr "Показує доступну версію оновлення."

msgid "CHECK UPDATES PERIODICALLY"
msgstr "ПЕРІОДИЧНО ПЕРЕВІРЯТИ ОНОВЛЕННЯ"

msgid ""
"Automatically check if an update is available. If so, it notifies you with a "
"message."
msgstr "Автоматично перевіряє наявність оновлення. Якщо є, повідомляє про це."

msgid "Select update type"
msgstr "Виберіть тип оновлення"

msgid "CHECK"
msgstr "ПЕРЕВІРИТИ"

msgid "Check if an update is available, right now."
msgstr "Перевірити наявність оновлення прямо зараз."

msgid "SHOW NEW VERSION CHANGELOG"
msgstr "ПОКАЗАТИ ЖУРНАЛ ЗМІН НОВОЇ ВЕРСІЇ"

msgid "SHOW"
msgstr "ПОКАЗАТИ"

msgid "Shows available update changelog."
msgstr "Показує журнал змін доступного оновлення."

msgid "DOWNLOAD AND UPDATE MY RECALBOX"
msgstr "ЗАВАНТАЖИТИ Й ОНОВИТИ МІЙ RECALBOX"

msgid "GO!"
msgstr "ВПЕРЕД!"

msgid "No update available yet."
msgstr "Оновлення поки що недоступні."

msgid "RECALBOX RGB DUAL SETTINGS"
msgstr "НАЛАШТУВАННЯ RECALBOX RGB DUAL"

msgid ""
"Select Recalbox's interface resolution. 480i is recommended for better "
"details."
msgstr ""
"Виберіть роздільну здатність інтерфейсу Recalbox. Для кращої деталізації "
"рекомендується 480i."

msgid "AVOID INTERLACED MODES"
msgstr "УНИКАТИ ЧЕРЕЗРЯДКОВИХ РЕЖИМІВ"

msgid "Avoid interlaced mode for all games."
msgstr "Уникати черезрядкового режиму для всіх ігор."

msgid "AVOID INTERLACED MODES FOR TATE GAMES ON YOKO AND HANDHELDS"
msgstr ""
"УНИКАТИ ЧЕРЕЗРЯДКОВИХ РЕЖИМІВ ДЛЯ ІГОР TATE НА YOKO ТА ПОРТАТИВНИХ ПРИСТРОЯХ"

msgid "31 KHZ"
msgstr "31 КГЦ"

msgid "You're not in 31khz mode"
msgstr "Ви не в режимі 31кГц"

msgid "RUN DEMOS AND AUTOBOOT GAMES IN 240P@120"
msgstr "ЗАПУСКАТИ ДЕМО ТА АВТОЗАВАНТАЖУВАНІ ІГРИ В 240P@120"

msgid ""
"Run the demos and autoboot games in 240p resolution on your 31kHz monitor."
msgstr ""
"Запускати демо та автозавантажувані ігри в роздільній здатності 240p на "
"вашому моніторі 31кГц."

msgid "EXPERIMENTAL"
msgstr "ЕКСПЕРИМЕНТАЛЬНО"

msgid "RECALBOX RGB JAMMA SETTINGS"
msgstr "НАЛАШТУВАННЯ RECALBOX RGB JAMMA"

msgid "Recalbox RGB Jamma options and configuration."
msgstr "Параметри та конфігурація Recalbox RGB Jamma."

msgid ""
"Avoid interlaced mode for tate (vertical) games on yoko (horizontal) "
"screens, and for handheld consoles."
msgstr ""
"Уникати черезрядкового режиму для ігор tate (вертикальних) на екранах yoko "
"(горизонтальних) і для портативних консолей."

msgid "JAMMA OPTIONS"
msgstr "ПАРАМЕТРИ JAMMA"

msgid "START + UP and DOWN change the volume in frontend and in games."
msgstr "START + ВВЕРХ і ВНИЗ змінюють гучність в інтерфейсі та в іграх."

msgid "Load the dual joystick configuration on compatible games!"
msgstr "Завантажити конфігурацію подвійного джойстика для сумісних ігор!"

msgid "Reset all previous options to their default values"
msgstr "Скинути всі попередні параметри до типових значень"

msgid "RECALBOX RGB DUAL 2 SETTINGS"
msgstr "НАЛАШТУВАННЯ RECALBOX RGB DUAL 2"

msgid "Recalbox RGB Dual 2 options and configuration."
msgstr "Параметри та конфігурація Recalbox RGB Dual 2."

msgid "Select Recalbox's interface resolution."
msgstr "Виберіть роздільну здатність інтерфейсу Recalbox."

msgid "FORCE COMPOSITE"
msgstr "ПРИМУСОВИЙ КОМПОЗИТНИЙ"

msgid "Force composite output (On SCART, RCA and JACK)."
msgstr "Примусово увімкнути композитний вихід (на SCART, RCA та JACK)."

msgid "COMPOSITE SIGNAL STANDARD"
msgstr "СТАНДАРТ КОМПОЗИТНОГО СИГНАЛУ"

msgid ""
"When using composite, selects the composite signal standard for your region."
msgstr ""
"У разі використання композитного сигналу вибирає його стандарт для вашого "
"регіону."

msgid "16/9 CRT TV"
msgstr "ТЕЛЕВІЗОР CRT 16/9"

msgid "Activate if you have a 16/9 CRT TV."
msgstr "Активуйте, якщо у вас телевізор CRT 16/9."

msgid "SELECT SIGNAL (RGB/COMPOSITE) AT LAUNCH"
msgstr "ВИБІР СИГНАЛУ (RGB/КОМПОЗИТНИЙ) ПРИ ЗАПУСКУ"

msgid ""
"Let you choose between RGB Signal and composite signal at launch, for "
"compatible systems."
msgstr ""
"Дозволяє вибрати між сигналом RGB і композитним сигналом при запуску для "
"сумісних систем."

msgid "DIP SWITCHES"
msgstr "DIP-ПЕРЕМИКАЧІ"

msgid "FORCED 50HZ DIP SWITCH"
msgstr "ПРИМУСОВИЙ DIP-ПЕРЕМИКАЧ 50ГЦ"

msgid "FORCED 31kHz/MULTISYNC DIP SWITCH"
msgstr "ПРИМУСОВИЙ DIP-ПЕРЕМИКАЧ 31КГЦ/MULTISYNC"

msgid "FORCED COMPOSITE DIP SWITCH"
msgstr "ПРИМУСОВИЙ DIP-ПЕРЕМИКАЧ КОМПОЗИТНОГО СИГНАЛУ"

msgid "IN-GAME SETTINGS"
msgstr "НАЛАШТУВАННЯ В ГРІ"

msgid "FEATURES"
msgstr "ФУНКЦІЇ"

msgid "GAMES RENDERING"
msgstr "РЕНДЕРИНГ ІГОР"

msgid "AUTO BLITTER (FBNEO/MAME)"
msgstr "АВТО BLITTER (FBNEO/MAME)"

msgid ""
"Enables automatic blitter and CPU settings for fbneo and mame games. Can "
"enhance emulation precision on games like Cave."
msgstr ""
"Вмикає автоматичні налаштування blitter і CPU для ігор fbneo та mame. Може "
"підвищити точність емуляції в іграх на кшталт Cave."

msgid "SYSTEM-LISTS & GAMELISTS SETTINGS"
msgstr "НАЛАШТУВАННЯ СПИСКІВ СИСТЕМ ТА ІГОР"

msgid "Configure system and gamelist filters and options"
msgstr "Налаштувати фільтри та параметри систем і списків ігор"

msgid "SYSTEM LISTS"
msgstr "СПИСКИ СИСТЕМ"

msgid "SHOW SYSTEMS"
msgstr "ПОКАЗАТИ СИСТЕМИ"

msgid "Show or hide systems individually"
msgstr "Показувати або приховувати системи окремо"

msgid "GAMES"
msgstr "ІГРИ"

msgid "ENABLE ADDING/REMOVING FAVORITES"
msgstr "УВІМКНУТИ ДОДАВАННЯ/ВИДАЛЕННЯ УЛЮБЛЕНИХ"

msgid ""
"Enable or disable adding/removing favorites in gamelist, search and other "
"various places."
msgstr ""
"Увімкнути або вимкнути додавання/видалення улюблених у списку ігор, пошуку "
"та інших місцях."

msgid ""
"Show only favorites. May hide all systems with no favorite at all until you "
"switch off this option."
msgstr ""
"Показувати лише улюблені. Може приховати всі системи без улюблених, доки цей "
"параметр не буде вимкнено."

msgid "Display all favorites at the top of the game list."
msgstr "Показувати всі улюблені на початку списку ігор."

msgid "Force hidden game to show in gamelists."
msgstr "Примусово показувати приховані ігри у списках ігор."

msgid "SHOW MAHJONG AND CASINO GAMES"
msgstr "ПОКАЗАТИ ІГРИ МАДЖОНГ І КАЗИНО"

msgid ""
"Show or hide asian casino and mahjong games. You must scrape your game for "
"this option to work."
msgstr ""
"Показувати або приховувати азіатські ігри казино та маджонг. Для роботи "
"цього параметра потрібно виконати скрапінг гри."

msgid "SHOW ADULT GAMES"
msgstr "ПОКАЗАТИ ІГРИ ДЛЯ ДОРОСЛИХ"

msgid ""
"Show or hide adult games. You must scrape your game for this option to work."
msgstr ""
"Показувати або приховувати ігри для дорослих. Для роботи цього параметра "
"потрібно виконати скрапінг гри."

msgid "SHOW PREINSTALLED GAMES"
msgstr "ПОКАЗАТИ ПОПЕРЕДНЬО ВСТАНОВЛЕНІ ІГРИ"

msgid ""
"Show or hide games distributed with Recalbox. But you don't want to do this: "
"they are all excellent games!"
msgstr ""
"Показувати або приховувати ігри, що постачаються з Recalbox. Але навряд чи "
"варто це робити: усі вони чудові!"

msgid "Show only games playable with 3 or more players"
msgstr "Показувати лише ігри, у які можна грати втрьох і більше"

msgid "SHOW ONLY YOKO (HORIZONTAL) GAMES"
msgstr "ПОКАЗАТИ ЛИШЕ ІГРИ YOKO (ГОРИЗОНТАЛЬНІ)"

msgid ""
"Show only YOKO (horizontal) games. Mutually exclusive with the option to "
"show only TATE games."
msgstr ""
"Показувати лише ігри YOKO (горизонтальні). Взаємовиключно з параметром "
"показу лише ігор TATE."

msgid "SHOW ONLY TATE (VERTICAL) GAMES"
msgstr "ПОКАЗАТИ ЛИШЕ ІГРИ TATE (ВЕРТИКАЛЬНІ)"

msgid ""
"Show only TATE (vertical) games. Mutually exclusive with the option to show "
"only YOKO games."
msgstr ""
"Показувати лише ігри TATE (вертикальні). Взаємовиключно з параметром показу "
"лише ігор YOKO."

msgid "SHOW ROMS MARKED AS NON-GAMES"
msgstr "ПОКАЗАТИ ROM, ПОЗНАЧЕНІ ЯК НЕ ІГРИ"

msgid ""
"Show or hide roms that are explicitly marked as non-game (application, "
"utilities, ...). You must scrape your game for this option to work."
msgstr ""
"Показувати або приховувати roms, явно позначені як не ігри (застосунки, "
"утиліти тощо). Для роботи цього параметра потрібно виконати скрапінг гри."

msgid "ENABLE ONE GAME ONE ROM (1G1R)"
msgstr "УВІМКНУТИ ОДНА ГРА ОДИН ROM (1G1R)"

msgid "Display only one rom|disk image for a game from your preferred region."
msgstr ""
"Показувати лише один rom/образ диска для гри з вашого бажаного регіону."

msgid "PRIORITY REGION (1G1R)"
msgstr "ПРІОРИТЕТНИЙ РЕГІОН (1G1R)"

msgid "Choose your preferred region for 1G1R filtering."
msgstr "Виберіть бажаний регіон для фільтрації 1G1R"

msgid "SECOND PRIORITY REGION (1G1R)"
msgstr "ДРУГИЙ ПРІОРИТЕТНИЙ РЕГІОН (1G1R)"

msgid "Choose your second preferred region for 1G1R filtering."
msgstr "Виберіть другий бажаний регіон для фільтрації 1G1R"

msgid "THIRD PRIORITY REGIONS (1G1R)"
msgstr "ТРЕТІЙ ПРІОРИТЕТНИЙ РЕГІОН (1G1R)"

msgid ""
"Choose your preferred regions priority when there is no match with first and "
"second regions"
msgstr ""
"Виберіть пріоритет бажаних регіонів, якщо немає збігу з першим і другим "
"регіонами"

msgid "ARCADE SYSTEMS"
msgstr "АРКАДНІ СИСТЕМИ"

msgid "ENABLE AGGREGATED ARCADE SYSTEM"
msgstr "УВІМКНУТИ ОБ'ЄДНАНУ АРКАДНУ СИСТЕМУ"

msgid "Available only when aggregated arcade system is on"
msgstr "Доступно лише коли увімкнена об'єднана аркадна система"

msgid ""
"Select manufacturer virtual system to show in the system view (like "
"CPS1/2/3, SEGA, TAITO, ...)"
msgstr ""
"Виберіть віртуальні системи за виробником для показу в огляді систем (як-от "
"CPS1/2/3, SEGA, TAITO тощо)"

msgid "ARCADE GAMES"
msgstr "АРКАДНІ ІГРИ"

msgid ""
"Always use arcade names from official databases. Overwrites manual edits and "
"scraper results."
msgstr ""
"Завжди використовувати аркадні назви з офіційних баз даних. Перезаписує "
"ручне редагування та результати скрапера."

msgid "USER INTERFACE SETTINGS"
msgstr "НАЛАШТУВАННЯ КОРИСТУВАЦЬКОГО ІНТЕРФЕЙСУ"

msgid "SYSTEMS TO SHOW IN DEMO/GAMECLIP"
msgstr "СИСТЕМИ ДЛЯ ПОКАЗУ В ДЕМО/ІГРОВИХ КЛІПАХ"

msgid "Adjust the screen brightness"
msgstr "Налаштувати яскравість екрана"

msgid "Change the look of your Recalbox!"
msgstr "Змініть вигляд вашого Recalbox!"

msgid "DEFAULT TRANSITION STYLE"
msgstr "ТИПОВИЙ СТИЛЬ ПЕРЕХОДУ"

msgid ""
"Select the type of transition between system. INSTANT will do nothing, FADE "
"will fade to dark, and SLIDE will slide the entire screen"
msgstr ""
"Виберіть тип переходу між системами. INSTANT нічого не робить, FADE затемнює "
"екран, а SLIDE зсуває весь екран"

msgid "Select {THEME.OPTION.NAME}"
msgstr "Вибрати {THEME.OPTION.NAME}"

msgid "GAME LAUNCH TRANSITION STYLE"
msgstr "СТИЛЬ ПЕРЕХОДУ ПРИ ЗАПУСКУ ГРИ"

msgid ""
"Select the type of transition when you launch a game. INSTANT will do "
"nothing, FADE will fade to dark, and SLIDE will zoom in on the game cover."
msgstr ""
"Виберіть тип переходу при запуску гри. INSTANT нічого не робить, FADE "
"затемнює екран, а SLIDE наближає обкладинку гри."

msgid "ENABLE FAST MOVE IN GAMELIST"
msgstr "УВІМКНУТИ ШВИДКЕ ПЕРЕМІЩЕННЯ У СПИСКУ ІГОР"

msgid ""
"When enabled, holding up or down for a few seconds makes the list scroll "
"very fast."
msgstr ""
"Якщо увімкнено, утримування вгору/вниз протягом кількох секунд змушує список "
"прокручуватися дуже швидко"

msgid "Display the current time in a corner of the screen."
msgstr "Показувати поточний час у кутку екрана."

msgid "SHOW MUSIC POPUPS"
msgstr "ПОКАЗУВАТИ СПЛИВАЮЧІ ВІКНА МУЗИКИ"

msgid "When enabled, show music information every time a new music starts."
msgstr ""
"Якщо увімкнено, показує інформацію про музику щоразу, коли починається нова "
"композиція."

msgid "SHOW NETPLAY POPUPS"
msgstr "ПОКАЗУВАТИ СПЛИВАЮЧІ ВІКНА NETPLAY"

msgid ""
"When enabled, show netplay information every time a user starts a new game "
"over internet."
msgstr ""
"Якщо увімкнено, показує інформацію про netplay щоразу, коли користувач "
"починає нову гру через інтернет."

msgid "CONTROLLER SETTINGS"
msgstr "НАЛАШТУВАННЯ КОНТРОЛЕРА"

msgid "Add and configure all your controllers."
msgstr "Додайте та налаштуйте всі свої контролери."

msgid "WIFI"
msgstr "WIFI"

msgid "CONNECT AUTOMATICALLY"
msgstr "ПІДКЛЮЧАТИСЯ АВТОМАТИЧНО"

msgid ""
"Automatically connect on startup if the WIFI network is available and "
"properly configured!"
msgstr ""
"Автоматично підключатися при запуску, якщо мережа WIFI доступна та правильно "
"налаштована!"

msgid "WIFI is disabled!"
msgstr "WIFI вимкнено!"

msgid "SELECT SSID"
msgstr "ВИБРАТИ SSID"

msgid "Select an available SSID."
msgstr "Виберіть доступний SSID."

msgid "If your Internet box has a WPS system, activate it and then click here!"
msgstr ""
"Якщо ваш інтернет-роутер має систему WPS, активуйте її, а потім натисніть "
"тут!"

msgid ""
"Run the scraper! The operation may take a while, however you can make it a "
"background task and keep using Recalbox."
msgstr ""
"Запустіть скрапер! Операція може зайняти деякий час, однак ви можете зробити "
"її фоновим завданням і продовжувати користуватися Recalbox."

msgid "PATRON OPTIONS"
msgstr "ПАРАМЕТРИ ПАТРОНА"

msgid "user name for the selected scraper"
msgstr "ім'я користувача для вибраного скрапера"

msgid "password for the selected scraper"
msgstr "пароль для вибраного скрапера"

msgid "Download various free games and free contents!"
msgstr "Завантажуйте різноманітні безкоштовні ігри та контент!"

msgid "Download games for {SYSTEM.NAME}"
msgstr "Завантажити ігри для {SYSTEM.NAME}"

msgid ""
"Download a pack of free games, game demos and homebrew for {SYSTEM.NAME}"
msgstr ""
"Завантажити набір безкоштовних ігор, демоверсій та homebrew для {SYSTEM.NAME}"

msgid "No content available yet for {SYSTEM.NAME}!"
msgstr "Для {SYSTEM.NAME} поки що немає доступного контенту!"

msgid "ACTIVATE DEBUG/VERBOSE LOGS"
msgstr "АКТИВУВАТИ ДЕТАЛЬНІ ЖУРНАЛИ НАЛАГОДЖЕННЯ"

msgid "Activate debug and verbose logs in Recalbox and Emulators."
msgstr ""
"Активувати журнали налагодження та детальні журнали в Recalbox і емуляторах."

msgid "You cannot set up Kodi on boot when Kodi is disabled."
msgstr ""
"Неможливо налаштувати запуск Kodi при завантаженні, якщо Kodi вимкнено."

msgid "DO NOT SCAN NEW GAMES"
msgstr "НЕ СКАНУВАТИ НОВІ ІГРИ"

msgid ""
"Formerly called 'GAMELIST ONLY', it can greatly speed up boot time by not "
"scanning new files. Use it if your romsets are rarely updated."
msgstr ""
"Раніше називалося 'GAMELIST ONLY', може значно прискорити час завантаження, "
"не скануючи нові файли. Використовуйте, якщо ваші набори ромів рідко "
"оновлюються."

msgid "ALLOW BOOT ON GAME"
msgstr "ДОЗВОЛИТИ ЗАВАНТАЖЕННЯ З ГРОЮ"

msgid ""
"When activated, Recalbox boots into the gamelist and does not allow moving "
"back to the system list."
msgstr ""
"Якщо активовано, Recalbox завантажується зі списком ігор і не дозволяє "
"повернутися до списку систем."

msgid "SYSTEM SPECIFIC RESOLUTIONS"
msgstr "РОЗДІЛЬНІ ЗДАТНОСТІ ДЛЯ КОНКРЕТНИХ СИСТЕМ"

msgid "FOR {SYSTEM.NAME}"
msgstr "ДЛЯ {SYSTEM.NAME}"

msgid "Select the resolution used by the emulator '{SYSTEM.NAME}'."
msgstr ""
"Виберіть роздільну здатність, яку використовує емулятор '{SYSTEM.NAME}'."

msgid "Set options for system {SYSTEM.NAME}"
msgstr "Встановити параметри для системи {SYSTEM.NAME}"

msgid "Set the way you want to use Kodi mediaplayer."
msgstr "Встановіть спосіб використання медіаплеєра Kodi."

msgid "RUN KODI ON STARTUP"
msgstr "ЗАПУСКАТИ KODI ПРИ СТАРТІ"

msgid "START KODI WITH X BUTTON"
msgstr "ЗАПУСКАТИ KODI КНОПКОЮ X"

msgid "Run your own scripts in shell or python"
msgstr "Запускайте власні скрипти в shell або python"

msgid "Run custom script {SCRIPT.NAME}"
msgstr "Запустити користувацький скрипт {SCRIPT.NAME}"

msgid "ENABLE WEB MANAGER"
msgstr "УВІМКНУТИ ВЕБ-МЕНЕДЖЕР"

msgid "RESET EMULATOR SETTINGS"
msgstr "СКИНУТИ НАЛАШТУВАННЯ ЕМУЛЯТОРА"

msgid "RESET!"
msgstr "СКИНУТИ!"

msgid ""
"This option resets all emulator settings to their factory defaults. It does "
"not affect any Recalbox setting."
msgstr ""
"Цей параметр скидає всі налаштування емулятора до заводських значень. Не "
"впливає на жодне налаштування Recalbox."

msgid "HARDWARE"
msgstr "ОБЛАДНАННЯ"

msgid "UPDATE!"
msgstr "ОНОВИТИ!"

msgid "Update Pi4 / Pi400 or Pi5 bootloader if required."
msgstr "Оновіть завантажувач Pi4 / Pi400 або Pi5, якщо потрібно."

msgid "Recalbox does not support overclocking for your board."
msgstr "Recalbox не підтримує розгін для вашої плати."

msgid "CONTEXTUAL OPTIONS"
msgstr "КОНТЕКСТНІ ПАРАМЕТРИ"

msgid "EDIT GAME {GAME.NAME}"
msgstr "РЕДАГУВАТИ ГРУ {GAME.NAME}"

msgid "Show options related to {GAME.NAME} and allow editing game metadata."
msgstr ""
"Показати параметри, пов'язані з {GAME.NAME}, і дозволити редагування "
"метаданих гри."

msgid ""
"You cannot edit this game because it is a pre-installed game or it is stored "
"on a read-only device"
msgstr ""
"Неможливо редагувати цю гру, оскільки вона попередньо встановлена або "
"зберігається на пристрої лише для читання"

msgid "Select the emulator to use to run {GAME.NAME}"
msgstr "Виберіть емулятор для запуску {GAME.NAME}"

msgid "SET PATCH"
msgstr "ВСТАНОВИТИ ПАТЧ"

msgid "Select patch to use when running an emulator supporting softpatching."
msgstr ""
"Виберіть патч для використання під час запуску емулятора, що підтримує "
"softpatching."

msgid ""
"Either the game has no patch or the emulator selected to run this game is "
"not supporting softpatching."
msgstr ""
"Або гра не має патча, або вибраний для її запуску емулятор не підтримує "
"softpatching."

msgid "Sets the name of the game or folder."
msgstr "Встановлює назву гри чи папки."

msgid "Set this game as favorite or not."
msgstr "Позначити цю гру як улюблену чи ні."

msgid "Editing favorites is not enabled."
msgstr "Редагування улюблених не увімкнено."

msgid "Hide or show this game."
msgstr "Сховати або показати цю гру."

msgid "Defines this game as an adult game or not."
msgstr "Визначає, чи є ця гра грою для дорослих."

msgid "Scraping"
msgstr "Скрапінг"

msgid "Scrape this game and fill in all metadata at once!"
msgstr "Отримати дані для цієї гри та заповнити всі метадані одразу!"

msgid "Statistics"
msgstr "Статистика"

msgid "Show the total time you played this game"
msgstr "Показати загальний час, який ви грали в цю гру"

msgid "PLAY COUNT"
msgstr "КІЛЬКІСТЬ ЗАПУСКІВ"

msgid "Show the number of times you played this game"
msgstr "Показати, скільки разів ви грали в цю гру"

msgid "Show the last date/time you played this game"
msgstr "Показати дату/час останньої гри в цю гру"

msgid "DELETE GAME {GAME.NAME}"
msgstr "ВИДАЛИТИ ГРУ {GAME.NAME}"

msgid "DELETE {ICON.WARNING}"
msgstr "ВИДАЛИТИ {ICON.WARNING}"

msgid ""
"Delete game or screenshot physically on the storage. Allow keeping save, "
"metadata and other related files individually."
msgstr ""
"Фізично видалити гру чи скріншот з носія. Дозволяє окремо зберегти файли "
"збереження, метадані та інші пов'язані файли."

msgid ""
"You cannot delete this game because it is a pre-installed game or it is "
"stored on a read-only device or it is a folder."
msgstr ""
"Неможливо видалити цю гру, оскільки вона попередньо встановлена, "
"зберігається на пристрої лише для читання або є папкою."

msgid ""
"Boot on game is not enabled. To set a game to boot on, enable the "
"appropriate option first."
msgstr ""
"Завантаження з грою не увімкнено. Щоб встановити гру для завантаження, "
"спершу увімкніть відповідний параметр."

msgid "RUN SAVE STATE"
msgstr "ЗАПУСТИТИ ЗБЕРЕЖЕННЯ СТАНУ"

msgid "Select, restore and run game in the selected save state."
msgstr "Виберіть, відновіть і запустіть гру у вибраному збереженні стану."

msgid ""
"No save state has been detected for the currently selected game, or the "
"currently selected item is not a game."
msgstr ""
"Для поточної вибраної гри не виявлено збережень стану, або поточний вибраний "
"елемент не є грою."

msgid "JUMP"
msgstr "ПЕРЕХІД"

msgid "Open the Quick Jump selector."
msgstr "Відкрити селектор швидкого переходу."

msgid "This option allows you to search for other versions of a game."
msgstr "Цей параметр дозволяє шукати інші версії гри."

msgid "This option allows you to search for other games with the same licence."
msgstr "Цей параметр дозволяє шукати інші ігри з тією самою ліцензією."

msgid ""
"Select the way the game list is sorted (alphabetically, by rating, ...)."
msgstr ""
"Виберіть спосіб сортування списку ігор (за алфавітом, за оцінкою тощо)."

msgid "This list has a natural order and can't be sorted."
msgstr "Цей список має природний порядок і не може бути відсортований."

msgid ""
"Select what kind of information you want to see on the right of your "
"gamelist: regions flags, players or game genre."
msgstr ""
"Виберіть, яку інформацію показувати праворуч у списку ігор: прапори "
"регіонів, кількість гравців або жанр гри."

msgid "FLATTEN FOLDERS"
msgstr "СПЛОЩЕНІ ПАПКИ"

msgid "This system is either always flattened or cannot be flattened!"
msgstr "Ця система або завжди сплощена, або не може бути сплощена!"

msgid "You can't hide favorites in the Favorite system!"
msgstr "Ви не можете сховати улюблені в системі улюблених!"

msgid "Display favorites at the top of gamelists."
msgstr "Показувати улюблені на початку списків ігор."

msgid "Favorites are always first in the Favorite system!"
msgstr "Улюблені завжди першими в системі улюблених!"

msgid "Virtual systems cannot be updated. Update real systems instead."
msgstr ""
"Віртуальні системи не можна оновити. Оновіть натомість реальні системи."

msgid "Advanced system settings"
msgstr "Розширені налаштування системи"

msgid "Set advanced settings for system {SYSTEM.NAME}"
msgstr "Встановити розширені налаштування для системи {SYSTEM.NAME}"

msgid "DELETE {GAME.NAME}"
msgstr "ВИДАЛИТИ {GAME.NAME}"

msgid "GAME FILES (ROM, DISK IMAGE, TAPE, ...)"
msgstr "ФАЙЛИ ГРИ (ROM, ОБРАЗ ДИСКА, СТРІЧКА ТОЩО)"

msgid "Number of game files that are to be deleted."
msgstr "Кількість файлів гри, які буде видалено."

msgid ""
"Number of media files (images, video, ...) that will be deleted along with "
"game files."
msgstr ""
"Кількість медіафайлів (зображення, відео тощо), які буде видалено разом із "
"файлами гри."

msgid "There is no media file associated with this game"
msgstr "З цією грою не пов'язано жодного медіафайлу"

msgid ""
"Number of extra files associated with this game: configurations, overrides, "
"patches, ..."
msgstr ""
"Кількість додаткових файлів, пов'язаних із цією грою: конфігурації, "
"перевизначення, патчі тощо"

msgid "There is no extra file associated with this game"
msgstr "З цією грою не пов'язано жодного додаткового файлу"

msgid "Number of save games and save states of {GAME.NAME}"
msgstr "Кількість збережених ігор і збережень стану для {GAME.NAME}"

msgid "There is no save game or save state for this game"
msgstr "Для цієї гри немає ні збереженої гри, ні збереження стану"

msgid "Select files to delete one by one."
msgstr "Виберіть файли для видалення по одному."

msgid "Select game files that are to be deleted one by one."
msgstr "Виберіть файли гри для видалення по одному."

msgid ""
"Select media files (images, video, ...) that will be deleted along with game "
"files."
msgstr ""
"Виберіть медіафайли (зображення, відео тощо), які буде видалено разом із "
"файлами гри."

msgid "Select extra files to delete: configurations, overrides, patches, ..."
msgstr ""
"Виберіть додаткові файли для видалення: конфігурації, перевизначення, патчі "
"тощо"

msgid "Select save games and save states of {GAME.NAME} to delete"
msgstr "Виберіть збережені ігри та збереження стану {GAME.NAME} для видалення"

msgid "Delete all files selected below"
msgstr "Видалити всі вибрані нижче файли"

msgid "Cancel operation. Do not delete anything"
msgstr "Скасувати операцію. Нічого не видаляти"

msgid "Delete all files listed below"
msgstr "Видалити всі перелічені нижче файли"

msgid "SOFTPATCHING {GAME.NAME}"
msgstr "SOFTPATCHING {GAME.NAME}"

msgid "ORIGINAL GAME"
msgstr "ОРИГІНАЛЬНА ГРА"

msgid "PATCHED GAME"
msgstr "ПАТЧЕНА ГРА"

msgid "SELECT PATCH TO APPLY"
msgstr "ВИБРАТИ ПАТЧ ДЛЯ ЗАСТОСУВАННЯ"

msgid "Select the patch to apply."
msgstr "Виберіть патч для застосування"

msgid "INITIATE {GAME.NAME} NETPLAY GAME"
msgstr "РОЗПОЧАТИ ГРУ NETPLAY {GAME.NAME}"

msgid "Launch the game and wait for other player to join"
msgstr "Запустити гру та чекати приєднання іншого гравця"

msgid "Select password other player will have to use to join the game"
