msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Scraping completado! {PROCESSED} xogos procesados.\n"
"\n"
"{SUCCESS} xogo(s) escaneados ou actualizados\n"
"{NOTFOUND} xogo(s) non atopados...\n"
"{ERRORS} erros de petición/descarga\n"
"\n"
"{TEXTINFO} información de texto actualizada\n"
"{IMAGES} imaxes e {VIDEOS} vídeos descargados\n"
"{MEDIASIZE} de contido multimedia gardado"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Acadou a súa cota diaria de peticións de scraping.\n"
"Aínda así, gardáronse todos os scrapes de hoxe.\n"
"\n"
"Comece a facer scraping de novo mañá.\n"
"Non esqueza seleccionar 'actualizar' e non 'escanear todo'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"A súa partición compartida está case chea.\n"
"O scraper detívose automaticamente.\n"
"\n"
"Elimine xogos, contido multimedia e ficheiros non utilizados para facer "
"sitio antes de executar o scraper de novo!"

