msgid ""
"Choose strategy\n"
"\n"
"AUTO: auto apply default patch\n"
"\n"
"LAUNCH LAST: always launch the last one (can be modified in edit game menu)\n"
"\n"
"SELECT: choose manually which patch to apply. Default one or patches in "
"[ROM_NAME]-patches directory\n"
"\n"
"DISABLED: never apply patch"
msgstr ""
"Izvēlieties stratēģiju\n"
"\n"
"AUTOMĀTISKI: automātiski piemēro noklusējuma labojumu\n"
"\n"
"PALAIST PĒDĒJO: vienmēr palaiž pēdējo (var mainīt spēles rediģēšanas "
"izvēlnē)\n"
"\n"
"IZVĒLĒTIES: manuāli izvēlēties, kuru labojumu piemērot. Noklusējuma vai "
"labojumus [ROM_NAME]-patches mapē\n"
"\n"
"IZSLĒGTS: nekad nepiemēro labojumu"

msgid "Set the Super GameBoy mode for GameBoy games."
msgstr "Iestatīt Super GameBoy režīmu GameBoy spēlēm."

