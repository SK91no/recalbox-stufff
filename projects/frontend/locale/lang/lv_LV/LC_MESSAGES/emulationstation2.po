msgid "Balance"
msgstr "Balanss"

msgid ""
"Choose the relative front/rear balance in percentage, between 0% to 100%. "
"Default is 0%."
msgstr ""
"Izvēlieties relatīvo priekšas/aizmugures balansu procentos, no 0% līdz 100%. "
"Noklusējums ir 0%."

msgid "Channels"
msgstr "Kanāli"

msgid "Choose the number of sound channels to use on host. Default is 2."
msgstr ""
"Izvēlieties izmantojamo skaņas kanālu skaitu resursdatorā. Noklusējums ir 2."

msgid "Flip stereo"
msgstr "Apmainīt stereo kanālus"

msgid "Swap the left and right audio channels."
msgstr "Izvēlieties, vai apmainīt kreiso un labo audio kanālu."

msgid "Sound"
msgstr "Skaņa"

msgid ""
"Choose if you disable sound board emulation sound effects. Default is "
"disabled."
msgstr ""
"Izvēlieties, vai izslēgt skaņas kartes emulācijas skaņas efektus. "
"Noklusējums ir izslēgts."

msgid "No Digital Sound Board (DSB)"
msgstr "Bez digitālās skaņas kartes (DSB)"

msgid "Enable or disable Digital Sound Board MPEG music. Default is disabled."
msgstr ""
"Izvēlieties, vai ieslēgt vai izslēgt digitālās skaņas kartes MPEG mūziku. "
"Noklusējums ir izslēgts."

msgid "Sound engine"
msgstr "Skaņas dzinējs"

msgid ""
"Choose between the legacy and new sound engines. Default is MAME engine."
msgstr ""
"Izvēlieties starp veco un jauno skaņas dzinēju. Noklusējums ir MAME dzinējs."

msgid "Supermodel Settings - Video"
msgstr "Supermodel iestatījumi - video"

msgid "Supersampling"
msgstr "Superparaugošana"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr "Superparaugošana. Vēl nav ieslēgta. Noklusējums ir 1."

msgid "Upscale"
msgstr "Palielināšana"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr "Izvēlieties 2D slāņa palielināšanas filtra režīmu. Noklusējums ir 0."

msgid "Disable no throttle"
msgstr "Izslēgt ierobežojuma noņemšanu"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"Izvēlieties, vai vēlaties ieslēgt vai izslēgt 60Hz kadruātruma bloķēšanu. "
"Noklusējums ir izslēgts."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr ""
"Izvēlieties bloķēt vertikālo atsvaidzes biežumu. Noklusējums ir ieslēgts."

msgid "True Hz"
msgstr "Patiess Hz"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr ""
"Izvēlieties izmantot patieso Model 3 atsvaidzes biežumu 57,524 Hz. "
"Noklusējums ir izslēgts."

msgid "Crosshairs"
msgstr "Tēmēkļi"

msgid "Show crosshairs. Default is disabled."
msgstr "Izvēlieties, vai vēlaties rādīt tēmēkļus. Noklusējums ir izslēgts."

msgid "Multi texture"
msgstr "Vairāku tekstūru"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr ""
"Izvēlieties, vai vēlaties izmantot 8 tekstūru kartes dekodēšanai. "
"Noklusējums ir izslēgts."

msgid "Quad rendering"
msgstr "Četrstūru atveidošana"

msgid "Enable proper quad rendering. Default is disabled."
msgstr ""
"Izvēlieties, vai vēlaties ieslēgt pareizu četrstūru atveidošanu. Noklusējums "
"ir izslēgts."

msgid "Supermodel Settings - Core"
msgstr "Supermodel iestatījumi - kodols"

msgid "GPU multi threading"
msgstr "GPU vairākpavedienu apstrāde"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"Iestatiet ON, lai GPU darbotos savā pavedienā, nevis kopīgotu CPU pavedienu. "
"Ātrāk, taču atkarībā no spēles var izraisīt kļūdas."

msgid "PPC Frequency"
msgstr "PPC frekvence"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr "Izvēlieties PowerPC frekvenci MHz, no 1 līdz 1000. Noklusējums ir 70."

msgid "Service button"
msgstr "Servisa poga"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"Izvēlieties ieslēgt vai izslēgt servisa izvēlni spēlēs (L3 = tests, R3 = "
"serviss). Noklusējums ir ieslēgts."

msgid "Log level"
msgstr "Žurnāla līmenis"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr ""
"Izvēlieties informācijas līmeni žurnāla failā. Noklusējums ir informācija."

msgid "Xemu Settings"
msgstr "Xemu iestatījumi"

msgid "Choose the internal resolution of the Xbox."
msgstr "Izvēlieties Xbox iekšējo izšķirtspēju."

msgid "Show menu bar"
msgstr "Rādīt izvēlnes joslu"

msgid "Show the menu bar."
msgstr "Izvēlieties, vai vēlaties rādīt izvēlnes joslu."

msgid "Skip boot animation"
msgstr "Izlaist sāknēšanas animāciju"

msgid "Skip the boot animation."
msgstr "Izvēlieties, vai vēlaties izlaist sāknēšanas animāciju."

msgid "Show notifications"
msgstr "Rādīt paziņojumus"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "Rādīt paziņojumus ekrāna augšējā labajā stūrī."

msgid "Display mode"
msgstr "Displeja režīms"

msgid "Choose how the framebuffer should fit or scale."
msgstr "Izvēlieties, kā kadru buferim jāpielāgojas vai jāmērogojas."

msgid "Aspect Ratio"
msgstr "Malu attiecība"

msgid "Choose the aspect ratio of the Xbox."
msgstr "Izvēlieties Xbox malu attiecību."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - EEPROM vispārīgie iestatījumi"

msgid "Choose the region to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo reģionu."

msgid "Video Standard"
msgstr "Video standarts"

msgid "Choose the video standard to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo video standartu."

msgid "Timezone"
msgstr "Laika josla"

msgid ""
"Choose the timezone to use on Xbox. If your country is using DST, don't take "
"it into account when you are setting this."
msgstr ""
"Izvēlieties Xbox izmantojamo laika joslu. Ja jūsu valstī tiek izmantots "
"vasaras laiks, neņemiet to vērā, iestatot šo."

msgid "Disable automatic daylight saving time"
msgstr "Izslēgt automātisko vasaras laiku"

msgid "Choose if you want to disable automatic daylight saving time."
msgstr "Izvēlieties, vai vēlaties izslēgt automātisko vasaras laiku."

msgid "DVD Region"
msgstr "DVD reģions"

msgid "Choose the DVD region to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo DVD reģionu."

msgid "Language"
msgstr "Valoda"

msgid "Choose the language to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo valodu."

msgid "Xemu - EEPROM Video Settings"
msgstr "Xemu - EEPROM video iestatījumi"

msgid "Enable 480p resolution on Xbox."
msgstr "Izvēlieties ieslēgt 480p izšķirtspēju uz Xbox."

msgid "720p"
msgstr "720p"

msgid "Enable 720p resolution on Xbox."
msgstr "Izvēlieties ieslēgt 720p izšķirtspēju uz Xbox."

msgid "1080i"
msgstr "1080i"

msgid "Enable 1080i resolution on Xbox."
msgstr "Izvēlieties ieslēgt 1080i izšķirtspēju uz Xbox."

msgid "Video Mode"
msgstr "Video režīms"

msgid "Choose the video mode to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo video režīmu."

msgid "Refresh rate"
msgstr "Atsvaidzes biežums"

msgid "Set the refresh rate to 60Hz on Xbox."
msgstr "Izvēlieties ieslēgt 60Hz atsvaidzes biežumu uz Xbox."

msgid "Xemu - EEPROM Audio Settings"
msgstr "Xemu - EEPROM audio iestatījumi"

msgid "Audio Output"
msgstr "Audio izvade"

msgid "Choose the audio output to use on Xbox."
msgstr "Izvēlieties Xbox izmantojamo audio izvadi."

msgid "AC3"
msgstr "AC3"

msgid "Enable Dolby Digital (AC3) on Xbox."
msgstr "Izvēlieties ieslēgt Dolby Digital (AC3) uz Xbox."

msgid "DTS"
msgstr "DTS"

msgid "Enable Dolby Surround (DTS) on Xbox."
msgstr "Izvēlieties ieslēgt Dolby Surround (DTS) uz Xbox."

msgid "SHUTDOWN RECALBOX"
msgstr "IZSLĒGT RECALBOX"

msgid "FAST SHUTDOWN RECALBOX"
msgstr "ĀTRI IZSLĒGT RECALBOX"

msgid "RESTART RECALBOX"
msgstr "RESTARTĒT RECALBOX"

msgid "EDIT NETPLAY PASSWORDS"
msgstr "REDIĢĒT NETPLAY PAROLES"

msgid "PASSWORD #{INDEX}"
msgstr "PAROLE #{INDEX}"

msgid "SHARE USAGE"
msgstr "SHARE IZMANTOJUMS"

msgid "SHARE PARTITION"
msgstr "SHARE NODALĪJUMS"

msgid "Exit the password edition."
msgstr "Iziet no paroles rediģēšanas."

msgid "AVAILABLE STORAGES"
msgstr "PIEEJAMĀS KRĀTUVES"

msgid ""
"Show a list of storage available on your system. Select a storage to access "
"extra information and available actions."
msgstr ""
"Rādīt sistēmā pieejamo krātuvju sarakstu. Izvēlieties krātuvi, lai piekļūtu "
"papildu informācijai un pieejamajām darbībām."

msgid "Get information about {DEVICE.NAME}"
msgstr "Iegūt informāciju par {DEVICE.NAME}"

msgid "FREE SPACE"
msgstr "BRĪVĀ VIETA"

msgid "Display free space available on the device"
msgstr "Rādīt ierīcē pieejamo brīvo vietu"

msgid "STORAGE NAME"
msgstr "KRĀTUVES NOSAUKUMS"

msgid "Display real device name"
msgstr "Rādīt reālo ierīces nosaukumu"

msgid "NETWORK ACCESS"
msgstr "TĪKLA PIEKĻUVE"

msgid "Access to this storage through your local network."
msgstr "Piekļuve šai krātuvei caur jūsu vietējo tīklu."

msgid "FILE SYSTEM"
msgstr "FAILU SISTĒMA"

msgid "FileSystem"
msgstr "Failu sistēma"

msgid "COMPATIBLE WITH RECALBOX?"
msgstr "SADERĪGS AR RECALBOX?"

msgid "Show if this storage is compatible with recalbox"
msgstr "Rādīt, vai šī krātuve ir saderīga ar recalbox"

msgid "INSTALL RECALBOX ROM FOLDERS"
msgstr "INSTALĒT RECALBOX ROM MAPES"

msgid "INITIALIZE!"
msgstr "INICIALIZĒT!"

msgid ""
"Create rom structure so that this storage will be used by Recalbox on next "
"boots."
msgstr ""
"Izveidot rom struktūru, lai šo krātuvi Recalbox izmantotu nākamajās "
"sāknēšanās reizēs."

msgid ""
"You cannot initialize this storage, because either it is already initialized "
"or it is not compatible."
msgstr ""
"Jūs nevarat inicializēt šo krātuvi, jo tā vai nu jau ir inicializēta, vai "
"nav saderīga."

msgid ""
"Select your language. A reboot is required to set this configuration active."
msgstr ""
"Izvēlieties savu valodu. Lai šo konfigurāciju aktivizētu, ir nepieciešama "
"restartēšana."

msgid "TIMEZONE"
msgstr "LAIKA JOSLA"

msgid ""
"Select the timezone used to display dates and times in their local format."
msgstr ""
"Ļauj izvēlēties laika joslu, lai rādītu datumus un laikus to vietējā formātā."

msgid "Shows available update version."
msgstr "Rāda pieejamo atjauninājuma versiju."

msgid "CHECK UPDATES PERIODICALLY"
msgstr "PĀRBAUDĪT ATJAUNINĀJUMUS PERIODISKI"

msgid ""
"Automatically check if an update is available. If so, it notifies you with a "
"message."
msgstr ""
"Automātiski pārbaudīt, vai ir pieejams atjauninājums. Ja jā, tas jūs informē "
"ar ziņojumu."

msgid "Select update type"
msgstr "Izvēlieties atjauninājuma veidu"

msgid "CHECK"
msgstr "PĀRBAUDĪT"

msgid "Check if an update is available, right now."
msgstr "Pārbaudīt, vai atjauninājums ir pieejams tieši tagad."

msgid "SHOW NEW VERSION CHANGELOG"
msgstr "RĀDĪT JAUNĀS VERSIJAS IZMAIŅU ŽURNĀLU"

msgid "SHOW"
msgstr "RĀDĪT"

msgid "Shows available update changelog."
msgstr "Rāda pieejamā atjauninājuma izmaiņu žurnālu."

msgid "DOWNLOAD AND UPDATE MY RECALBOX"
msgstr "LEJUPIELĀDĒT UN ATJAUNINĀT MANU RECALBOX"

msgid "GO!"
msgstr "SĀKT!"

msgid "No update available yet."
msgstr "Vēl nav pieejams atjauninājums."

msgid "RECALBOX RGB DUAL SETTINGS"
msgstr "RECALBOX RGB DUAL IESTATĪJUMI"

msgid ""
"Select Recalbox's interface resolution. 480i is recommended for better "
"details."
msgstr ""
"Izvēlieties Recalbox saskarnes izšķirtspēju. 480i ir ieteicams labākai "
"detalizācijai."

msgid "AVOID INTERLACED MODES"
msgstr "IZVAIRĪTIES NO IESAISTĪTAJIEM REŽĪMIEM"

msgid "Avoid interlaced mode for all games."
msgstr "Izvairīties no iesaistītā režīma visām spēlēm."

msgid "AVOID INTERLACED MODES FOR TATE GAMES ON YOKO AND HANDHELDS"
msgstr ""
"IZVAIRĪTIES NO IESAISTĪTAJIEM REŽĪMIEM TATE SPĒLĒM YOKO UN ROKAS IERĪCĒS"

msgid "31 KHZ"
msgstr "31 KHZ"

msgid "You're not in 31khz mode"
msgstr "Jūs neatrodaties 31khz režīmā"

msgid "RUN DEMOS AND AUTOBOOT GAMES IN 240P@120"
msgstr "PALAIST DEMO UN AUTOMĀTISKAS SĀKNĒŠANAS SPĒLES 240P@120"

msgid ""
"Run the demos and autoboot games in 240p resolution on your 31kHz monitor."
msgstr ""
"Palaist demo un automātiskās sāknēšanas spēles 240p izšķirtspējā uz jūsu "
"31kHz monitora."

msgid "EXPERIMENTAL"
msgstr "EKSPERIMENTĀLS"

msgid "RECALBOX RGB JAMMA SETTINGS"
msgstr "RECALBOX RGB JAMMA IESTATĪJUMI"

msgid "Recalbox RGB Jamma options and configuration."
msgstr "Recalbox RGB Jamma opcijas un konfigurācija."

msgid ""
"Avoid interlaced mode for tate (vertical) games on yoko (horizontal) "
"screens, and for handheld consoles."
msgstr ""
"Izvairīties no iesaistītā režīma tate (vertikālām) spēlēm yoko "
"(horizontālos) ekrānos un rokas konsolēs."

msgid "JAMMA OPTIONS"
msgstr "JAMMA OPCIJAS"

msgid "START + UP and DOWN change the volume in frontend and in games."
msgstr "START + AUGŠUP un LEJUP maina skaļumu saskarnē un spēlēs."

msgid "Load the dual joystick configuration on compatible games!"
msgstr "Ielādēt divkāršo vadības sviru konfigurāciju saderīgās spēlēs!"

msgid "Reset all previous options to their default values"
msgstr "Atiestatīt visas iepriekšējās opcijas uz to noklusējuma vērtībām"

msgid "RECALBOX RGB DUAL 2 SETTINGS"
msgstr "RECALBOX RGB DUAL 2 IESTATĪJUMI"

msgid "Recalbox RGB Dual 2 options and configuration."
msgstr "Recalbox RGB Dual 2 opcijas un konfigurācija."

msgid "Select Recalbox's interface resolution."
msgstr "Izvēlieties Recalbox saskarnes izšķirtspēju."

msgid "FORCE COMPOSITE"
msgstr "PIESPIEST KOMPOZĪTO"

msgid "Force composite output (On SCART, RCA and JACK)."
msgstr "Piespiest kompozīto izvadi (uz SCART, RCA un JACK)."

msgid "COMPOSITE SIGNAL STANDARD"
msgstr "KOMPOZĪTĀ SIGNĀLA STANDARTS"

msgid ""
"When using composite, selects the composite signal standard for your region."
msgstr ""
"Izmantojot kompozīto, izvēlas jūsu reģiona kompozītā signāla standartu."

msgid "16/9 CRT TV"
msgstr "16/9 CRT TV"

msgid "Activate if you have a 16/9 CRT TV."
msgstr "Aktivizējiet, ja jums ir 16/9 CRT TV."

msgid "SELECT SIGNAL (RGB/COMPOSITE) AT LAUNCH"
msgstr "IZVĒLIETIES SIGNĀLU (RGB/KOMPOZĪTAIS) PALAIŠANAS LAIKĀ"

msgid ""
"Let you choose between RGB Signal and composite signal at launch, for "
"compatible systems."
msgstr ""
"Ļauj izvēlēties starp RGB signālu un kompozīto signālu palaišanas laikā "
"saderīgām sistēmām."

msgid "DIP SWITCHES"
msgstr "DIP SLĒDŽI"

msgid "FORCED 50HZ DIP SWITCH"
msgstr "PIESPIESTS 50HZ DIP SLĒDZIS"

msgid "FORCED 31kHz/MULTISYNC DIP SWITCH"
msgstr "PIESPIESTS 31kHz/MULTISYNC DIP SLĒDZIS"

msgid "FORCED COMPOSITE DIP SWITCH"
msgstr "PIESPIESTS KOMPOZĪTAIS DIP SLĒDZIS"

msgid "IN-GAME SETTINGS"
msgstr "SPĒLES IESTATĪJUMI"

msgid "FEATURES"
msgstr "FUNKCIJAS"

msgid "GAMES RENDERING"
msgstr "SPĒĻU ATVEIDOŠANA"

msgid "AUTO BLITTER (FBNEO/MAME)"
msgstr "AUTOMĀTISKAIS BLITTERS (FBNEO/MAME)"

msgid ""
"Enables automatic blitter and CPU settings for fbneo and mame games. Can "
"enhance emulation precision on games like Cave."
msgstr ""
"Ieslēdz automātisko blitter un CPU iestatījumus fbneo un mame spēlēm. Var "
"uzlabot emulācijas precizitāti tādās spēlēs kā Cave."

msgid "SYSTEM-LISTS & GAMELISTS SETTINGS"
msgstr "SISTĒMU SARAKSTU UN SPĒĻU SARAKSTU IESTATĪJUMI"

msgid "Configure system and gamelist filters and options"
msgstr "Konfigurēt sistēmas un spēļu saraksta filtrus un opcijas"

msgid "SYSTEM LISTS"
msgstr "SISTĒMU SARAKSTI"

msgid "SHOW SYSTEMS"
msgstr "RĀDĪT SISTĒMAS"

msgid "Show or hide systems individually"
msgstr "Rādīt vai slēpt sistēmas individuāli"

msgid "GAMES"
msgstr "SPĒLES"

msgid "ENABLE ADDING/REMOVING FAVORITES"
msgstr "IESLĒGT IECIENĪTO PIEVIENOŠANU/NOŅEMŠANU"

msgid ""
"Enable or disable adding/removing favorites in gamelist, search and other "
"various places."
msgstr ""
"Ieslēgt vai izslēgt iecienīto pievienošanu/noņemšanu spēļu sarakstā, "
"meklēšanā un citās vietās."

msgid ""
"Show only favorites. May hide all systems with no favorite at all until you "
"switch off this option."
msgstr ""
"Rādīt tikai iecienītos. Var slēpt visas sistēmas bez iecienītajiem, kamēr "
"neizslēdzat šo opciju."

msgid "Display all favorites at the top of the game list."
msgstr "Rādīt visus iecienītos spēļu saraksta augšpusē."

msgid "Force hidden game to show in gamelists."
msgstr "Piespiest slēpto spēli rādīties spēļu sarakstos."

msgid "SHOW MAHJONG AND CASINO GAMES"
msgstr "RĀDĪT MAHJONG UN KAZINO SPĒLES"

msgid ""
"Show or hide asian casino and mahjong games. You must scrape your game for "
"this option to work."
msgstr ""
"Rādīt vai slēpt āzijas kazino un mahjong spēles. Šai opcijai jāstrādā, jums "
"jāiegūst spēles dati."

msgid "SHOW ADULT GAMES"
msgstr "RĀDĪT PIEAUGUŠO SPĒLES"

msgid ""
"Show or hide adult games. You must scrape your game for this option to work."
msgstr ""
"Rādīt vai slēpt pieaugušo spēles. Šai opcijai jāstrādā, jums jāiegūst spēles "
"dati."

msgid "SHOW PREINSTALLED GAMES"
msgstr "RĀDĪT IEPRIEKŠ INSTALĒTĀS SPĒLES"

msgid ""
"Show or hide games distributed with Recalbox. But you don't want to do this: "
"they are all excellent games!"
msgstr ""
"Rādīt vai slēpt spēles, kas izplatītas ar Recalbox. Bet jūs to nevēlaties "
"darīt: tās visas ir izcilas spēles!"

msgid "Show only games playable with 3 or more players"
msgstr "Rādīt tikai spēles, kas spēlējamas ar 3 vai vairāk spēlētājiem"

msgid "SHOW ONLY YOKO (HORIZONTAL) GAMES"
msgstr "RĀDĪT TIKAI YOKO (HORIZONTĀLĀS) SPĒLES"

msgid ""
"Show only YOKO (horizontal) games. Mutually exclusive with the option to "
"show only TATE games."
msgstr ""
"Rādīt tikai YOKO (horizontālās) spēles. Savstarpēji izslēdz opciju rādīt "
"tikai TATE spēles."

msgid "SHOW ONLY TATE (VERTICAL) GAMES"
msgstr "RĀDĪT TIKAI TATE (VERTIKĀLĀS) SPĒLES"

msgid ""
"Show only TATE (vertical) games. Mutually exclusive with the option to show "
"only YOKO games."
msgstr ""
"Rādīt tikai TATE (vertikālās) spēles. Savstarpēji izslēdz opciju rādīt tikai "
"YOKO spēles."

msgid "SHOW ROMS MARKED AS NON-GAMES"
msgstr "RĀDĪT ROM FAILUS, KAS ATZĪMĒTI KĀ NE-SPĒLES"

msgid ""
"Show or hide roms that are explicitly marked as non-game (application, "
"utilities, ...). You must scrape your game for this option to work."
msgstr ""
"Rādīt vai slēpt rom failus, kas skaidri atzīmēti kā ne-spēle (lietotne, "
"rīki, ...). Šai opcijai jāstrādā, jums jāiegūst spēles dati."

msgid "ENABLE ONE GAME ONE ROM (1G1R)"
msgstr "IESLĒGT VIENA SPĒLE VIENS ROM (1G1R)"

msgid "Display only one rom|disk image for a game from your preferred region."
msgstr "Rādīt tikai vienu rom|diska attēlu spēlei no jūsu vēlamā reģiona."

msgid "PRIORITY REGION (1G1R)"
msgstr "PRIORITĀTES REĢIONS (1G1R)"

msgid "Choose your preferred region for 1G1R filtering."
msgstr "Izvēlieties savu vēlamo reģionu 1G1R filtrēšanai"

msgid "SECOND PRIORITY REGION (1G1R)"
msgstr "OTRAIS PRIORITĀTES REĢIONS (1G1R)"

msgid "Choose your second preferred region for 1G1R filtering."
msgstr "Izvēlieties savu otro vēlamo reģionu 1G1R filtrēšanai"

msgid "THIRD PRIORITY REGIONS (1G1R)"
msgstr "TREŠIE PRIORITĀTES REĢIONI (1G1R)"

msgid ""
"Choose your preferred regions priority when there is no match with first and "
"second regions"
msgstr ""
"Izvēlieties savu vēlamo reģionu prioritāti, ja nav atbilstības ar pirmo un "
"otro reģionu"

msgid "ARCADE SYSTEMS"
msgstr "ARCADE SISTĒMAS"

msgid "ENABLE AGGREGATED ARCADE SYSTEM"
msgstr "IESLĒGT APVIENOTO ARCADE SISTĒMU"

msgid "Available only when aggregated arcade system is on"
msgstr "Pieejams tikai tad, kad apvienotā arcade sistēma ir ieslēgta"

msgid ""
"Select manufacturer virtual system to show in the system view (like "
"CPS1/2/3, SEGA, TAITO, ...)"
msgstr ""
"Izvēlieties ražotāja virtuālo sistēmu, ko rādīt sistēmu skatā (piemēram, "
"CPS1/2/3, SEGA, TAITO, ...)"

msgid "ARCADE GAMES"
msgstr "ARCADE SPĒLES"

msgid ""
"Always use arcade names from official databases. Overwrites manual edits and "
"scraper results."
msgstr ""
"Vienmēr izmantot arcade nosaukumus no oficiālajām datubāzēm. Pārrakstīt "
"manuālo rediģēšanu un datu ieguves rezultātus."

msgid "USER INTERFACE SETTINGS"
