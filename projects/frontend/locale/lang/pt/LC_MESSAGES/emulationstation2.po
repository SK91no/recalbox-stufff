msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Scraping completo! {PROCESSED} jogos processados.\n"
"\n"
"{SUCCESS} jogo(s) obtido(s) ou actualizado(s)\n"
"{NOTFOUND} jogo(s) não encontrado(s)...\n"
"{ERRORS} erros de pedido/descarregamento\n"
"\n"
"{TEXTINFO} informações de texto actualizadas\n"
"{IMAGES} imagens e {VIDEOS} vídeos descarregados\n"
"{MEDIASIZE} de multimédia guardados"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Atingiu a sua quota diária de pedidos de scraping.\n"
"Todos os scrapes de hoje foram guardados de qualquer forma.\n"
"\n"
"Recomece o scraping amanhã.\n"
"Não se esqueça de seleccionar 'actualizar' e não 'obter tudo'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"A sua partição share está quase cheia.\n"
"O scraper parou automaticamente.\n"
"\n"
"Remova jogos, multimédia e ficheiros não utilizados para libertar espaço "
"antes de executar o scraper novamente!"

