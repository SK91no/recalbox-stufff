msgstr "RESOLUÇÕES ESPECÍFICAS DO SISTEMA"

msgid "FOR {SYSTEM.NAME}"
msgstr "PARA {SYSTEM.NAME}"

msgid "Select the resolution used by the emulator '{SYSTEM.NAME}'."
msgstr "Seleccione a resolução utilizada pelo emulador '{SYSTEM.NAME}'."

msgid "Set options for system {SYSTEM.NAME}"
msgstr "Definir opções para o sistema {SYSTEM.NAME}"

