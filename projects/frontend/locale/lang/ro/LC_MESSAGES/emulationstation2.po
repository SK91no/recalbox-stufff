msgid ""
"Scraping complete! {PROCESSED} games processed.\n"
"\n"
"{SUCCESS} game(s) scraped or updated\n"
"{NOTFOUND} game(s) not found...\n"
"{ERRORS} request/download errors\n"
"\n"
"{TEXTINFO} Text information updated\n"
"{IMAGES} images and {VIDEOS} videos downloaded\n"
"{MEDIASIZE} of media saved"
msgstr ""
"Verificare finalizata! {PROCESSED} jocuri procesate.\n"
"\n"
"{SUCCESS} joc(uri) verificat(e) sau actualizat(e)\n"
"{NOTFOUND} joc(uri) negasit(e)...\n"
"{ERRORS} erori de cerere/descarcare\n"
"\n"
"{TEXTINFO} informatii text actualizate\n"
"{IMAGES} imagini si {VIDEOS} videoclipuri descarcate\n"
"{MEDIASIZE} de fisiere media salvate"

msgid ""
"You reached your daily quota of scraping request.\n"
"All your today's scrapes have been saved anyway.\n"
"\n"
"Start scraping again tomorrow.\n"
"Dont forget to select 'update' and not 'scrape all'"
msgstr ""
"Ati atins limita zilnica de cereri de verificare.\n"
"Toate verificarile de azi au fost totusi salvate.\n"
"\n"
"Reincepeti verificarea maine.\n"
"Nu uitati sa selectati 'actualizeaza' si nu 'verifica tot'"

msgid ""
"Your share partition is almost full.\n"
"The scraper stopped automatically.\n"
"\n"
"Remove unused games, media, files to make room before running the scraper "
"again!"
msgstr ""
"Partitia share este aproape plina.\n"
"Verificatorul s-a oprit automat.\n"
"\n"
"Eliminati jocurile, fisierele media si fisierele nefolosite pentru a face "
"loc inainte de a rula din nou verificatorul!"

