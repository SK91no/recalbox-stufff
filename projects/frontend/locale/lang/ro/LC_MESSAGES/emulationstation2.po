msgstr ""
"Selectati fisierele suplimentare de sters: configuratii, suprascrieri, patch-"
"uri, ..."

msgid "Select save games and save states of {GAME.NAME} to delete"
msgstr "Selectati jocurile salvate si starile salvate ale {GAME.NAME} de sters"

