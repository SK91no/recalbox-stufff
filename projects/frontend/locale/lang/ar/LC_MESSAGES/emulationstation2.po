msgstr "اختر تخطيط عرض قائمة الألعاب من هذا المظهر."

msgid "THEME'S GAMECLIPVIEW LAYOUT"
msgstr "تخطيط عرض مقاطع الألعاب للمظهر"

msgid "Select gameclip view layout from this theme."
msgstr "اختر تخطيط عرض مقاطع الألعاب من هذا المظهر."

msgid "Libretro HatariB Settings"
msgstr "إعدادات Libretro HatariB"

msgid "Machine Type"
msgstr "نوع الجهاز"

msgid ""
"Choose the machine model to emulate. STE is a good choice for most games."
msgstr "اختر نموذج الجهاز للمحاكاة. STE خيار جيد لمعظم الألعاب."

msgid "Memory Size"
msgstr "حجم الذاكرة"

msgid "Select the amount of memory. 1 MB is enough for gaming."
msgstr "اختر حجم الذاكرة. 1 ميغابايت كافٍ للألعاب."

msgid "Fast Floppy"
msgstr "قرص مرن سريع"

msgid ""
"Set ON to accelerate the floppy disc emulation. May cause some games to fail!"
msgstr "اضبطه على ON لتسريع محاكاة القرص المرن. قد يتسبب في فشل بعض الألعاب!"

msgid "Libretro Fuse Settings"
msgstr "إعدادات Libretro Fuse"

msgid ""
"Choose the Sinclair machine (or clone) to emulate. The original Spectrum "
"128k is a good way to start."
msgstr ""
"اختر جهاز Sinclair (أو نسخة منه) للمحاكاة. Spectrum 128k الأصلي نقطة بداية "
"جيدة."

msgid "Set ON to accelerate the tape emulation. May cause some games to fail!"
msgstr "اضبطه على ON لتسريع محاكاة الشريط. قد يتسبب في فشل بعض الألعاب!"

msgid "Libretro PX68K Settings"
msgstr "إعدادات Libretro PX68K"

msgid "Model/CPU Speed"
msgstr "النموذج/سرعة المعالج"

msgid ""
"Choose the CPU frequency to emulate. 10Mhz is the basic machine and will "
"work for most of the games."
msgstr ""
"اختر تردد المعالج للمحاكاة. 10 ميغاهرتز هو الجهاز الأساسي وسيعمل مع معظم "
"الألعاب."

msgid "Memory Size (in MB)"
msgstr "حجم الذاكرة (بالميغابايت)"

msgid ""
"Choose the amount of memory available. Most of the games will work with 2MB "
"but some games may require 4MB."
msgstr ""
"اختر حجم الذاكرة المتاحة. معظم الألعاب ستعمل بـ 2 ميغابايت لكن بعضها قد "
"يحتاج 4 ميغابايت."

msgid "Dolphin / Dolphin-GUI Settings"
msgstr "إعدادات Dolphin / Dolphin-GUI"

msgid "Resolution"
msgstr "الدقة"

msgid "Choose the internal resolution."
msgstr "اختر الدقة الداخلية."

msgid "Dual CPU"
msgstr "معالج مزدوج"

msgid ""
"May improve performance on a few rare games, at the expense of others that "
"are incompatible."
msgstr ""
"فعّل هذا الخيار إذا كان قد يحسّن أداء بعض الألعاب النادرة، على حساب ألعاب أخرى "
"غير متوافقة."

msgid "Sync GPU"
msgstr "مزامنة GPU"

msgid "Enable this speed hack for dual core mode to fix some glitches."
msgstr "فعّل هذه الخدعة لوضع النواة المزدوجة لإصلاح بعض الأعطال."

msgid "Anti-aliasing"
msgstr "تنعيم الحواف"

msgid "Enable or disable anti-aliasing."
msgstr "اختر تفعيل أو تعطيل تنعيم الحواف."

msgid "VSync"
msgstr "تزامن عمودي"

msgid "Enable or disable vsync."
msgstr "فعّل هذا الخيار لتفعيل أو تعطيل التزامن العمودي."

msgid "Real Gamecube controllers"
msgstr "أدوات تحكم GameCube الحقيقية"

msgid "Enable this option to play with real GameCube controllers."
msgstr "فعّل هذا الخيار للعب بأدوات تحكم GameCube الحقيقية."

msgid "Real Wiimotes"
msgstr "Wiimotes الحقيقية"

msgid "Enable this option to play with real Wiimotes."
msgstr "فعّل هذا الخيار للعب بـ Wiimotes الحقيقية."

msgid "Emulated Wiimote"
msgstr "Wiimote محاكاة"

msgid "Enable this option to play with emulated Wiimotes."
msgstr "فعّل للعب بـ Wiimotes المحاكاة."

msgid "Dolphinbar position"
msgstr "موضع شريط Dolphin"

msgid "Choose the position of the Dolphin bar."
msgstr "اختر موضع شريط Dolphin."

msgid "Show on-screen information"
msgstr "إظهار المعلومات على الشاشة"

msgid "PPSSPP Settings"
msgstr "إعدادات PPSSPP"

msgid "Choose the internal resolution of the PSP."
msgstr "اختر الدقة الداخلية للـ PSP."

msgid "SCUMMVM Settings"
msgstr "إعدادات SCUMMVM"

msgid "Subtitles"
msgstr "ترجمة"

msgid "Enable subtitles"
msgstr "تفعيل الترجمة"

msgid "Supermodel Settings - Controllers"
msgstr "إعدادات Supermodel - أدوات التحكم"

msgid "Sensitivity"
msgstr "الحساسية"

msgid ""
"Choose the rate at which analog control values increase/decrease when "
"controlled by a key, between 1 to 100. Default is 25."
msgstr ""
"اختر معدل زيادة/نقصان قيم التحكم التناظري عند التحكم بمفتاح، بين 1 و100. "
"الافتراضي 25."

msgid "Saturation"
msgstr "التشبع"

msgid ""
"Choose the position at which the joystick is interpreted as being in its "
"most extreme position, between 0% to 200%. Default is 100%."
msgstr ""
"اختر الموضع الذي يُفسَّر فيه ذراع التحكم على أنه في أقصى موضع، بين 0% و200%. "
"الافتراضي 100%."

msgid "Deadzone"
msgstr "منطقة الحياد"

msgid "Choose the dead zone as a percentage, between 0% to 99%. Default is 2%."
msgstr "اختر منطقة الحياد كنسبة مئوية، بين 0% و99%. الافتراضي 2%."

msgid "Supermodel Settings - Audio"
msgstr "إعدادات Supermodel - الصوت"

msgid "Sound volume"
msgstr "مستوى الصوت"

msgid ""
"Choose the master volume in percentage, between 0% to 100%. Default is 100%."
msgstr "اختر مستوى الصوت الرئيسي كنسبة مئوية، بين 0% و100%. الافتراضي 100%."

msgid "Music volume"
msgstr "مستوى صوت الموسيقى"

msgid ""
"Choose the music volume in percentage, between 0% to 100%. Default is 100%."
msgstr "اختر مستوى صوت الموسيقى كنسبة مئوية، بين 0% و100%. الافتراضي 100%."

msgid "Balance"
msgstr "التوازن"

msgid ""
"Choose the relative front/rear balance in percentage, between 0% to 100%. "
"Default is 0%."
msgstr ""
"اختر التوازن النسبي الأمامي/الخلفي كنسبة مئوية، بين 0% و100%. الافتراضي 0%."

msgid "Channels"
msgstr "القنوات"

msgid "Choose the number of sound channels to use on host. Default is 2."
msgstr "اختر عدد قنوات الصوت للاستخدام على المضيف. الافتراضي 2."

msgid "Flip stereo"
msgstr "عكس الستيريو"

msgid "Swap the left and right audio channels."
msgstr "اختر ما إذا كنت تريد تبديل قنوات الصوت اليسرى واليمنى."

msgid "Sound"
msgstr "الصوت"

msgid ""
"Choose if you disable sound board emulation sound effects. Default is "
"disabled."
msgstr ""
"اختر ما إذا كنت تريد تعطيل مؤثرات صوت محاكاة لوحة الصوت. الافتراضي معطّل."

msgid "No Digital Sound Board (DSB)"
msgstr "بدون لوحة صوت رقمية (DSB)"

msgid "Enable or disable Digital Sound Board MPEG music. Default is disabled."
msgstr "اختر تفعيل أو تعطيل موسيقى MPEG للوحة الصوت الرقمية. الافتراضي معطّل."

msgid "Sound engine"
msgstr "محرك الصوت"

msgid ""
"Choose between the legacy and new sound engines. Default is MAME engine."
msgstr "اختر بين محرك الصوت القديم والجديد. الافتراضي محرك MAME."

msgid "Supermodel Settings - Video"
msgstr "إعدادات Supermodel - الفيديو"

msgid "Supersampling"
msgstr "أخذ عينات فائق"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr "أخذ عينات فائق. غير مُفعَّل بعد. الافتراضي 1."

msgid "Upscale"
msgstr "رفع الدقة"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr "اختر وضع فلتر رفع دقة الطبقة ثنائية الأبعاد. الافتراضي 0."

msgid "Disable no throttle"
msgstr "تعطيل الحد الأقصى للسرعة"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"اختر ما إذا كنت تفضل تفعيل أو تعطيل قفل معدل 60 إطاراً في الثانية. الافتراضي "
"معطّل."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr "اختر قفل معدل التحديث العمودي. الافتراضي مُفعَّل."

msgid "True Hz"
msgstr "معدل حقيقي"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr "اختر استخدام معدل تحديث Model 3 الحقيقي 57,524 هرتز. الافتراضي معطّل."

msgid "Crosshairs"
msgstr "تقاطع الأهداف"

msgid "Show crosshairs. Default is disabled."
msgstr "اختر ما إذا كنت تفضل إظهار تقاطع الأهداف. الافتراضي معطّل."

msgid "Multi texture"
msgstr "نسيج متعدد"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr "اختر ما إذا كنت تفضل استخدام 8 خرائط نسيج للفك. الافتراضي معطّل."

msgid "Quad rendering"
msgstr "عرض رباعي"

msgid "Enable proper quad rendering. Default is disabled."
msgstr "اختر ما إذا كنت تفضل تفعيل العرض الرباعي الصحيح. الافتراضي معطّل."

msgid "Supermodel Settings - Core"
msgstr "إعدادات Supermodel - النواة"

msgid "GPU multi threading"
msgstr "معالجة GPU متعددة الخيوط"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"اضبطه على ON لتشغيل GPU في خيط خاص به بدلاً من مشاركة خيط المعالج CPU. أسرع "
"لكن قد يسبب أخطاء حسب اللعبة."

msgid "PPC Frequency"
msgstr "تردد PPC"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr "اختر تردد PowerPC بالميغاهرتز، بين 1 و1000. الافتراضي 70."

msgid "Service button"
msgstr "زر الخدمة"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"اختر تفعيل أو تعطيل قائمة الخدمة في الألعاب (L3 = اختبار، R3 = خدمة). "
"الافتراضي مُفعَّل."

msgid "Log level"
msgstr "مستوى السجل"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr "اختر مستوى المعلومات في ملف السجل. الافتراضي معلومات."

msgid "Xemu Settings"
msgstr "إعدادات Xemu"

msgid "Choose the internal resolution of the Xbox."
msgstr "اختر الدقة الداخلية لجهاز Xbox."

msgid "Show menu bar"
msgstr "إظهار شريط القائمة"

msgid "Show the menu bar."
msgstr "اختر ما إذا كنت تريد إظهار شريط القائمة."

msgid "Skip boot animation"
msgstr "تخطي رسوم الإقلاع"

msgid "Skip the boot animation."
msgstr "اختر ما إذا كنت تريد تخطي رسوم الإقلاع."

msgid "Show notifications"
msgstr "إظهار الإشعارات"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "إظهار الإشعارات المعروضة في الزاوية العلوية اليمنى من الشاشة."

msgid "Display mode"
msgstr "وضع العرض"

msgid "Choose how the framebuffer should fit or scale."
msgstr "اختر كيفية ملاءمة أو تحجيم المخزن المؤقت للإطارات."

msgid "Aspect Ratio"
msgstr "نسبة الأبعاد"

msgid "Choose the aspect ratio of the Xbox."
msgstr "اختر نسبة أبعاد Xbox."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - الإعدادات العامة لـ EEPROM"

msgid "Choose the region to use on Xbox."
msgstr "اختر المنطقة للاستخدام على Xbox."

msgid "Video Standard"
msgstr "معيار الفيديو"

msgid "Choose the video standard to use on Xbox."
msgstr "اختر معيار الفيديو للاستخدام على Xbox."

msgid "Timezone"
msgstr "المنطقة الزمنية"

msgid ""
"Choose the timezone to use on Xbox. If your country is using DST, don't take "
"it into account when you are setting this."
msgstr ""
"اختر المنطقة الزمنية للاستخدام على Xbox. إذا كان بلدك يستخدم التوقيت الصيفي، "
"لا تأخذه بعين الاعتبار عند الضبط."

msgid "Disable automatic daylight saving time"
msgstr "تعطيل التوقيت الصيفي التلقائي"

msgid "Choose if you want to disable automatic daylight saving time."
msgstr "اختر ما إذا كنت تريد تعطيل التوقيت الصيفي التلقائي."

msgid "DVD Region"
msgstr "منطقة DVD"

msgid "Choose the DVD region to use on Xbox."
msgstr "اختر منطقة DVD للاستخدام على Xbox."

msgid "Language"
msgstr "اللغة"

msgid "Choose the language to use on Xbox."
msgstr "اختر اللغة للاستخدام على Xbox."

msgid "Xemu - EEPROM Video Settings"
msgstr "Xemu - إعدادات فيديو EEPROM"

msgid "Enable 480p resolution on Xbox."
msgstr "اختر تفعيل دقة 480p على Xbox."

msgid "720p"
msgstr "720p"

msgid "Enable 720p resolution on Xbox."
msgstr "اختر تفعيل دقة 720p على Xbox."

msgid "1080i"
msgstr "1080i"

msgid "Enable 1080i resolution on Xbox."
msgstr "اختر تفعيل دقة 1080i على Xbox."

msgid "Video Mode"
msgstr "وضع الفيديو"

msgid "Choose the video mode to use on Xbox."
msgstr "اختر وضع الفيديو للاستخدام على Xbox."

msgid "Refresh rate"
msgstr "معدل التحديث"

msgid "Set the refresh rate to 60Hz on Xbox."
msgstr "اختر تفعيل معدل التحديث إلى 60 هرتز على Xbox."

msgid "Xemu - EEPROM Audio Settings"
msgstr "Xemu - إعدادات صوت EEPROM"

msgid "Audio Output"
msgstr "مخرج الصوت"

msgid "Choose the audio output to use on Xbox."
msgstr "اختر مخرج الصوت للاستخدام على Xbox."

msgid "AC3"
msgstr "AC3"

msgid "Enable Dolby Digital (AC3) on Xbox."
msgstr "اختر تفعيل Dolby Digital (AC3) على Xbox."

msgid "DTS"
msgstr "DTS"

msgid "Enable Dolby Surround (DTS) on Xbox."
msgstr "اختر تفعيل Dolby Surround (DTS) على Xbox."

msgid "SHUTDOWN RECALBOX"
msgstr "إيقاف تشغيل RECALBOX"

msgid "FAST SHUTDOWN RECALBOX"
msgstr "إيقاف تشغيل RECALBOX بسرعة"

msgid "RESTART RECALBOX"
msgstr "إعادة تشغيل RECALBOX"

msgid "EDIT NETPLAY PASSWORDS"
msgstr "تعديل كلمات مرور Netplay"

msgid "PASSWORD #{INDEX}"
msgstr "كلمة المرور #{INDEX}"

msgid "SHARE USAGE"
msgstr "استخدام المشاركة"

msgid "SHARE PARTITION"
msgstr "قسم المشاركة"

msgid "Exit the password edition."
msgstr "الخروج من تعديل كلمة المرور."

msgid "AVAILABLE STORAGES"
msgstr "وحدات التخزين المتاحة"

msgid ""
"Show a list of storage available on your system. Select a storage to access "
"extra information and available actions."
msgstr ""
"عرض قائمة بوحدات التخزين المتاحة على نظامك. اختر وحدة تخزين للوصول إلى "
"معلومات إضافية والإجراءات المتاحة."

msgid "Get information about {DEVICE.NAME}"
msgstr "الحصول على معلومات حول {DEVICE.NAME}"

msgid "FREE SPACE"
msgstr "المساحة الحرة"

msgid "Display free space available on the device"
msgstr "عرض المساحة الحرة المتاحة على الجهاز"

msgid "STORAGE NAME"
msgstr "اسم وحدة التخزين"

msgid "Display real device name"
msgstr "عرض اسم الجهاز الحقيقي"

msgid "NETWORK ACCESS"
msgstr "الوصول عبر الشبكة"

msgid "Access to this storage through your local network."
msgstr "الوصول إلى وحدة التخزين هذه عبر شبكتك المحلية."

msgid "FILE SYSTEM"
msgstr "نظام الملفات"

msgid "FileSystem"
msgstr "نظام الملفات"

msgid "COMPATIBLE WITH RECALBOX?"
msgstr "متوافق مع RECALBOX؟"

msgid "Show if this storage is compatible with recalbox"
msgstr "إظهار ما إذا كانت وحدة التخزين هذه متوافقة مع Recalbox"

msgid "INSTALL RECALBOX ROM FOLDERS"
msgstr "تثبيت مجلدات ROM لـ RECALBOX"

msgid "INITIALIZE!"
msgstr "تهيئة!"

msgid ""
"Create rom structure so that this storage will be used by Recalbox on next "
"boots."
msgstr ""
"إنشاء هيكل ROM حتى تُستخدم وحدة التخزين هذه بواسطة Recalbox عند الإقلاع "
"التالي."

msgid ""
"You cannot initialize this storage, because either it is already initialized "
"or it is not compatible."
msgstr ""
"لا يمكنك تهيئة وحدة التخزين هذه، لأنها إما مُهيَّأة بالفعل أو غير متوافقة."

msgid ""
"Select your language. A reboot is required to set this configuration active."
msgstr "اختر لغتك. تلزم إعادة التشغيل لتفعيل هذا الإعداد."

msgid "TIMEZONE"
msgstr "المنطقة الزمنية"

msgid ""
"Select the timezone used to display dates and times in their local format."
msgstr "يتيح اختيار المنطقة الزمنية لعرض التواريخ والأوقات بتنسيقها المحلي."

msgid "Shows available update version."
msgstr "يعرض إصدار التحديث المتاح."

msgid "CHECK UPDATES PERIODICALLY"
msgstr "التحقق من التحديثات بشكل دوري"

msgid ""
"Automatically check if an update is available. If so, it notifies you with a "
"message."
msgstr "التحقق تلقائياً من توفر تحديث. إذا كان متاحاً، سيُرسل لك إشعاراً برسالة."

msgid "Select update type"
msgstr "اختر نوع التحديث"

msgid "CHECK"
msgstr "فحص"

msgid "Check if an update is available, right now."
msgstr "التحقق الآن من توفر تحديث."

msgid "SHOW NEW VERSION CHANGELOG"
msgstr "عرض سجل تغييرات الإصدار الجديد"

msgid "SHOW"
msgstr "عرض"

msgid "Shows available update changelog."
msgstr "يعرض سجل التغييرات للتحديث المتاح."

msgid "DOWNLOAD AND UPDATE MY RECALBOX"
msgstr "تنزيل وتحديث RECALBOX"

msgid "GO!"
msgstr "انطلق!"

msgid "No update available yet."
msgstr "لا يوجد تحديث متاح بعد."

msgid "RECALBOX RGB DUAL SETTINGS"
msgstr "إعدادات Recalbox RGB Dual"

msgid ""
"Select Recalbox's interface resolution. 480i is recommended for better "
"details."
msgstr "اختر دقة واجهة Recalbox. يُنصح بـ 480i للحصول على تفاصيل أفضل."

msgid "AVOID INTERLACED MODES"
msgstr "تجنب الأوضاع المتداخلة"

msgid "Avoid interlaced mode for all games."
msgstr "تجنب الوضع المتداخل لجميع الألعاب."

msgid "AVOID INTERLACED MODES FOR TATE GAMES ON YOKO AND HANDHELDS"
msgstr "تجنب الأوضاع المتداخلة لألعاب TATE على YOKO والمحمول"

msgid "31 KHZ"
msgstr "31 كيلوهرتز"

msgid "You're not in 31khz mode"
msgstr "أنت لست في وضع 31 كيلوهرتز"

msgid "RUN DEMOS AND AUTOBOOT GAMES IN 240P@120"
msgstr "تشغيل العروض والألعاب التلقائية في 240p@120"

msgid ""
"Run the demos and autoboot games in 240p resolution on your 31kHz monitor."
msgstr "تشغيل العروض والألعاب التلقائية بدقة 240p على شاشة 31 كيلوهرتز."

msgid "EXPERIMENTAL"
msgstr "تجريبي"

msgid "RECALBOX RGB JAMMA SETTINGS"
msgstr "إعدادات Recalbox RGB JAMMA"

msgid "Recalbox RGB Jamma options and configuration."
msgstr "خيارات وإعدادات Recalbox RGB JAMMA."

msgid ""
"Avoid interlaced mode for tate (vertical) games on yoko (horizontal) "
"screens, and for handheld consoles."
msgstr ""
"تجنب الوضع المتداخل لألعاب TATE (عمودية) على شاشات YOKO (أفقية)، وللوحدات "
"المحمولة."

msgid "JAMMA OPTIONS"
msgstr "خيارات JAMMA"

msgid "START + UP and DOWN change the volume in frontend and in games."
msgstr "START + أعلى وأسفل يغيران مستوى الصوت في الواجهة والألعاب."

msgid "Load the dual joystick configuration on compatible games!"
msgstr "تحميل إعداد ذراعَي التحكم المزدوجَين على الألعاب المتوافقة!"

msgid "Reset all previous options to their default values"
msgstr "إعادة ضبط جميع الخيارات السابقة إلى قيمها الافتراضية"

msgid "RECALBOX RGB DUAL 2 SETTINGS"
msgstr "إعدادات Recalbox RGB Dual 2"

msgid "Recalbox RGB Dual 2 options and configuration."
msgstr "خيارات وإعدادات Recalbox RGB Dual 2."

msgid "Select Recalbox's interface resolution."
msgstr "اختر دقة واجهة Recalbox."

msgid "FORCE COMPOSITE"
msgstr "إجبار مركّب"

msgid "Force composite output (On SCART, RCA and JACK)."
msgstr "إجبار المخرج المركّب (على SCART وRCA وJACK)."

msgid "COMPOSITE SIGNAL STANDARD"
msgstr "معيار الإشارة المركّبة"

msgid ""
"When using composite, selects the composite signal standard for your region."
msgstr "عند استخدام المركّب، يختار معيار الإشارة المركّبة لمنطقتك."

msgid "16/9 CRT TV"
msgstr "تلفاز CRT بنسبة 16/9"

msgid "Activate if you have a 16/9 CRT TV."
msgstr "فعّل إذا كان لديك تلفاز CRT بنسبة 16/9."

msgid "SELECT SIGNAL (RGB/COMPOSITE) AT LAUNCH"
msgstr "اختر الإشارة (RGB/مركّب) عند التشغيل"

msgid ""
"Let you choose between RGB Signal and composite signal at launch, for "
"compatible systems."
msgstr ""
"يتيح لك الاختيار بين إشارة RGB والإشارة المركّبة عند التشغيل، للأنظمة "
"المتوافقة."

msgid "DIP SWITCHES"
msgstr "مفاتيح DIP"

msgid "FORCED 50HZ DIP SWITCH"
msgstr "مفتاح DIP إجبار 50 هرتز"

msgid "FORCED 31kHz/MULTISYNC DIP SWITCH"
msgstr "مفتاح DIP إجبار 31 كيلوهرتز/متزامن متعدد"

msgid "FORCED COMPOSITE DIP SWITCH"
msgstr "مفتاح DIP إجبار مركّب"

msgid "IN-GAME SETTINGS"
msgstr "إعدادات داخل اللعبة"

msgid "FEATURES"
msgstr "الميزات"

msgid "GAMES RENDERING"
msgstr "عرض الألعاب"

msgid "AUTO BLITTER (FBNEO/MAME)"
msgstr "Blitter تلقائي (FBNEO/MAME)"

msgid ""
"Enables automatic blitter and CPU settings for fbneo and mame games. Can "
"enhance emulation precision on games like Cave."
msgstr ""
"يُفعّل إعدادات Blitter والمعالج التلقائية لألعاب fbneo وmame. يمكن تحسين دقة "
"المحاكاة لألعاب مثل Cave."

msgid "SYSTEM-LISTS & GAMELISTS SETTINGS"
msgstr "إعدادات قوائم الأنظمة والألعاب"

msgid "Configure system and gamelist filters and options"
msgstr "تهيئة مرشحات وخيارات الأنظمة وقوائم الألعاب"

msgid "SYSTEM LISTS"
msgstr "قوائم الأنظمة"

msgid "SHOW SYSTEMS"
msgstr "إظهار الأنظمة"

msgid "Show or hide systems individually"
msgstr "إظهار أو إخفاء الأنظمة بشكل فردي"

msgid "GAMES"
msgstr "الألعاب"

msgid "ENABLE ADDING/REMOVING FAVORITES"
msgstr "تفعيل إضافة/إزالة المفضلة"

msgid ""
"Enable or disable adding/removing favorites in gamelist, search and other "
"various places."
msgstr ""
"تفعيل أو تعطيل إضافة/إزالة المفضلة في قائمة الألعاب والبحث وأماكن أخرى."

msgid ""
"Show only favorites. May hide all systems with no favorite at all until you "
"switch off this option."
msgstr ""
"إظهار المفضلة فقط. قد يُخفي جميع الأنظمة التي لا تحتوي على مفضلة حتى تُعطّل هذا "
"الخيار."

msgid "Display all favorites at the top of the game list."
msgstr "عرض جميع المفضلة في أعلى قائمة الألعاب."

msgid "Force hidden game to show in gamelists."
msgstr "إجبار الألعاب المخفية على الظهور في قوائم الألعاب."

msgid "SHOW MAHJONG AND CASINO GAMES"
msgstr "إظهار ألعاب المهجونج والكازينو"

msgid ""
"Show or hide asian casino and mahjong games. You must scrape your game for "
"this option to work."
msgstr ""
"إظهار أو إخفاء ألعاب الكازينو والمهجونج الآسيوية. يجب جمع بيانات لعبتك لعمل "
"هذا الخيار."

msgid "SHOW ADULT GAMES"
msgstr "إظهار ألعاب البالغين"

msgid ""
"Show or hide adult games. You must scrape your game for this option to work."
msgstr "إظهار أو إخفاء ألعاب البالغين. يجب جمع بيانات لعبتك لعمل هذا الخيار."

msgid "SHOW PREINSTALLED GAMES"
msgstr "إظهار الألعاب المثبتة مسبقاً"

msgid ""
"Show or hide games distributed with Recalbox. But you don't want to do this: "
"they are all excellent games!"
msgstr ""
"إظهار أو إخفاء الألعاب المرفقة مع Recalbox. لكنك لن تريد ذلك: كلها ألعاب "
"رائعة!"

msgid "Show only games playable with 3 or more players"
msgstr "إظهار الألعاب القابلة للعب بـ 3 لاعبين أو أكثر فقط"

msgid "SHOW ONLY YOKO (HORIZONTAL) GAMES"
msgstr "إظهار ألعاب YOKO (أفقية) فقط"

msgid ""
"Show only YOKO (horizontal) games. Mutually exclusive with the option to "
"show only TATE games."
msgstr "إظهار ألعاب YOKO (أفقية) فقط. يتعارض مع خيار إظهار ألعاب TATE فقط."

msgid "SHOW ONLY TATE (VERTICAL) GAMES"
msgstr "إظهار ألعاب TATE (عمودية) فقط"

msgid ""
"Show only TATE (vertical) games. Mutually exclusive with the option to show "
"only YOKO games."
msgstr "إظهار ألعاب TATE (عمودية) فقط. يتعارض مع خيار إظهار ألعاب YOKO فقط."

msgid "SHOW ROMS MARKED AS NON-GAMES"
msgstr "إظهار ROMs المصنّفة كغير ألعاب"

msgid ""
"Show or hide roms that are explicitly marked as non-game (application, "
"utilities, ...). You must scrape your game for this option to work."
msgstr ""
"إظهار أو إخفاء ROMs المصنّفة صراحةً كغير ألعاب (تطبيق، أدوات مساعدة، ...). يجب "
"جمع بيانات لعبتك لعمل هذا الخيار."

msgid "ENABLE ONE GAME ONE ROM (1G1R)"
msgstr "تفعيل لعبة واحدة ROM واحد (1G1R)"

msgid "Display only one rom|disk image for a game from your preferred region."
msgstr "عرض ROM|صورة قرص واحدة فقط للعبة من منطقتك المفضلة."

msgid "PRIORITY REGION (1G1R)"
msgstr "المنطقة ذات الأولوية (1G1R)"

msgid "Choose your preferred region for 1G1R filtering."
msgstr "اختر منطقتك المفضلة لتصفية 1G1R"

msgid "SECOND PRIORITY REGION (1G1R)"
msgstr "المنطقة ذات الأولوية الثانية (1G1R)"

msgid "Choose your second preferred region for 1G1R filtering."
msgstr "اختر منطقتك المفضلة الثانية لتصفية 1G1R"

msgid "THIRD PRIORITY REGIONS (1G1R)"
msgstr "المناطق ذات الأولوية الثالثة (1G1R)"

msgid ""
"Choose your preferred regions priority when there is no match with first and "
"second regions"
msgstr ""
"اختر أولوية مناطقك المفضلة عندما لا يوجد تطابق مع المنطقتين الأولى والثانية"

msgid "ARCADE SYSTEMS"
msgstr "أنظمة الآركيد"

msgid "ENABLE AGGREGATED ARCADE SYSTEM"
msgstr "تفعيل نظام الآركيد المجمّع"

msgid "Available only when aggregated arcade system is on"
msgstr "متاح فقط عند تشغيل نظام الآركيد المجمّع"

msgid ""
"Select manufacturer virtual system to show in the system view (like "
"CPS1/2/3, SEGA, TAITO, ...)"
msgstr ""
"اختر النظام الافتراضي للشركة المصنعة للعرض في عرض الأنظمة (مثل CPS1/2/3، "
"SEGA، TAITO، ...)"

msgid "ARCADE GAMES"
msgstr "ألعاب الآركيد"

msgid ""
"Always use arcade names from official databases. Overwrites manual edits and "
"scraper results."
msgstr ""
"استخدام أسماء الآركيد دائماً من قواعد البيانات الرسمية. يُلغي التعديل اليدوي "
"ونتائج الجمع."

msgid "USER INTERFACE SETTINGS"
msgstr "إعدادات واجهة المستخدم"

msgid "SYSTEMS TO SHOW IN DEMO/GAMECLIP"
msgstr "الأنظمة للعرض في العرض التجريبي/مقاطع الألعاب"

msgid "Adjust the screen brightness"
msgstr "ضبط سطوع الشاشة"

msgid "Change the look of your Recalbox!"
msgstr "غيّر مظهر Recalbox الخاص بك!"

msgid "DEFAULT TRANSITION STYLE"
msgstr "نمط الانتقال الافتراضي"

msgid ""
"Select the type of transition between system. INSTANT will do nothing, FADE "
"will fade to dark, and SLIDE will slide the entire screen"
msgstr ""
"اختر نوع الانتقال بين الأنظمة. INSTANT لا يفعل شيئاً، FADE يتلاشى إلى الداكن، "
"و SLIDE يزحلق الشاشة بأكملها"

msgid "Select {THEME.OPTION.NAME}"
msgstr "اختر {THEME.OPTION.NAME}"

msgid "GAME LAUNCH TRANSITION STYLE"
msgstr "نمط انتقال تشغيل اللعبة"

msgid ""
"Select the type of transition when you launch a game. INSTANT will do "
"nothing, FADE will fade to dark, and SLIDE will zoom in on the game cover."
msgstr ""
"اختر نوع الانتقال عند تشغيل لعبة. INSTANT لا يفعل شيئاً، FADE يتلاشى إلى "
"الداكن، و SLIDE يكبّر على غلاف اللعبة."

msgid "ENABLE FAST MOVE IN GAMELIST"
msgstr "تفعيل التحريك السريع في قائمة الألعاب"

msgid ""
"When enabled, holding up or down for a few seconds makes the list scroll "
"very fast."
msgstr ""
"عند التفعيل، الضغط المطوّل على أعلى/أسفل لثوانٍ يجعل القائمة تتمرير بسرعة كبيرة"

msgid "Display the current time in a corner of the screen."
msgstr "عرض الوقت الحالي في زاوية الشاشة."

msgid "SHOW MUSIC POPUPS"
msgstr "إظهار نوافذ الموسيقى المنبثقة"

msgid "When enabled, show music information every time a new music starts."
msgstr "عند التفعيل، يعرض معلومات الموسيقى في كل مرة تبدأ موسيقى جديدة."

msgid "SHOW NETPLAY POPUPS"
msgstr "إظهار نوافذ Netplay المنبثقة"

msgid ""
"When enabled, show netplay information every time a user starts a new game "
"over internet."
msgstr ""
"عند التفعيل، يعرض معلومات Netplay في كل مرة يبدأ مستخدم لعبة جديدة عبر "
"الإنترنت."

msgid "CONTROLLER SETTINGS"
msgstr "إعدادات أدوات التحكم"

msgid "Add and configure all your controllers."
msgstr "إضافة وتهيئة جميع أدوات التحكم الخاصة بك."

msgid "WIFI"
msgstr "WiFi"

msgid "CONNECT AUTOMATICALLY"
msgstr "الاتصال تلقائياً"

msgid ""
"Automatically connect on startup if the WIFI network is available and "
"properly configured!"
msgstr ""
"الاتصال تلقائياً عند بدء التشغيل إذا كانت شبكة WiFi متاحة ومُهيَّأة بشكل صحيح!"

msgid "WIFI is disabled!"
msgstr "WiFi معطّل!"

msgid "SELECT SSID"
msgstr "اختر SSID"

msgid "Select an available SSID."
msgstr "اختر SSID متاحاً."

msgid "If your Internet box has a WPS system, activate it and then click here!"
msgstr "إذا كان صندوق الإنترنت لديك يحتوي على نظام WPS، فعّله ثم انقر هنا!"

msgid ""
"Run the scraper! The operation may take a while, however you can make it a "
"background task and keep using Recalbox."
msgstr ""
"تشغيل جامع البيانات! قد تستغرق العملية بعض الوقت، ومع ذلك يمكنك جعلها مهمة "
"خلفية ومتابعة استخدام Recalbox."

msgid "PATRON OPTIONS"
msgstr "خيارات الراعي"

msgid "user name for the selected scraper"
msgstr "اسم المستخدم لجامع البيانات المحدد"

msgid "password for the selected scraper"
msgstr "كلمة المرور لجامع البيانات المحدد"

msgid "Download various free games and free contents!"
msgstr "تنزيل ألعاب مجانية ومحتويات مجانية متنوعة!"

msgid "Download games for {SYSTEM.NAME}"
msgstr "تنزيل ألعاب لـ {SYSTEM.NAME}"

msgid ""
"Download a pack of free games, game demos and homebrew for {SYSTEM.NAME}"
msgstr ""
"تنزيل حزمة من الألعاب المجانية والعروض التجريبية والـ homebrew لـ {SYSTEM."
"NAME}"

msgid "No content available yet for {SYSTEM.NAME}!"
msgstr "لا يوجد محتوى متاح بعد لـ {SYSTEM.NAME}!"

msgid "ACTIVATE DEBUG/VERBOSE LOGS"
msgstr "تفعيل سجلات التصحيح والتفصيل"

msgid "Activate debug and verbose logs in Recalbox and Emulators."
msgstr "تفعيل سجلات التصحيح والتفصيل في Recalbox والمحاكيات."

msgid "You cannot set up Kodi on boot when Kodi is disabled."
msgstr "لا يمكنك إعداد Kodi عند الإقلاع وهو معطّل."

msgid "DO NOT SCAN NEW GAMES"
msgstr "عدم فحص الألعاب الجديدة"

msgid ""
"Formerly called 'GAMELIST ONLY', it can greatly speed up boot time by not "
"scanning new files. Use it if your romsets are rarely updated."
msgstr ""
"كان يُسمى سابقاً 'GAMELIST ONLY'، يمكنه تسريع وقت الإقلاع بشكل كبير بعدم فحص "
"الملفات الجديدة. استخدمه إذا كانت مجموعات ROMs نادراً ما تُحدَّث."

msgid "ALLOW BOOT ON GAME"
msgstr "السماح بالإقلاع على لعبة"

msgid ""
"When activated, Recalbox boots into the gamelist and does not allow moving "
"back to the system list."
msgstr ""
"عند التفعيل، يُقلع Recalbox على قائمة الألعاب ولا يسمح بالعودة إلى قائمة "
"الأنظمة."

msgid "SYSTEM SPECIFIC RESOLUTIONS"
msgstr "دقات خاصة بالنظام"

msgid "FOR {SYSTEM.NAME}"
msgstr "لـ {SYSTEM.NAME}"

msgid "Select the resolution used by the emulator '{SYSTEM.NAME}'."
msgstr "اختر الدقة التي يستخدمها المحاكي '{SYSTEM.NAME}'."

msgid "Set options for system {SYSTEM.NAME}"
msgstr "ضبط خيارات النظام {SYSTEM.NAME}"

msgid "Set the way you want to use Kodi mediaplayer."
msgstr "ضبط طريقة استخدام مشغل وسائط Kodi."

msgid "RUN KODI ON STARTUP"
msgstr "تشغيل Kodi عند بدء التشغيل"

msgid "START KODI WITH X BUTTON"
msgstr "تشغيل Kodi بزر X"

msgid "Run your own scripts in shell or python"
msgstr "تشغيل سكريبتاتك الخاصة في Shell أو Python"

msgid "Run custom script {SCRIPT.NAME}"
msgstr "تشغيل السكريبت المخصص {SCRIPT.NAME}"

msgid "ENABLE WEB MANAGER"
msgstr "تفعيل مدير الويب"

msgid "RESET EMULATOR SETTINGS"
msgstr "إعادة ضبط إعدادات المحاكيات"

msgid "RESET!"
msgstr "إعادة الضبط!"

msgid ""
"This option resets all emulator settings to their factory defaults. It does "
"not affect any Recalbox setting."
msgstr ""
"يُعيد هذا الخيار ضبط جميع إعدادات المحاكيات إلى الافتراضيات. لا يؤثر على أي "
"إعداد Recalbox."

msgid "HARDWARE"
msgstr "الأجهزة"

msgid "UPDATE!"
msgstr "تحديث!"

msgid "Update Pi4 / Pi400 or Pi5 bootloader if required."
msgstr "تحديث محمّل إقلاع Pi4/Pi400 أو Pi5 إذا لزم الأمر."

msgid "Recalbox does not support overclocking for your board."
msgstr "لا يدعم Recalbox رفع تردد المعالج للوحتك."

msgid "CONTEXTUAL OPTIONS"
msgstr "الخيارات السياقية"

msgid "EDIT GAME {GAME.NAME}"
msgstr "تعديل اللعبة {GAME.NAME}"

msgid "Show options related to {GAME.NAME} and allow editing game metadata."
msgstr "عرض خيارات تتعلق بـ {GAME.NAME} والسماح بتعديل بيانات اللعبة."

msgid ""
"You cannot edit this game because it is a pre-installed game or it is stored "
"on a read-only device"
msgstr ""
"لا يمكنك تعديل هذه اللعبة لأنها لعبة مثبتة مسبقاً أو مخزّنة على جهاز للقراءة "
"فقط"

msgid "Select the emulator to use to run {GAME.NAME}"
msgstr "اختر المحاكي لاستخدامه لتشغيل {GAME.NAME}"

msgid "SET PATCH"
msgstr "ضبط التصحيح"

msgid "Select patch to use when running an emulator supporting softpatching."
msgstr "اختر التصحيح لاستخدامه عند تشغيل محاكٍ يدعم التصحيح التلقائي."

msgid ""
"Either the game has no patch or the emulator selected to run this game is "
"not supporting softpatching."
msgstr ""
"إما أن اللعبة لا تحتوي على تصحيح أو أن المحاكي المحدد لتشغيلها لا يدعم "
"التصحيح التلقائي."

msgid "Sets the name of the game or folder."
msgstr "يضبط اسم اللعبة أو المجلد."

msgid "Set this game as favorite or not."
msgstr "ضبط هذه اللعبة كمفضلة أو لا."

msgid "Editing favorites is not enabled."
msgstr "تعديل المفضلة غير مُفعَّل."

msgid "Hide or show this game."
msgstr "إخفاء أو إظهار هذه اللعبة."

msgid "Defines this game as an adult game or not."
msgstr "تصنيف هذه اللعبة كلعبة للبالغين أو لا."

msgid "Scraping"
msgstr "جمع البيانات"

msgid "Scrape this game and fill in all metadata at once!"
msgstr "اجمع بيانات هذه اللعبة واملأ جميع البيانات الوصفية دفعة واحدة!"

msgid "Statistics"
msgstr "الإحصائيات"

msgid "Show the total time you played this game"
msgstr "عرض إجمالي الوقت الذي لعبت فيه هذه اللعبة"

msgid "PLAY COUNT"
msgstr "عدد مرات اللعب"

msgid "Show the number of times you played this game"
msgstr "عرض عدد المرات التي لعبت فيها هذه اللعبة"

msgid "Show the last date/time you played this game"
msgstr "عرض آخر تاريخ/وقت لعبت فيه هذه اللعبة"

msgid "DELETE GAME {GAME.NAME}"
msgstr "حذف اللعبة {GAME.NAME}"

msgid "DELETE {ICON.WARNING}"
msgstr "حذف {ICON.WARNING}"

msgid ""
"Delete game or screenshot physically on the storage. Allow keeping save, "
"metadata and other related files individually."
msgstr ""
"حذف اللعبة أو لقطة الشاشة فعلياً من التخزين. يسمح بالاحتفاظ بالحفظات "
"والبيانات الوصفية والملفات الأخرى ذات الصلة بشكل فردي."

msgid ""
"You cannot delete this game because it is a pre-installed game or it is "
"stored on a read-only device or it is a folder."
msgstr ""
"لا يمكنك حذف هذه اللعبة لأنها لعبة مثبتة مسبقاً أو مخزّنة على جهاز للقراءة فقط "
"أو هي مجلد."

msgid ""
"Boot on game is not enabled. To set a game to boot on, enable the "
"appropriate option first."
msgstr ""
"الإقلاع على لعبة غير مُفعَّل. لضبط لعبة للإقلاع عليها، فعّل الخيار المناسب أولاً."

msgid "RUN SAVE STATE"
msgstr "تشغيل حالة الحفظ"

msgid "Select, restore and run game in the selected save state."
msgstr "اختر حالة الحفظ، استعدها وشغّل اللعبة منها."

msgid ""
"No save state has been detected for the currently selected game, or the "
"currently selected item is not a game."
msgstr ""
"لم يتم اكتشاف أي حالة حفظ للعبة المحددة حالياً، أو العنصر المحدد حالياً ليس "
"لعبة."

msgid "JUMP"
msgstr "قفز"

msgid "Open the Quick Jump selector."
msgstr "فتح محدد القفز السريع."

msgid "This option allows you to search for other versions of a game."
msgstr "يتيح هذا الخيار البحث عن إصدارات أخرى للعبة."

msgid "This option allows you to search for other games with the same licence."
msgstr "يتيح هذا الخيار البحث عن ألعاب أخرى بنفس الترخيص."

msgid ""
"Select the way the game list is sorted (alphabetically, by rating, ...)."
msgstr "اختر طريقة ترتيب قائمة الألعاب (أبجدياً، حسب التقييم...)."

msgid "This list has a natural order and can't be sorted."
msgstr "هذه القائمة لها ترتيب طبيعي ولا يمكن ترتيبها."

msgid ""
"Select what kind of information you want to see on the right of your "
"gamelist: regions flags, players or game genre."
msgstr ""
"اختر نوع المعلومات التي تريد رؤيتها يمين قائمة ألعابك: أعلام المناطق أو "
"اللاعبون أو نوع اللعبة."

msgid "FLATTEN FOLDERS"
msgstr "تسطيح المجلدات"

msgid "This system is either always flattened or cannot be flattened!"
msgstr "هذا النظام إما مُسطَّح دائماً أو لا يمكن تسطيحه!"

msgid "You can't hide favorites in the Favorite system!"
msgstr "لا يمكنك إخفاء المفضلة في نظام المفضلة!"

msgid "Display favorites at the top of gamelists."
msgstr "عرض المفضلة في أعلى قوائم الألعاب."

msgid "Favorites are always first in the Favorite system!"
msgstr "المفضلة دائماً في المقدمة في نظام المفضلة!"

msgid "Virtual systems cannot be updated. Update real systems instead."
msgstr ""
"لا يمكن تحديث الأنظمة الافتراضية. قم بتحديث الأنظمة الحقيقية بدلاً من ذلك."

msgid "Advanced system settings"
msgstr "إعدادات متقدمة للنظام"

msgid "Set advanced settings for system {SYSTEM.NAME}"
msgstr "ضبط إعدادات متقدمة للنظام {SYSTEM.NAME}"

msgid "DELETE {GAME.NAME}"
msgstr "حذف {GAME.NAME}"

msgid "GAME FILES (ROM, DISK IMAGE, TAPE, ...)"
msgstr "ملفات اللعبة (ROM، صورة قرص، شريط، ...)"

msgid "Number of game files that are to be deleted."
msgstr "عدد ملفات الألعاب المراد حذفها."

msgid ""
