msgstr "شاشتك {0} غير موجودة في قائمة الشاشات المدعومة لهذا المظهر:"

msgid ""
"You current resolution {0} is not in the list of this theme's supported "
"resolutions:"
msgstr "دقتك الحالية {0} غير موجودة في قائمة الدقات المدعومة لهذا المظهر:"

msgid "You're in TATE mode and this theme does not seem to support TATE."
msgstr "أنت في وضع TATE وهذا المظهر لا يبدو أنه يدعم TATE."

msgid ""
"This theme may have one or more compatibility issues with your current "
"display:\n"
msgstr "قد يحتوي هذا المظهر على مشكلة توافق واحدة أو أكثر مع شاشتك الحالية:\n"

msgid "NEXT"
msgstr "التالي"

msgid "UPDATE NOW"
msgstr "تحديث الآن"

msgid "PAGE UP/DOWN"
msgstr "صفحة لأعلى/لأسفل"

