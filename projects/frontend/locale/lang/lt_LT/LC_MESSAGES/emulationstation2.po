msgstr "Esate TATE režime, ir ši tema, atrodo, nepalaiko TATE."

msgid ""
"This theme may have one or more compatibility issues with your current "
"display:\n"
msgstr ""
"Ši tema gali turėti vieną ar daugiau suderinamumo problemų su jūsų "
"dabartiniu ekranu:\n"

msgid "NEXT"
msgstr "KITAS"

msgid "UPDATE NOW"
msgstr "ATNAUJINTI DABAR"

msgid "PAGE UP/DOWN"
msgstr "PAGE UP/DOWN"

