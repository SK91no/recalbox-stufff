msgstr "مجوز متن‌باز"

msgid "SELECT IMAGE TYPE"
msgstr "انتخاب نوع تصویر"

msgid "In-game screenshot"
msgstr "اسکرین‌شات در بازی"

msgid "Title screenshot"
msgstr "اسکرین‌شات عنوان"

