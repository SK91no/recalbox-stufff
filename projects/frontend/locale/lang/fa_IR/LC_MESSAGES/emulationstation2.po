msgstr "فوق‌نمونه‌برداری"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr "فوق‌نمونه‌برداری. هنوز فعال نشده. پیش‌فرض ۱ است."

msgid "Upscale"
msgstr "بهبود کیفیت"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr "حالت فیلتر بهبود کیفیت لایه ۲D را انتخاب کنید. پیش‌فرض ۰ است."

msgid "Disable no throttle"
msgstr "غیرفعال کردن بدون محدودیت"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"انتخاب کنید که آیا قفل نرخ فریم ۶۰ هرتز را فعال یا غیرفعال کنید. پیش‌فرض "
"غیرفعال است."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr "نرخ بازخوانی عمودی را قفل کنید. پیش‌فرض فعال است."

msgid "True Hz"
msgstr "هرتز واقعی"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr ""
"نرخ بازخوانی واقعی مدل ۳ یعنی ۵۷،۵۲۴ هرتز را انتخاب کنید. پیش‌فرض غیرفعال است."

msgid "Crosshairs"
msgstr "نشانه‌گیری"

msgid "Show crosshairs. Default is disabled."
msgstr "انتخاب کنید که آیا نشانه‌گیری نمایش داده شود. پیش‌فرض غیرفعال است."

msgid "Multi texture"
msgstr "بافت چندگانه"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr ""
"انتخاب کنید که آیا از ۸ نقشه بافت برای رمزگشایی استفاده شود. پیش‌فرض غیرفعال "
"است."

msgid "Quad rendering"
msgstr "رندرینگ چهارگانه"

msgid "Enable proper quad rendering. Default is disabled."
msgstr "انتخاب کنید که آیا رندرینگ چهارگانه صحیح فعال شود. پیش‌فرض غیرفعال است."

msgid "Supermodel Settings - Core"
msgstr "تنظیمات Supermodel - هسته"

msgid "GPU multi threading"
msgstr "چندنخی GPU"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"برای اجرای GPU در رشتهٔ اختصاصی خودش به‌جای اشتراک‌گذاری رشتهٔ CPU، آن را روی ON "
"تنظیم کنید. سریع‌تر است اما بسته به بازی ممکن است باعث اشکال شود."

msgid "PPC Frequency"
msgstr "فرکانس PPC"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr ""
"فرکانس PowerPC را به مگاهرتز انتخاب کنید، بین ۱ تا ۱۰۰۰. پیش‌فرض ۷۰ است."

msgid "Service button"
msgstr "دکمه سرویس"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"منوی سرویس در بازی‌ها را فعال یا غیرفعال کنید (L3 = آزمایش، R3 = سرویس). "
"پیش‌فرض فعال است."

msgid "Log level"
msgstr "سطح ثبت رویداد"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr "سطح اطلاعات در فایل ثبت رویداد را انتخاب کنید. پیش‌فرض اطلاعات است."

msgid "Xemu Settings"
msgstr "تنظیمات Xemu"

msgid "Choose the internal resolution of the Xbox."
msgstr "وضوح تصویر داخلی Xbox را انتخاب کنید."

msgid "Show menu bar"
msgstr "نمایش نوار منو"

msgid "Show the menu bar."
msgstr "انتخاب کنید که آیا نوار منو نمایش داده شود."

msgid "Skip boot animation"
msgstr "رد کردن انیمیشن بوت"

msgid "Skip the boot animation."
msgstr "انتخاب کنید که آیا انیمیشن بوت رد شود."

msgid "Show notifications"
msgstr "نمایش اعلان‌ها"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "نمایش اعلان‌های نشان داده شده در گوشه بالا سمت راست صفحه."

msgid "Display mode"
msgstr "حالت نمایش"

msgid "Choose how the framebuffer should fit or scale."
msgstr "انتخاب کنید که چگونه framebuffer تنظیم یا مقیاس‌بندی شود."

msgid "Aspect Ratio"
msgstr "نسبت تصویر"

msgid "Choose the aspect ratio of the Xbox."
msgstr "نسبت تصویر Xbox را انتخاب کنید."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - تنظیمات عمومی EEPROM"

msgid "Choose the region to use on Xbox."
msgstr "منطقه مورد استفاده در Xbox را انتخاب کنید."

msgid "Video Standard"
msgstr "استاندارد ویدیو"

msgid "Choose the video standard to use on Xbox."
msgstr "استاندارد ویدیوی مورد استفاده در Xbox را انتخاب کنید."

msgid "Timezone"
msgstr "منطقه زمانی"

msgid ""
"Choose the timezone to use on Xbox. If your country is using DST, don't take "
"it into account when you are setting this."
msgstr ""
"منطقه زمانی مورد استفاده در Xbox را انتخاب کنید. اگر کشور شما از ساعت "
"تابستانی استفاده می‌کند، هنگام تنظیم این گزینه آن را در نظر نگیرید."

msgid "Disable automatic daylight saving time"
msgstr "غیرفعال کردن ساعت تابستانی خودکار"

msgid "Choose if you want to disable automatic daylight saving time."
msgstr "انتخاب کنید که آیا ساعت تابستانی خودکار غیرفعال شود."

msgid "DVD Region"
msgstr "منطقه DVD"

msgid "Choose the DVD region to use on Xbox."
msgstr "منطقه DVD مورد استفاده در Xbox را انتخاب کنید."

msgid "Language"
msgstr "زبان"

msgid "Choose the language to use on Xbox."
msgstr "زبان مورد استفاده در Xbox را انتخاب کنید."

msgid "Xemu - EEPROM Video Settings"
msgstr "Xemu - تنظیمات ویدیوی EEPROM"

msgid "Enable 480p resolution on Xbox."
msgstr "وضوح تصویر ۴۸۰p در Xbox را فعال کنید."

msgid "720p"
msgstr "720p"

msgid "Enable 720p resolution on Xbox."
msgstr "وضوح تصویر ۷۲۰p در Xbox را فعال کنید."

msgid "1080i"
msgstr "1080i"

msgid "Enable 1080i resolution on Xbox."
msgstr "وضوح تصویر ۱۰۸۰i در Xbox را فعال کنید."

msgid "Video Mode"
msgstr "حالت ویدیو"

msgid "Choose the video mode to use on Xbox."
msgstr "حالت ویدیوی مورد استفاده در Xbox را انتخاب کنید."

msgid "Refresh rate"
msgstr "نرخ بازخوانی"

msgid "Set the refresh rate to 60Hz on Xbox."
msgstr "نرخ بازخوانی ۶۰ هرتز در Xbox را فعال کنید."

msgid "Xemu - EEPROM Audio Settings"
msgstr "Xemu - تنظیمات صوتی EEPROM"

msgid "Audio Output"
msgstr "خروجی صدا"

msgid "Choose the audio output to use on Xbox."
msgstr "خروجی صوتی مورد استفاده در Xbox را انتخاب کنید."

msgid "AC3"
msgstr "AC3"

msgid "Enable Dolby Digital (AC3) on Xbox."
msgstr "Dolby Digital (AC3) در Xbox را فعال کنید."

msgid "DTS"
msgstr "DTS"

msgid "Enable Dolby Surround (DTS) on Xbox."
msgstr "Dolby Surround (DTS) در Xbox را فعال کنید."

msgid "SHUTDOWN RECALBOX"
msgstr "خاموش کردن Recalbox"

msgid "FAST SHUTDOWN RECALBOX"
msgstr "خاموش کردن سریع Recalbox"

msgid "RESTART RECALBOX"
msgstr "راه‌اندازی مجدد Recalbox"

msgid "EDIT NETPLAY PASSWORDS"
msgstr "ویرایش رمزهای Netplay"

msgid "PASSWORD #{INDEX}"
msgstr "رمز #{INDEX}"

msgid "SHARE USAGE"
msgstr "استفاده از فضای مشترک"

msgid "SHARE PARTITION"
msgstr "پارتیشن مشترک"

msgid "Exit the password edition."
msgstr "خروج از ویرایش رمز."

msgid "AVAILABLE STORAGES"
msgstr "فضاهای ذخیره‌سازی موجود"

msgid ""
"Show a list of storage available on your system. Select a storage to access "
"extra information and available actions."
msgstr ""
"فهرستی از فضاهای ذخیره‌سازی موجود در سیستم شما نمایش می‌دهد. یک فضا را انتخاب "
"کنید تا اطلاعات بیشتر و اقدامات موجود را ببینید."

msgid "Get information about {DEVICE.NAME}"
msgstr "دریافت اطلاعات درباره {DEVICE.NAME}"

msgid "FREE SPACE"
msgstr "فضای خالی"

msgid "Display free space available on the device"
msgstr "فضای خالی موجود در دستگاه را نمایش می‌دهد"

msgid "STORAGE NAME"
msgstr "نام فضای ذخیره‌سازی"

msgid "Display real device name"
msgstr "نام واقعی دستگاه را نمایش می‌دهد"

msgid "NETWORK ACCESS"
msgstr "دسترسی شبکه"

msgid "Access to this storage through your local network."
msgstr "دسترسی به این فضای ذخیره‌سازی از طریق شبکه محلی."

msgid "FILE SYSTEM"
msgstr "سیستم فایل"

msgid "FileSystem"
msgstr "سیستم فایل"

msgid "COMPATIBLE WITH RECALBOX?"
msgstr "سازگار با Recalbox؟"

msgid "Show if this storage is compatible with recalbox"
msgstr "نمایش می‌دهد که آیا این فضا با Recalbox سازگار است"

msgid "INSTALL RECALBOX ROM FOLDERS"
msgstr "نصب پوشه‌های ROM Recalbox"

msgid "INITIALIZE!"
msgstr "راه‌اندازی اولیه!"

msgid ""
"Create rom structure so that this storage will be used by Recalbox on next "
"boots."
msgstr ""
"ساختار ROM را ایجاد کنید تا این فضا در بوت‌های بعدی توسط Recalbox استفاده شود."

msgid ""
"You cannot initialize this storage, because either it is already initialized "
"or it is not compatible."
msgstr ""
"نمی‌توانید این فضا را راه‌اندازی اولیه کنید، چون یا از قبل راه‌اندازی شده یا "
"سازگار نیست."

msgid ""
"Select your language. A reboot is required to set this configuration active."
msgstr ""
"زبان خود را انتخاب کنید. برای فعال شدن این تنظیم باید راه‌اندازی مجدد شود."

msgid "TIMEZONE"
msgstr "منطقه زمانی"

msgid ""
"Select the timezone used to display dates and times in their local format."
msgstr "انتخاب منطقه زمانی برای نمایش تاریخ و ساعت به فرمت محلی."

msgid "Shows available update version."
msgstr "نسخه به‌روزرسانی موجود را نمایش می‌دهد."

msgid "CHECK UPDATES PERIODICALLY"
msgstr "بررسی دوره‌ای به‌روزرسانی‌ها"

msgid ""
"Automatically check if an update is available. If so, it notifies you with a "
"message."
msgstr ""
"به‌طور خودکار بررسی می‌کند که آیا به‌روزرسانی موجود است. در صورت وجود، با پیامی "
"اطلاع می‌دهد."

msgid "Select update type"
msgstr "انتخاب نوع به‌روزرسانی"

msgid "CHECK"
msgstr "بررسی"

msgid "Check if an update is available, right now."
msgstr "همین الان بررسی کنید که آیا به‌روزرسانی موجود است."

msgid "SHOW NEW VERSION CHANGELOG"
msgstr "نمایش تغییرات نسخه جدید"

msgid "SHOW"
msgstr "نمایش"

msgid "Shows available update changelog."
msgstr "تغییرات به‌روزرسانی موجود را نمایش می‌دهد."

msgid "DOWNLOAD AND UPDATE MY RECALBOX"
msgstr "دانلود و به‌روزرسانی Recalbox"

msgid "GO!"
msgstr "برو!"

msgid "No update available yet."
msgstr "هنوز به‌روزرسانی موجود نیست."

msgid "RECALBOX RGB DUAL SETTINGS"
msgstr "تنظیمات Recalbox RGB Dual"

msgid ""
"Select Recalbox's interface resolution. 480i is recommended for better "
"details."
msgstr ""
"وضوح تصویر رابط Recalbox را انتخاب کنید. ۴۸۰i برای جزئیات بهتر توصیه می‌شود."

msgid "AVOID INTERLACED MODES"
msgstr "اجتناب از حالت‌های درهم‌تنیده"

msgid "Avoid interlaced mode for all games."
msgstr "از حالت درهم‌تنیده برای همه بازی‌ها اجتناب کنید."

msgid "AVOID INTERLACED MODES FOR TATE GAMES ON YOKO AND HANDHELDS"
msgstr "اجتناب از حالت درهم‌تنیده برای بازی‌های عمودی روی صفحات افقی و دستی"

msgid "31 KHZ"
msgstr "۳۱ کیلوهرتز"

msgid "You're not in 31khz mode"
msgstr "شما در حالت ۳۱ کیلوهرتز نیستید"

msgid "RUN DEMOS AND AUTOBOOT GAMES IN 240P@120"
msgstr "اجرای دموها و بازی‌های خودکار در ۲۴۰p@120"

msgid ""
"Run the demos and autoboot games in 240p resolution on your 31kHz monitor."
msgstr ""
"دموها و بازی‌های بوت خودکار را در وضوح ۲۴۰p روی مانیتور ۳۱ کیلوهرتز اجرا کنید."

msgid "EXPERIMENTAL"
msgstr "آزمایشی"

msgid "RECALBOX RGB JAMMA SETTINGS"
msgstr "تنظیمات Recalbox RGB JAMMA"

msgid "Recalbox RGB Jamma options and configuration."
msgstr "گزینه‌ها و پیکربندی Recalbox RGB Jamma."

msgid ""
"Avoid interlaced mode for tate (vertical) games on yoko (horizontal) "
"screens, and for handheld consoles."
msgstr ""
"از حالت درهم‌تنیده برای بازی‌های عمودی روی صفحات افقی و کنسول‌های دستی اجتناب "
"کنید."

msgid "JAMMA OPTIONS"
msgstr "گزینه‌های JAMMA"

msgid "START + UP and DOWN change the volume in frontend and in games."
msgstr ""
"START + بالا و پایین میزان صدا را در منوی اصلی و در بازی‌ها تغییر می‌دهد."

msgid "Load the dual joystick configuration on compatible games!"
msgstr "پیکربندی جوی‌استیک دوگانه را روی بازی‌های سازگار بارگذاری کنید!"

msgid "Reset all previous options to their default values"
msgstr "بازنشانی همه گزینه‌های قبلی به مقادیر پیش‌فرض"

msgid "RECALBOX RGB DUAL 2 SETTINGS"
msgstr "تنظیمات Recalbox RGB Dual 2"

msgid "Recalbox RGB Dual 2 options and configuration."
msgstr "گزینه‌ها و پیکربندی Recalbox RGB Dual 2."

msgid "Select Recalbox's interface resolution."
msgstr "وضوح تصویر رابط Recalbox را انتخاب کنید."

msgid "FORCE COMPOSITE"
msgstr "اجبار خروجی کامپوزیت"

msgid "Force composite output (On SCART, RCA and JACK)."
msgstr "خروجی کامپوزیت را اجبار کنید (روی SCART، RCA و JACK)."

msgid "COMPOSITE SIGNAL STANDARD"
msgstr "استاندارد سیگنال کامپوزیت"

msgid ""
"When using composite, selects the composite signal standard for your region."
msgstr ""
"هنگام استفاده از کامپوزیت، استاندارد سیگنال کامپوزیت منطقه خود را انتخاب "
"کنید."

msgid "16/9 CRT TV"
msgstr "تلویزیون CRT 16/9"

msgid "Activate if you have a 16/9 CRT TV."
msgstr "اگر تلویزیون CRT 16/9 دارید فعال کنید."

msgid "SELECT SIGNAL (RGB/COMPOSITE) AT LAUNCH"
msgstr "انتخاب سیگنال (RGB/کامپوزیت) در هنگام راه‌اندازی"

msgid ""
"Let you choose between RGB Signal and composite signal at launch, for "
"compatible systems."
msgstr ""
"به شما امکان انتخاب بین سیگنال RGB و کامپوزیت در هنگام راه‌اندازی برای "
"سیستم‌های سازگار می‌دهد."

msgid "DIP SWITCHES"
msgstr "کلیدهای DIP"

msgid "FORCED 50HZ DIP SWITCH"
msgstr "کلید DIP اجباری ۵۰ هرتز"

msgid "FORCED 31kHz/MULTISYNC DIP SWITCH"
msgstr "کلید DIP اجباری ۳۱ کیلوهرتز/چندهمگام"

msgid "FORCED COMPOSITE DIP SWITCH"
msgstr "کلید DIP اجباری کامپوزیت"

msgid "IN-GAME SETTINGS"
msgstr "تنظیمات درون بازی"

msgid "FEATURES"
msgstr "ویژگی‌ها"

msgid "GAMES RENDERING"
msgstr "رندرینگ بازی‌ها"

msgid "AUTO BLITTER (FBNEO/MAME)"
msgstr "بلیتر خودکار (FBNEO/MAME)"

msgid ""
"Enables automatic blitter and CPU settings for fbneo and mame games. Can "
"enhance emulation precision on games like Cave."
msgstr ""
"تنظیمات خودکار بلیتر و CPU را برای بازی‌های fbneo و mame فعال می‌کند. می‌تواند "
"دقت شبیه‌سازی بازی‌هایی مانند Cave را بهبود بخشد."

msgid "SYSTEM-LISTS & GAMELISTS SETTINGS"
msgstr "تنظیمات فهرست سیستم‌ها و بازی‌ها"

msgid "Configure system and gamelist filters and options"
msgstr "پیکربندی فیلترها و گزینه‌های سیستم و فهرست بازی"

msgid "SYSTEM LISTS"
msgstr "فهرست سیستم‌ها"

msgid "SHOW SYSTEMS"
msgstr "نمایش سیستم‌ها"

msgid "Show or hide systems individually"
msgstr "نمایش یا پنهان کردن سیستم‌ها به صورت جداگانه"

msgid "GAMES"
msgstr "بازی‌ها"

msgid "ENABLE ADDING/REMOVING FAVORITES"
msgstr "فعال کردن افزودن/حذف مورد علاقه‌ها"

msgid ""
"Enable or disable adding/removing favorites in gamelist, search and other "
"various places."
msgstr ""
"افزودن/حذف مورد علاقه‌ها در فهرست بازی، جستجو و سایر مکان‌ها را فعال یا "
"غیرفعال کنید."

msgid ""
"Show only favorites. May hide all systems with no favorite at all until you "
"switch off this option."
msgstr ""
"فقط مورد علاقه‌ها را نمایش دهد. ممکن است همه سیستم‌های بدون مورد علاقه را "
"پنهان کند تا این گزینه را خاموش کنید."

msgid "Display all favorites at the top of the game list."
msgstr "همه مورد علاقه‌ها را در بالای فهرست بازی نمایش دهد."

msgid "Force hidden game to show in gamelists."
msgstr "بازی‌های پنهان را در فهرست بازی‌ها نمایش دهد."

msgid "SHOW MAHJONG AND CASINO GAMES"
msgstr "نمایش بازی‌های ماجونگ و کازینو"

msgid ""
"Show or hide asian casino and mahjong games. You must scrape your game for "
"this option to work."
msgstr ""
"بازی‌های کازینو آسیایی و ماجونگ را نمایش دهید یا پنهان کنید. برای کارکرد این "
"گزینه باید بازی خود را اسکرپ کنید."

msgid "SHOW ADULT GAMES"
msgstr "نمایش بازی‌های بزرگسالان"

msgid ""
"Show or hide adult games. You must scrape your game for this option to work."
msgstr ""
"بازی‌های بزرگسالان را نمایش دهید یا پنهان کنید. برای کارکرد این گزینه باید "
"بازی خود را اسکرپ کنید."

msgid "SHOW PREINSTALLED GAMES"
msgstr "نمایش بازی‌های از پیش نصب شده"

msgid ""
"Show or hide games distributed with Recalbox. But you don't want to do this: "
"they are all excellent games!"
msgstr ""
"بازی‌های توزیع شده با Recalbox را نمایش دهید یا پنهان کنید. اما نمی‌خواهید این "
"کار را بکنید: همه آن‌ها بازی‌های عالی هستند!"

msgid "Show only games playable with 3 or more players"
msgstr "فقط بازی‌های قابل بازی با ۳ یا بیشتر بازیکن را نمایش دهید"

msgid "SHOW ONLY YOKO (HORIZONTAL) GAMES"
msgstr "فقط نمایش بازی‌های افقی (YOKO)"

msgid ""
"Show only YOKO (horizontal) games. Mutually exclusive with the option to "
"show only TATE games."
msgstr ""
"فقط بازی‌های افقی (YOKO) را نمایش دهید. با گزینه نمایش فقط بازی‌های عمودی "
"ناسازگار است."

msgid "SHOW ONLY TATE (VERTICAL) GAMES"
msgstr "فقط نمایش بازی‌های عمودی (TATE)"

msgid ""
"Show only TATE (vertical) games. Mutually exclusive with the option to show "
"only YOKO games."
msgstr ""
"فقط بازی‌های عمودی (TATE) را نمایش دهید. با گزینه نمایش فقط بازی‌های افقی "
"ناسازگار است."

msgid "SHOW ROMS MARKED AS NON-GAMES"
msgstr "نمایش ROM های علامت‌گذاری شده به عنوان غیربازی"

msgid ""
"Show or hide roms that are explicitly marked as non-game (application, "
"utilities, ...). You must scrape your game for this option to work."
msgstr ""
"ROM هایی که صریحاً به عنوان غیربازی علامت‌گذاری شده‌اند را نمایش دهید یا پنهان "
"کنید. برای کارکرد این گزینه باید بازی خود را اسکرپ کنید."

msgid "ENABLE ONE GAME ONE ROM (1G1R)"
msgstr "فعال کردن یک بازی یک ROM (1G1R)"

msgid "Display only one rom|disk image for a game from your preferred region."
msgstr "فقط یک ROM|تصویر دیسک از منطقه ترجیحی شما برای یک بازی نمایش دهید."

msgid "PRIORITY REGION (1G1R)"
msgstr "منطقه اولویت (1G1R)"

msgid "Choose your preferred region for 1G1R filtering."
msgstr "منطقه ترجیحی خود را برای فیلترینگ 1G1R انتخاب کنید"

msgid "SECOND PRIORITY REGION (1G1R)"
msgstr "منطقه اولویت دوم (1G1R)"

msgid "Choose your second preferred region for 1G1R filtering."
msgstr "منطقه ترجیحی دوم خود را برای فیلترینگ 1G1R انتخاب کنید"

msgid "THIRD PRIORITY REGIONS (1G1R)"
msgstr "منطقه‌های اولویت سوم (1G1R)"

msgid ""
"Choose your preferred regions priority when there is no match with first and "
"second regions"
msgstr ""
"اولویت منطقه‌های ترجیحی خود را هنگامی که تطابق با منطقه اول و دوم وجود ندارد "
"انتخاب کنید"

msgid "ARCADE SYSTEMS"
msgstr "سیستم‌های آرکید"

msgid "ENABLE AGGREGATED ARCADE SYSTEM"
msgstr "فعال کردن سیستم آرکید یکپارچه"

msgid "Available only when aggregated arcade system is on"
msgstr "فقط زمانی که سیستم آرکید یکپارچه روشن است در دسترس است"

msgid ""
"Select manufacturer virtual system to show in the system view (like "
"CPS1/2/3, SEGA, TAITO, ...)"
msgstr ""
"سیستم مجازی سازنده برای نمایش در نمای سیستم را انتخاب کنید (مانند CPS1/2/3، "
"SEGA، TAITO، ...)"

msgid "ARCADE GAMES"
msgstr "بازی‌های آرکید"

msgid ""
"Always use arcade names from official databases. Overwrites manual edits and "
"scraper results."
msgstr ""
"همیشه از نام‌های آرکید پایگاه‌های داده رسمی استفاده کنید. ویرایش دستی و نتایج "
"اسکرپر را بازنویسی می‌کند."

msgid "USER INTERFACE SETTINGS"
msgstr "تنظیمات رابط کاربری"

msgid "SYSTEMS TO SHOW IN DEMO/GAMECLIP"
msgstr "سیستم‌هایی که در دمو/کلیپ بازی نمایش داده می‌شوند"

msgid "Adjust the screen brightness"
msgstr "تنظیم روشنایی صفحه"

msgid "Change the look of your Recalbox!"
msgstr "ظاهر Recalbox خود را تغییر دهید!"

msgid "DEFAULT TRANSITION STYLE"
msgstr "سبک انتقال پیش‌فرض"

msgid ""
"Select the type of transition between system. INSTANT will do nothing, FADE "
"will fade to dark, and SLIDE will slide the entire screen"
msgstr ""
"نوع انتقال بین سیستم‌ها را انتخاب کنید. INSTANT کاری نمی‌کند، FADE به تاریکی "
"محو می‌شود، و SLIDE کل صفحه را می‌لغزاند"

msgid "Select {THEME.OPTION.NAME}"
msgstr "انتخاب {THEME.OPTION.NAME}"

msgid "GAME LAUNCH TRANSITION STYLE"
msgstr "سبک انتقال راه‌اندازی بازی"

msgid ""
"Select the type of transition when you launch a game. INSTANT will do "
"nothing, FADE will fade to dark, and SLIDE will zoom in on the game cover."
msgstr ""
"نوع انتقال هنگام راه‌اندازی بازی را انتخاب کنید. INSTANT کاری نمی‌کند، FADE به "
"تاریکی محو می‌شود، و SLIDE روی جلد بازی زوم می‌کند."

msgid "ENABLE FAST MOVE IN GAMELIST"
msgstr "فعال کردن حرکت سریع در فهرست بازی"

msgid ""
"When enabled, holding up or down for a few seconds makes the list scroll "
"very fast."
msgstr ""
"وقتی فعال است، نگه داشتن بالا/پایین چند ثانیه باعث می‌شود فهرست خیلی سریع "
"اسکرول شود"

msgid "Display the current time in a corner of the screen."
msgstr "ساعت فعلی را در گوشه‌ای از صفحه نمایش دهید."

msgid "SHOW MUSIC POPUPS"
msgstr "نمایش پاپ‌آپ‌های موسیقی"

msgid "When enabled, show music information every time a new music starts."
msgstr ""
"وقتی فعال است، هر بار که موسیقی جدیدی شروع می‌شود اطلاعات موسیقی نمایش می‌دهد."

msgid "SHOW NETPLAY POPUPS"
msgstr "نمایش پاپ‌آپ‌های Netplay"

msgid ""
"When enabled, show netplay information every time a user starts a new game "
"over internet."
msgstr ""
"وقتی فعال است، هر بار که کاربری بازی جدیدی را از طریق اینترنت شروع می‌کند "
"اطلاعات netplay نمایش می‌دهد."

msgid "CONTROLLER SETTINGS"
msgstr "تنظیمات کنترلر"

msgid "Add and configure all your controllers."
msgstr "همه کنترلرهای خود را اضافه و پیکربندی کنید."

msgid "WIFI"
msgstr "WiFi"

msgid "CONNECT AUTOMATICALLY"
msgstr "اتصال خودکار"

msgid ""
"Automatically connect on startup if the WIFI network is available and "
"properly configured!"
msgstr ""
"در صورت در دسترس بودن و پیکربندی صحیح شبکه WiFi، در هنگام راه‌اندازی به‌طور "
"خودکار متصل شوید!"

msgid "WIFI is disabled!"
msgstr "WiFi غیرفعال است!"

msgid "SELECT SSID"
msgstr "انتخاب SSID"

msgid "Select an available SSID."
msgstr "یک SSID در دسترس انتخاب کنید."

msgid "If your Internet box has a WPS system, activate it and then click here!"
msgstr ""
"اگر مودم اینترنت شما سیستم WPS دارد، آن را فعال کنید و سپس اینجا کلیک کنید!"

msgid ""
"Run the scraper! The operation may take a while, however you can make it a "
"background task and keep using Recalbox."
msgstr ""
"اسکرپر را اجرا کنید! این عملیات ممکن است کمی طول بکشد، اما می‌توانید آن را به "
"عنوان وظیفه پس‌زمینه اجرا کنید و به استفاده از Recalbox ادامه دهید."

msgid "PATRON OPTIONS"
msgstr "گزینه‌های حامی"

msgid "user name for the selected scraper"
msgstr "نام کاربری برای اسکرپر انتخاب شده"

msgid "password for the selected scraper"
msgstr "رمز عبور برای اسکرپر انتخاب شده"

msgid "Download various free games and free contents!"
msgstr "بازی‌های رایگان و محتوای رایگان مختلف دانلود کنید!"

msgid "Download games for {SYSTEM.NAME}"
msgstr "دانلود بازی‌ها برای {SYSTEM.NAME}"

msgid ""
"Download a pack of free games, game demos and homebrew for {SYSTEM.NAME}"
msgstr ""
"یک بسته بازی‌های رایگان، دموهای بازی و homebrew برای {SYSTEM.NAME} دانلود کنید"

msgid "No content available yet for {SYSTEM.NAME}!"
msgstr "هنوز محتوایی برای {SYSTEM.NAME} در دسترس نیست!"

msgid "ACTIVATE DEBUG/VERBOSE LOGS"
msgstr "فعال کردن گزارش‌های اشکال‌زدایی/توضیحی"

msgid "Activate debug and verbose logs in Recalbox and Emulators."
msgstr "گزارش‌های اشکال‌زدایی و توضیحی را در Recalbox و شبیه‌سازها فعال کنید."

msgid "You cannot set up Kodi on boot when Kodi is disabled."
msgstr "وقتی Kodi غیرفعال است نمی‌توانید Kodi را برای بوت تنظیم کنید."

msgid "DO NOT SCAN NEW GAMES"
msgstr "بازی‌های جدید را اسکن نکنید"

msgid ""
"Formerly called 'GAMELIST ONLY', it can greatly speed up boot time by not "
"scanning new files. Use it if your romsets are rarely updated."
msgstr ""
"قبلاً 'فقط فهرست بازی' نامیده می‌شد، با عدم اسکن فایل‌های جدید می‌تواند زمان بوت "
"را به شدت کاهش دهد. اگر مجموعه ROM های شما به ندرت به‌روز می‌شوند از آن "
"استفاده کنید."

msgid "ALLOW BOOT ON GAME"
msgstr "اجازه بوت روی بازی"

msgid ""
"When activated, Recalbox boots into the gamelist and does not allow moving "
"back to the system list."
msgstr ""
"وقتی فعال است، Recalbox روی فهرست بازی بوت می‌شود و اجازه بازگشت به فهرست "
"سیستم‌ها را نمی‌دهد."

msgid "SYSTEM SPECIFIC RESOLUTIONS"
msgstr "وضوح تصویر مخصوص سیستم"

msgid "FOR {SYSTEM.NAME}"
msgstr "برای {SYSTEM.NAME}"

msgid "Select the resolution used by the emulator '{SYSTEM.NAME}'."
msgstr "وضوح تصویر مورد استفاده توسط شبیه‌ساز '{SYSTEM.NAME}' را انتخاب کنید."

msgid "Set options for system {SYSTEM.NAME}"
msgstr "گزینه‌های سیستم {SYSTEM.NAME} را تنظیم کنید"

msgid "Set the way you want to use Kodi mediaplayer."
msgstr "نحوه استفاده از پخش‌کننده رسانه Kodi را تنظیم کنید."

msgid "RUN KODI ON STARTUP"
msgstr "اجرای Kodi در هنگام راه‌اندازی"

msgid "START KODI WITH X BUTTON"
msgstr "راه‌اندازی Kodi با دکمه X"

msgid "Run your own scripts in shell or python"
msgstr "اسکریپت‌های خود را در shell یا python اجرا کنید"

msgid "Run custom script {SCRIPT.NAME}"
msgstr "اجرای اسکریپت سفارشی {SCRIPT.NAME}"

msgid "ENABLE WEB MANAGER"
msgstr "فعال کردن مدیریت وب"

msgid "RESET EMULATOR SETTINGS"
msgstr "بازنشانی تنظیمات شبیه‌ساز"

msgid "RESET!"
msgstr "بازنشانی!"

msgid ""
"This option resets all emulator settings to their factory defaults. It does "
"not affect any Recalbox setting."
msgstr ""
"این گزینه همه تنظیمات شبیه‌ساز را به پیش‌فرض کارخانه بازنشانی می‌کند. تنظیمات "
"Recalbox را تغییر نمی‌دهد."

msgid "HARDWARE"
msgstr "سخت‌افزار"

msgid "UPDATE!"
msgstr "به‌روزرسانی!"

msgid "Update Pi4 / Pi400 or Pi5 bootloader if required."
msgstr "در صورت نیاز bootloader Pi4 / Pi400 یا Pi5 را به‌روز کنید."

msgid "Recalbox does not support overclocking for your board."
msgstr "Recalbox از اورکلاک برای برد شما پشتیبانی نمی‌کند."

msgid "CONTEXTUAL OPTIONS"
msgstr "گزینه‌های زمینه‌ای"

msgid "EDIT GAME {GAME.NAME}"
msgstr "ویرایش بازی {GAME.NAME}"

msgid "Show options related to {GAME.NAME} and allow editing game metadata."
msgstr ""
"گزینه‌های مرتبط با {GAME.NAME} را نمایش دهید و اجازه ویرایش فراداده بازی را "
"می‌دهد."

msgid ""
"You cannot edit this game because it is a pre-installed game or it is stored "
"on a read-only device"
msgstr ""
"نمی‌توانید این بازی را ویرایش کنید چون یا یک بازی از پیش نصب شده است یا روی "
"دستگاه فقط‌خواندنی ذخیره شده است"

msgid "Select the emulator to use to run {GAME.NAME}"
msgstr "شبیه‌ساز برای اجرای {GAME.NAME} را انتخاب کنید"

msgid "SET PATCH"
msgstr "تنظیم پچ"

msgid "Select patch to use when running an emulator supporting softpatching."
msgstr ""
"پچ مورد استفاده هنگام اجرای شبیه‌ساز پشتیبانی‌کننده از softpatching را انتخاب "
"کنید."

msgid ""
"Either the game has no patch or the emulator selected to run this game is "
"not supporting softpatching."
msgstr ""
"یا بازی پچی ندارد یا شبیه‌ساز انتخاب شده برای اجرای این بازی از softpatching "
"پشتیبانی نمی‌کند."

msgid "Sets the name of the game or folder."
msgstr "نام بازی یا پوشه را تنظیم می‌کند."

msgid "Set this game as favorite or not."
msgstr "این بازی را به عنوان مورد علاقه تنظیم کنید یا نه."

msgid "Editing favorites is not enabled."
msgstr "ویرایش مورد علاقه‌ها فعال نیست."

msgid "Hide or show this game."
msgstr "این بازی را پنهان یا نمایش دهید."

msgid "Defines this game as an adult game or not."
msgstr "این بازی را به عنوان بازی بزرگسالان تعریف کنید یا نه."

msgid "Scraping"
msgstr "اسکرپینگ"

msgid "Scrape this game and fill in all metadata at once!"
msgstr "این بازی را اسکرپ کنید و تمام فراداده را یکجا پر کنید!"

msgid "Statistics"
msgstr "آمار"

msgid "Show the total time you played this game"
msgstr "مجموع زمانی که این بازی را بازی کرده‌اید نمایش می‌دهد"

msgid "PLAY COUNT"
msgstr "تعداد بازی"

msgid "Show the number of times you played this game"
msgstr "تعداد دفعاتی که این بازی را بازی کرده‌اید نمایش می‌دهد"

msgid "Show the last date/time you played this game"
msgstr "آخرین تاریخ/ساعتی که این بازی را بازی کرده‌اید نمایش می‌دهد"

msgid "DELETE GAME {GAME.NAME}"
msgstr "حذف بازی {GAME.NAME}"

msgid "DELETE {ICON.WARNING}"
msgstr "حذف {ICON.WARNING}"

msgid ""
"Delete game or screenshot physically on the storage. Allow keeping save, "
"metadata and other related files individually."
msgstr ""
"بازی یا اسکرین‌شات را به صورت فیزیکی از فضای ذخیره‌سازی حذف کنید. اجازه "
"نگهداری جداگانه ذخیره، فراداده و سایر فایل‌های مرتبط را می‌دهد."

msgid ""
"You cannot delete this game because it is a pre-installed game or it is "
"stored on a read-only device or it is a folder."
msgstr ""
"نمی‌توانید این بازی را حذف کنید چون یا یک بازی از پیش نصب شده است، روی دستگاه "
"فقط‌خواندنی ذخیره شده یا یک پوشه است."

msgid ""
"Boot on game is not enabled. To set a game to boot on, enable the "
"appropriate option first."
msgstr ""
"بوت روی بازی فعال نیست. برای تنظیم بوت روی بازی، ابتدا گزینه مناسب را فعال "
"کنید."

msgid "RUN SAVE STATE"
msgstr "اجرا از ذخیره"

msgid "Select, restore and run game in the selected save state."
msgstr "ذخیره انتخاب شده را بازیابی کنید و بازی را از آن اجرا کنید."

msgid ""
"No save state has been detected for the currently selected game, or the "
"currently selected item is not a game."
msgstr ""
"هیچ ذخیره‌ای برای بازی انتخاب شده پیدا نشد، یا آیتم انتخاب شده بازی نیست."

msgid "JUMP"
msgstr "پرش"

msgid "Open the Quick Jump selector."
msgstr "انتخابگر پرش سریع را باز می‌کند."

msgid "This option allows you to search for other versions of a game."
msgstr "این گزینه اجازه جستجو برای نسخه‌های دیگر یک بازی را می‌دهد."

msgid "This option allows you to search for other games with the same licence."
msgstr "این گزینه اجازه جستجو برای سایر بازی‌های با همان مجوز را می‌دهد."

msgid ""
"Select the way the game list is sorted (alphabetically, by rating, ...)."
msgstr "نحوه مرتب‌سازی فهرست بازی را انتخاب کنید (الفبایی، بر اساس امتیاز...)."

msgid "This list has a natural order and can't be sorted."
msgstr "این فهرست ترتیب طبیعی دارد و نمی‌توان آن را مرتب کرد."

msgid ""
"Select what kind of information you want to see on the right of your "
"gamelist: regions flags, players or game genre."
msgstr ""
"نوع اطلاعاتی که می‌خواهید در سمت راست فهرست بازی ببینید را انتخاب کنید: "
"پرچم‌های منطقه، بازیکنان یا ژانر بازی."

msgid "FLATTEN FOLDERS"
msgstr "یکپارچه‌سازی پوشه‌ها"

msgid "This system is either always flattened or cannot be flattened!"
msgstr "این سیستم یا همیشه یکپارچه است یا نمی‌توان آن را یکپارچه کرد!"

msgid "You can't hide favorites in the Favorite system!"
msgstr "نمی‌توانید مورد علاقه‌ها را در سیستم مورد علاقه پنهان کنید!"

msgid "Display favorites at the top of gamelists."
msgstr "مورد علاقه‌ها را در بالای فهرست بازی‌ها نمایش دهید."

msgid "Favorites are always first in the Favorite system!"
msgstr "مورد علاقه‌ها همیشه اول در سیستم مورد علاقه هستند!"

msgid "Virtual systems cannot be updated. Update real systems instead."
msgstr ""
"سیستم‌های مجازی قابل به‌روزرسانی نیستند. به جای آن سیستم‌های واقعی را به‌روز "
"کنید."

msgid "Advanced system settings"
msgstr "تنظیمات پیشرفته سیستم"

msgid "Set advanced settings for system {SYSTEM.NAME}"
msgstr "تنظیمات پیشرفته سیستم {SYSTEM.NAME} را تنظیم کنید"

msgid "DELETE {GAME.NAME}"
msgstr "حذف {GAME.NAME}"

msgid "GAME FILES (ROM, DISK IMAGE, TAPE, ...)"
msgstr "فایل‌های بازی (ROM، تصویر دیسک، نوار، ...)"

msgid "Number of game files that are to be deleted."
msgstr "تعداد فایل‌های بازی که باید حذف شوند."

msgid ""
"Number of media files (images, video, ...) that will be deleted along with "
"game files."
msgstr ""
"تعداد فایل‌های رسانه (تصاویر، ویدیو، ...) که همراه با فایل‌های بازی حذف می‌شوند."

msgid "There is no media file associated with this game"
msgstr "هیچ فایل رسانه‌ای با این بازی مرتبط نیست"

msgid ""
"Number of extra files associated with this game: configurations, overrides, "
"patches, ..."
msgstr ""
"تعداد فایل‌های اضافی مرتبط با این بازی: پیکربندی‌ها، بازنشانی‌ها، پچ‌ها، ..."

msgid "There is no extra file associated with this game"
msgstr "هیچ فایل اضافی با این بازی مرتبط نیست"

msgid "Number of save games and save states of {GAME.NAME}"
msgstr "تعداد بازی‌های ذخیره شده و وضعیت‌های ذخیره {GAME.NAME}"

msgid "There is no save game or save state for this game"
msgstr "هیچ بازی ذخیره شده یا وضعیت ذخیره‌ای برای این بازی وجود ندارد"

msgid "Select files to delete one by one."
msgstr "فایل‌ها را یک به یک برای حذف انتخاب کنید."

msgid "Select game files that are to be deleted one by one."
msgstr "فایل‌های بازی که باید حذف شوند را یک به یک انتخاب کنید."

msgid ""
"Select media files (images, video, ...) that will be deleted along with game "
"files."
msgstr ""
"فایل‌های رسانه (تصاویر، ویدیو، ...) که همراه با فایل‌های بازی حذف می‌شوند را "
"انتخاب کنید."

msgid "Select extra files to delete: configurations, overrides, patches, ..."
msgstr ""
"فایل‌های اضافی برای حذف را انتخاب کنید: پیکربندی‌ها، بازنشانی‌ها، پچ‌ها، ..."

msgid "Select save games and save states of {GAME.NAME} to delete"
msgstr "بازی‌های ذخیره شده و وضعیت‌های ذخیره {GAME.NAME} را برای حذف انتخاب کنید"

msgid "Delete all files selected below"
msgstr "همه فایل‌های انتخاب شده زیر را حذف کنید"

msgid "Cancel operation. Do not delete anything"
msgstr "لغو عملیات. هیچ چیز حذف نشود"

msgid "Delete all files listed below"
msgstr "همه فایل‌های فهرست شده زیر را حذف کنید"

msgid "SOFTPATCHING {GAME.NAME}"
msgstr "Softpatching برای {GAME.NAME}"

msgid "ORIGINAL GAME"
msgstr "بازی اصلی"

msgid "PATCHED GAME"
msgstr "بازی پچ شده"

msgid "SELECT PATCH TO APPLY"
msgstr "انتخاب پچ برای اعمال"

msgid "Select the patch to apply."
msgstr "وصله مورد نظر برای اعمال را انتخاب کنید."

msgid "INITIATE {GAME.NAME} NETPLAY GAME"
msgstr "آغاز بازی Netplay {GAME.NAME}"

msgid "Launch the game and wait for other player to join"
msgstr "بازی را راه‌اندازی کنید و منتظر پیوستن بازیکن دیگر باشید"

