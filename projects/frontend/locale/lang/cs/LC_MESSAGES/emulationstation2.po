msgid "Mounting partitions..."
msgstr "Připojují se partition..."

msgid "Measuring data to copy..."
msgstr "Zjišťuje se objem dat ke kopírování..."

msgid "{COUNT} files copied ({DONE}/{TOTAL})"
msgstr "Zkopírováno souborů: {COUNT} ({DONE}/{TOTAL})"

