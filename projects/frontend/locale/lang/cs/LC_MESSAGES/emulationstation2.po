msgstr "POVOLIT/ZAKÁZAT"

msgid "Downloading"
msgstr "Stahování"

msgid "SEEK"
msgstr "POSUN"

msgid "FOLLOW"
msgstr "SLEDOVAT"

msgid "SWITCH TO LINEAR PLAY"
msgstr "PŘEPNOUT NA LINEÁRNÍ PŘEHRÁVÁNÍ"

