msgstr "НИКОГДА"

msgid "THEME'S COLORSET"
msgstr "ЦВЕТОВАЯ СХЕМА ТЕМЫ"

msgid "Select a colorset from this theme."
msgstr "Выберите цветовую схему из этой темы."

msgid "THEME'S ICONSET"
msgstr "НАБОР ЗНАЧКОВ ТЕМЫ"

msgid "Select an iconset from this theme."
msgstr "Выберите набор значков из этой темы."

msgid "THEME'S MENU STYLE"
msgstr "СТИЛЬ МЕНЮ ТЕМЫ"

msgid "Select menu style from this theme."
msgstr "Выберите стиль меню из этой темы."

msgid "THEME'S SYSTEMVIEW LAYOUT"
msgstr "РАСКЛАДКА ВИДА СИСТЕМ ТЕМЫ"

msgid "Select system view layout from this theme."
msgstr "Выберите раскладку вида систем из этой темы."

msgid "THEME'S GAMELISTVIEW LAYOUT"
msgstr "РАСКЛАДКА СПИСКА ИГР ТЕМЫ"

msgid "Select gamelist view layout from this theme."
msgstr "Выберите раскладку списка игр из этой темы."

msgid "THEME'S GAMECLIPVIEW LAYOUT"
msgstr "РАСКЛАДКА ВИДЕОКЛИПОВ ТЕМЫ"

msgid "Select gameclip view layout from this theme."
msgstr "Выберите раскладку видеоклипов из этой темы."

msgid "Libretro HatariB Settings"
msgstr "Настройки Libretro HatariB"

msgid "Machine Type"
msgstr "Тип машины"

msgid ""
"Choose the machine model to emulate. STE is a good choice for most games."
msgstr ""
"Выберите модель машины для эмуляции. STE — хороший выбор для большинства игр."

msgid "Memory Size"
msgstr "Объём памяти"

msgid "Select the amount of memory. 1 MB is enough for gaming."
msgstr "Выберите объём памяти. 1 МБ достаточно для игр."

msgid "Fast Floppy"
msgstr "Быстрая дискета"

msgid ""
"Set ON to accelerate the floppy disc emulation. May cause some games to fail!"
msgstr ""
"Установите в ВКЛ, чтобы ускорить эмуляцию дискет. Может привести к сбоям в "
"некоторых играх!"

msgid "Libretro Fuse Settings"
msgstr "Настройки Libretro Fuse"

msgid ""
"Choose the Sinclair machine (or clone) to emulate. The original Spectrum "
"128k is a good way to start."
msgstr ""
"Выберите машину Sinclair (или клон) для эмуляции. Оригинальный Spectrum 128k "
"— хороший способ начать."

msgid "Set ON to accelerate the tape emulation. May cause some games to fail!"
msgstr ""
"Установите в ВКЛ, чтобы ускорить эмуляцию кассеты. Может привести к сбоям в "
"некоторых играх!"

msgid "Libretro PX68K Settings"
msgstr "Настройки Libretro PX68K"

msgid "Model/CPU Speed"
msgstr "Модель/Скорость процессора"

msgid ""
"Choose the CPU frequency to emulate. 10Mhz is the basic machine and will "
"work for most of the games."
msgstr ""
"Выберите частоту процессора для эмуляции. 10Мгц — базовая машина, подходящая "
"для большинства игр."

msgid "Memory Size (in MB)"
msgstr "Объём памяти (в МБ)"

msgid ""
"Choose the amount of memory available. Most of the games will work with 2MB "
"but some games may require 4MB."
msgstr ""
"Выберите доступный объём памяти. Большинство игр будут работать с 2МБ, но "
"некоторым играм может потребоваться 4МБ."

msgid "Dolphin / Dolphin-GUI Settings"
msgstr "Настройки Dolphin / Dolphin-GUI"

msgid "Resolution"
msgstr "Разрешение"

msgid "Choose the internal resolution."
msgstr "Выберите внутреннее разрешение."

msgid "Dual CPU"
msgstr "Двойной процессор"

msgid ""
"May improve performance on a few rare games, at the expense of others that "
"are incompatible."
msgstr ""
"Включите эту опцию, если она может улучшить производительность некоторых "
"редких игр, но за счёт несовместимости с другими."

msgid "Sync GPU"
msgstr "Синхронизация GPU"

msgid "Enable this speed hack for dual core mode to fix some glitches."
msgstr ""
"Включите этот ускоряющий хак для режима двух ядер, чтобы исправить некоторые "
"глюки."

msgid "Anti-aliasing"
msgstr "Сглаживание"

msgid "Enable or disable anti-aliasing."
msgstr "Включите или отключите сглаживание."

msgid "VSync"
msgstr "Вертикальная синхронизация"

msgid "Enable or disable vsync."
msgstr ""
"Включите эту опцию, чтобы включить или отключить вертикальную синхронизацию."

msgid "Real Gamecube controllers"
msgstr "Настоящие контроллеры Gamecube"

msgid "Enable this option to play with real GameCube controllers."
msgstr "Включите эту опцию, чтобы играть с настоящими контроллерами GameCube."

msgid "Real Wiimotes"
msgstr "Настоящие Wiimote"

msgid "Enable this option to play with real Wiimotes."
msgstr "Включите эту опцию, чтобы играть с настоящими Wiimote."

msgid "Emulated Wiimote"
msgstr "Эмулируемый Wiimote"

msgid "Enable this option to play with emulated Wiimotes."
msgstr "Включите, чтобы играть с эмулируемыми Wiimote."

msgid "Dolphinbar position"
msgstr "Положение Dolphinbar"

msgid "Choose the position of the Dolphin bar."
msgstr "Выберите положение панели Dolphin."

msgid "Show on-screen information"
msgstr "Показывать информацию на экране"

msgid "PPSSPP Settings"
msgstr "Настройки PPSSPP"

msgid "Choose the internal resolution of the PSP."
msgstr "Выберите внутреннее разрешение PSP."

msgid "SCUMMVM Settings"
msgstr "Настройки SCUMMVM"

msgid "Subtitles"
msgstr "Субтитры"

msgid "Enable subtitles"
msgstr "Включить субтитры"

msgid "Supermodel Settings - Controllers"
msgstr "Настройки Supermodel - Контроллеры"

msgid "Sensitivity"
msgstr "Чувствительность"

msgid ""
"Choose the rate at which analog control values increase/decrease when "
"controlled by a key, between 1 to 100. Default is 25."
msgstr ""
"Выберите скорость, с которой значения аналогового управления увеличиваются/"
"уменьшаются при управлении клавишей, от 1 до 100. По умолчанию 25."

msgid "Saturation"
msgstr "Насыщенность"

msgid ""
"Choose the position at which the joystick is interpreted as being in its "
"most extreme position, between 0% to 200%. Default is 100%."
msgstr ""
"Выберите положение, при котором джойстик считается находящимся в крайнем "
"положении, от 0% до 200%. По умолчанию 100%."

msgid "Deadzone"
msgstr "Мёртвая зона"

msgid "Choose the dead zone as a percentage, between 0% to 99%. Default is 2%."
msgstr "Выберите мёртвую зону в процентах, от 0% до 99%. По умолчанию 2%."

msgid "Supermodel Settings - Audio"
msgstr "Настройки Supermodel - Аудио"

msgid "Sound volume"
msgstr "Громкость звука"

msgid ""
"Choose the master volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Выберите общую громкость в процентах, от 0% до 100%. По умолчанию 100%."

msgid "Music volume"
msgstr "Громкость музыки"

msgid ""
"Choose the music volume in percentage, between 0% to 100%. Default is 100%."
msgstr ""
"Выберите громкость музыки в процентах, от 0% до 100%. По умолчанию 100%."

msgid "Balance"
msgstr "Баланс"

msgid ""
"Choose the relative front/rear balance in percentage, between 0% to 100%. "
"Default is 0%."
msgstr ""
"Выберите относительный баланс перед/зад в процентах, от 0% до 100%. По "
"умолчанию 0%."

msgid "Channels"
msgstr "Каналы"

msgid "Choose the number of sound channels to use on host. Default is 2."
msgstr ""
"Выберите количество звуковых каналов для использования на хосте. По "
"умолчанию 2."

msgid "Flip stereo"
msgstr "Инвертировать стерео"

msgid "Swap the left and right audio channels."
msgstr "Выберите, если хотите поменять местами левый и правый звуковые каналы."

msgid "Sound"
msgstr "Звук"

msgid ""
"Choose if you disable sound board emulation sound effects. Default is "
"disabled."
msgstr ""
"Выберите, если хотите отключить звуковые эффекты эмуляции звуковой платы. По "
"умолчанию отключено."

msgid "No Digital Sound Board (DSB)"
msgstr "Без цифровой звуковой платы (DSB)"

msgid "Enable or disable Digital Sound Board MPEG music. Default is disabled."
msgstr ""
"Включите или отключите музыку MPEG цифровой звуковой платы. По умолчанию "
"отключено."

msgid "Sound engine"
msgstr "Звуковой движок"

msgid ""
"Choose between the legacy and new sound engines. Default is MAME engine."
msgstr ""
"Выберите между старым и новым звуковыми движками. По умолчанию движок MAME."

msgid "Supermodel Settings - Video"
msgstr "Настройки Supermodel - Видео"

msgid "Supersampling"
msgstr "Суперсэмплинг"

msgid "Supersampling. Not enabled yet. Default is 1."
msgstr "Суперсэмплинг. Пока не реализовано. По умолчанию 1."

msgid "Upscale"
msgstr "Масштабирование"

msgid "Choose the 2D layer upscaling filter mode. Default is 0."
msgstr "Выберите режим фильтра масштабирования 2D-слоя. По умолчанию 0."

msgid "Disable no throttle"
msgstr "Отключить без ограничения"

msgid "Enable or disable the 60Hz frame rate lock. Default is disabled."
msgstr ""
"Выберите, включить или отключить блокировку частоты кадров 60Гц. По "
"умолчанию отключено."

msgid "Lock the vertical refresh rate. Default is enabled."
msgstr ""
"Выберите блокировку вертикальной частоты обновления. По умолчанию включено."

msgid "True Hz"
msgstr "Истинная частота"

msgid "Use the true Model 3 refresh rate of 57.524 Hz. Default is disabled."
msgstr ""
"Выберите использование истинной частоты обновления Model 3, равной 57,524 "
"Гц. По умолчанию отключено."

msgid "Crosshairs"
msgstr "Прицел"

msgid "Show crosshairs. Default is disabled."
msgstr "Выберите отображение прицела. По умолчанию отключено."

msgid "Multi texture"
msgstr "Мультитекстурирование"

msgid "Use 8 texture maps for decoding. Default is disabled."
msgstr ""
"Выберите использование 8 текстурных карт для декодирования. По умолчанию "
"отключено."

msgid "Quad rendering"
msgstr "Квадратный рендеринг"

msgid "Enable proper quad rendering. Default is disabled."
msgstr ""
"Выберите включение корректного квадратного рендеринга. По умолчанию "
"отключено."

msgid "Supermodel Settings - Core"
msgstr "Настройки Supermodel - Ядро"

msgid "GPU multi threading"
msgstr "Многопоточность GPU"

msgid ""
"Set to ON to run GPU in its own thread instead of sharing the CPU thread. "
"Faster but may cause bugs, depending on the game."
msgstr ""
"Установите ON, чтобы GPU работал в собственном потоке вместо совместного "
"использования потока CPU. Быстрее, но может вызывать ошибки в зависимости от "
"игры."

msgid "PPC Frequency"
msgstr "Частота PPC"

msgid "Choose the PowerPC frequency in MHz, between 1 to 1000. Default is 70."
msgstr "Выберите частоту PowerPC в МГц, от 1 до 1000. По умолчанию 70."

msgid "Service button"
msgstr "Сервисная кнопка"

msgid ""
"Enable or disable the service menu in games (L3 = test, R3 = service). "
"Default is enabled."
msgstr ""
"Включите или отключите сервисное меню в играх (L3 = тест, R3 = сервис). По "
"умолчанию включено."

msgid "Log level"
msgstr "Уровень журнала"

msgid "Choose the level of detail in the log file. Default is Information."
msgstr "Выберите уровень информации в файле журнала. По умолчанию информация."

msgid "Xemu Settings"
msgstr "Настройки Xemu"

msgid "Choose the internal resolution of the Xbox."
msgstr "Выберите внутреннее разрешение Xbox."

msgid "Show menu bar"
msgstr "Показывать строку меню"

msgid "Show the menu bar."
msgstr "Выберите, хотите ли вы показывать строку меню."

msgid "Skip boot animation"
msgstr "Пропустить анимацию загрузки"

msgid "Skip the boot animation."
msgstr "Выберите, хотите ли вы пропустить анимацию загрузки."

msgid "Show notifications"
msgstr "Показывать уведомления"

msgid "Show the notifications displayed in the top-right corner of the screen."
msgstr "Показывать уведомления в правом верхнем углу экрана."

msgid "Display mode"
msgstr "Режим отображения"

msgid "Choose how the framebuffer should fit or scale."
msgstr "Выберите, как должен вписываться или масштабироваться кадровый буфер."

msgid "Aspect Ratio"
msgstr "Соотношение сторон"

msgid "Choose the aspect ratio of the Xbox."
msgstr "Выберите соотношение сторон Xbox."

msgid "Xemu - EEPROM General Settings"
msgstr "Xemu - Общие настройки EEPROM"

