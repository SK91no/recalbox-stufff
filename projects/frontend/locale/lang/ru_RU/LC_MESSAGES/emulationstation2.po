"Please check your SSID and Password."
msgstr ""
"ОШИБКА СОЕДИНЕНИЯ!\n"
"Пожалуйста, проверьте ваш SSID и пароль."

msgid "FAVORITES FIRST"
msgstr "ИЗБРАННОЕ ПЕРВЫМ"

msgid "SUPERREZ MULTIPLIER"
msgstr "МНОЖИТЕЛЬ SUPERREZ"

msgid "CALIBRATE"
msgstr "КАЛИБРОВАТЬ"

