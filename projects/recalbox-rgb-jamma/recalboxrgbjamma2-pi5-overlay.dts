/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>


/ {
	compatible = "brcm,bcm2712";
	fragment@0 {
		target = <&rp1_gpio>;

		__overlay__ {
			irq_gpio_26: irq_gpio_26_conf {
				function = "gpio";
				pins = "gpio26";
				bias-pull-up;
			};
		};
	};

	fragment@1 {
		target-path = "/";
		__overlay__ {
			bridge: recalboxrgbjamma {
				compatible = "raspberrypi,recalboxrgbdual";
				#address-cells = <1>;
				#size-cells = <0>;

				vc4-vga666-mode = <6>;
				recalbox-rgb-jamma-2 = <1>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						vga_bridge_in: endpoint {
							remote-endpoint = <&dpi_out>;
						};
					};

					port@1 {
						reg = <1>;

						vga_bridge_out: endpoint {
							remote-endpoint = <&vga_con_in>;
						};
					};
				};
			};

			vga {
				compatible = "vga-connector";

				port {
					vga_con_in: endpoint {
						remote-endpoint = <&vga_bridge_out>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&dpi>;
		__overlay__  {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&vga666_mode6_pins>;
			port {
				dpi_out: endpoint@0 {
					remote-endpoint = <&vga_bridge_in>;
				};
			};
		};
	};

	fragment@4 {
		target = <&gpio>;
		__overlay__ {
			vga666_mode6_pins: vga666_mode6_pins {
				function = "dpi";
				pins = "gpio1", "gpio2", "gpio3",
					   "gpio4", "gpio5", "gpio6", "gpio7",
					   "gpio8", "gpio9",
					   "gpio12", "gpio13", "gpio14", "gpio15",
					   "gpio16", "gpio17",
					   "gpio20", "gpio21", "gpio22", "gpio23",
					   "gpio24", "gpio25";
				bias-disable;
			};
		};
	};

    fragment@50 {
        target = <&rp1_gpio>;
        __overlay__ {
            rp1_i2s0_jamma: rp1_i2s0_jamma {
                function = "i2s0";
                pins = "gpio18", "gpio19", "gpio27";
                bias-disable;
            };
        };
    };
    fragment@51 {
        target = <&i2s_clk_producer>;
        __overlay__ {
            #sound-dai-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&rp1_i2s0_jamma>;
            status = "okay";
        };
    };


	fragment@52 {
		target = <&sound>;
		__overlay__ {
			compatible = "simple-audio-card";
			simple-audio-card,name = "Recalbox RGB JAMMA 2";
			status = "okay";
			simple-audio-card,dai-link@1 {
				format = "i2s";
				cpu {
					sound-dai = <&i2s_clk_producer>;
					dai-tdm-slot-num = <2>;
					dai-tdm-slot-width = <32>;
				};
				codec {
					sound-dai = <&codec_out>;
				};
			};
		};
	};

	fragment@53 {
		target-path = "/";
		__overlay__ {
			codec_out: recalbox_i2s {
				#sound-dai-cells = <0>;
				compatible = "recalbox_i2s";
				status = "okay";
			};
		};
	};

  fragment@8 {
    target = <&i2c1>;
    fragi2c: __overlay__ {
      status = "okay";
      pinctrl-names = "default";
      pinctrl-0 = <&rp1_i2c1_10_11>;
      clock-frequency = <400000>;
      read-timeout-ms = <50>;

      jammactrl_0: jammactrl_0@25 {
        compatible = "raspberrypi,recalboxrgbjamma";
        reg = <0x25>;
        status = "okay";
        pinctrl-names = "default";
      };
      jammactrl_1: jammactrl_1@24 {
        compatible = "raspberrypi,recalboxrgbjamma";
        reg = <0x24>;
        status = "okay";
      };
      jammactrl_2: jammactrl_2@27 {
        compatible = "raspberrypi,recalboxrgbjamma";
        reg = <0x27>;
        status = "okay";
      };
      jammaexpander: jammaexpander@26 {
        compatible = "raspberrypi,recalboxrgbjamma";
		is_pi5 = <1>;
		// Proto 1 = 1, rev A = 2
	    rev = <2>;
        reg = <0x26>;
        status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&irq_gpio_26>;
		interrupt-parent = <&gpio>;
		interrupts = <26 2>;
		irq-gpios = <&gpio 26 0>;
      };
      ssd1306: ssd1306@3c {
        compatible = "recalbox,recalboxrgbjamma2-screen";
        reg = <0x3c>;
      };
    };
  };
  __overrides__ {
	  baudrate = <&fragi2c>, "clock-frequency:0";
	  rev = <&jammaexpander>, "rev:0";
  };
};
