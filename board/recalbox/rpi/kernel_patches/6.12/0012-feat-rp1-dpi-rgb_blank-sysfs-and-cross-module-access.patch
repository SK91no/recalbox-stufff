From: digitalLumberjack <digitallumberjack@recalbox.com>
Date: Tue, 09 Jun 2026 11:12:51 +0200
Subject: [PATCH] feat: rp1-dpi rgb_blank sysfs + cross-module accessor

Add a way to force RGB pads to 0 (via OMASK) while sync stays alive.
Exposed via:
  - sysfs /sys/.../<dpi>/rgb_blank (echo 1/0)
  - exported rp1dpi_blank_global(bool) for other in-tree modules

Used by Recalbox JVS to mask the chassis AFC re-acquit glitch during
firmware ↔ Pi5 video mux transitions, without disturbing the sync
(no chassis 15/31 kHz relay click).

Signed-off-by: digitalLumberjack <digitallumberjack@recalbox.com>
---
--- a/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi.h
+++ b/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi.h
@@ -66,6 +66,10 @@
 	u32 shorter_front_porch;
 	bool interlaced;
 	bool lower_field_flag;
+
+	/* RGB output blanking via OMASK (sync stays active) — for chassis mux transitions */
+	bool rgb_blanked;
+	u32 saved_omask;
 };
 
 /* ---------------------------------------------------------------------- */
@@ -81,6 +85,7 @@
 int rp1dpi_hw_busy(struct rp1_dpi *dpi);
 irqreturn_t rp1dpi_hw_isr(int irq, void *dev);
 void rp1dpi_hw_vblank_ctrl(struct rp1_dpi *dpi, int enable);
+void rp1dpi_hw_set_rgb_blank(struct rp1_dpi *dpi, bool blank);
 
 /* ---------------------------------------------------------------------- */
 /* Functions to control the VIDEO OUT CFG block and check RP1 platform	  */
--- a/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi.c
+++ b/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi.c
@@ -287,6 +287,47 @@
 	DRM_FORMAT_RGB565
 };
 
+/* Global accessor for cross-module calls (e.g. recalboxjvs HID module). */
+static struct rp1_dpi *rp1dpi_global;
+
+int rp1dpi_blank_global(bool blank)
+{
+	if (!rp1dpi_global)
+		return -ENODEV;
+	rp1dpi_hw_set_rgb_blank(rp1dpi_global, blank);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(rp1dpi_blank_global);
+
+/* sysfs: echo 1 > rgb_blank → RGB pins forced to 0 (sync stays active).
+ * echo 0 → restore normal RGB output. */
+static ssize_t rgb_blank_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct drm_device *drm = dev_get_drvdata(dev);
+	struct rp1_dpi *dpi = container_of(drm, struct rp1_dpi, drm);
+
+	return sysfs_emit(buf, "%u\n", dpi->rgb_blanked ? 1 : 0);
+}
+
+static ssize_t rgb_blank_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct drm_device *drm = dev_get_drvdata(dev);
+	struct rp1_dpi *dpi = container_of(drm, struct rp1_dpi, drm);
+	bool blank;
+	int ret;
+
+	ret = kstrtobool(buf, &blank);
+	if (ret)
+		return ret;
+	rp1dpi_hw_set_rgb_blank(dpi, blank);
+	return count;
+}
+
+static DEVICE_ATTR_RW(rgb_blank);
+
 static int rp1dpi_platform_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -427,7 +468,11 @@
 		return ret;
 
 	drm_fbdev_ttm_setup(&dpi->drm, 32);
-	return ret;
+
+	if (device_create_file(dev, &dev_attr_rgb_blank))
+		dev_warn(dev, "Failed to create rgb_blank sysfs\n");
+	rp1dpi_global = dpi;
+	return 0;
 
 done_err:
 	dev_err(dev, "%s fail %d\n", __func__, ret);
@@ -438,6 +483,8 @@
 {
 	struct drm_device *drm = platform_get_drvdata(pdev);
 
+	rp1dpi_global = NULL;
+	device_remove_file(&pdev->dev, &dev_attr_rgb_blank);
 	rp1dpi_stopall(drm);
 	drm_dev_unregister(drm);
 	drm_atomic_helper_shutdown(drm);
--- a/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi_hw.c
+++ b/drivers/gpu/drm/rp1/rp1-dpi/rp1_dpi_hw.c
@@ -618,6 +618,23 @@
 			BITS(DPI_DMA_IRQ_EN_MATCH_LINE, 32));
 }
 
+void rp1dpi_hw_set_rgb_blank(struct rp1_dpi *dpi, bool blank)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dpi->hw_lock, flags);
+	if (blank && !dpi->rgb_blanked) {
+		dpi->saved_omask = rp1dpi_hw_read(dpi, DPI_DMA_OMASK);
+		rp1dpi_hw_write(dpi, DPI_DMA_OMASK, 0);
+		dpi->rgb_blanked = true;
+	} else if (!blank && dpi->rgb_blanked) {
+		rp1dpi_hw_write(dpi, DPI_DMA_OMASK, dpi->saved_omask);
+		dpi->rgb_blanked = false;
+	}
+	spin_unlock_irqrestore(&dpi->hw_lock, flags);
+}
+EXPORT_SYMBOL_GPL(rp1dpi_hw_set_rgb_blank);
+
 irqreturn_t rp1dpi_hw_isr(int irq, void *dev)
 {
 	struct rp1_dpi *dpi = dev;
