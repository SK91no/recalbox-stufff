      source "$BR2_EXTERNAL_RECALBOX_PATH/package/xa65/Config.in.host"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/xxd/Config.in.host"
    endmenu
  endmenu
  menu "Software"
    menu "Libraries"
      comment "Third party libraries"
