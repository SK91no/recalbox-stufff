menu "Recalbox"
  menu "Audio"
    comment "Audio specific options"
    menu "Audio features"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/audio/alsa-ucm-conf/Config.in"
    endmenu
  endmenu
  menu "Firmware"
    comment "Installable linux firmwares"
    menu "Audio firmwares"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/firmware/sound-open-firmware/Config.in"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/firmware/valve-hardware-audio-processing/Config.in"
    endmenu
    menu "Steam Deck firmwares"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/firmware/kernelfirmwares-steamdeck/Config.in"
    endmenu
  endmenu
  menu "Hardware"
    comment "Board specific options"
    menu "Rockchip"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/rockchip-mpp/Config.in"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/librga/Config.in"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/rkwifibt/Config.in"
    endmenu
    menu "Hardkernel"
			menu "odroidgo2"
        source "$BR2_EXTERNAL_RECALBOX_PATH/package/libgo2/Config.in"
      endmenu
    endmenu
    comment "Cases support"
    menu "Cases"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/hardware/argon40case/Config.in"
    endmenu
  endmenu
  menu "GPU"
    comment "GPU specific options"
    menu "Rockchip"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/recalbox-rockchip-mali/Config.in"
    endmenu
    comment "libmali provided by Librelec"
    menu "Librelec"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/librelec-libmali/Config.in"
    endmenu
  endmenu
  menu "Boot"
    comment "Boot specific options"
    menu "u-boot"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/uboot-xu4/Config.in"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/uboot-odroidgo2/Config.in"
    endmenu
  endmenu
  menu "Video"
    comment "Video specific options"
    menu "Wayland"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/dwl/Config.in"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/wlr-randr/Config.in"
    endmenu
  endmenu
  menu "Emulation"
    comment "Emulation specific options"
