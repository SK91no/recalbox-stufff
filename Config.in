      source "$BR2_EXTERNAL_RECALBOX_PATH/package/qt6wayland/Config.in"
    endmenu
    menu "Utilities"
      comment "Utilities"
      source "$BR2_EXTERNAL_RECALBOX_PATH/package/utilities/recalbox-fbv/Config.in"
    endmenu
  endmenu
